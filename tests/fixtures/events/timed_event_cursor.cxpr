# Generic, statically bounded ordered events using a record of field arrays.
model timed_event_cursor(type = "event_fixture", lifecycle = "scoped")

in position

state previous_cursor = -1

events = {
    at = [0.0, 0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5],
    value = [37, 56, 61, 64, 49, 56, 61, 64],
    weight = [0.92, 0.68, 0.58, 0.64, 0.76, 0.68, 0.58, 0.64],
    channel = [0, 1, 1, 1, 0, 1, 1, 1]
}

cursor = upper_bound(events.at, position) - 1
enabled = cursor >= 0 and cursor < length(events)
current = events[clamp(cursor, 0, length(events) - 1)]
trigger = enabled and cursor != previous_cursor ? 1 : 0
age = enabled ? max(0, position - current.at) : 0

previous_cursor := enabled ? cursor : previous_cursor

out {
    cursor,
    event_position = current.at,
    value = current.value,
    weight = current.weight,
    channel = current.channel,
    enabled,
    trigger,
    age
}
