model root(type = "fixture")

use voice

in position

streams = {
    low = { at = [0, 1, 3], value = [10, 11, 12] },
    high = { at = [0.5, 2, 4], value = [20, 21, 22] }
}

voices = map(streams, stream => {
    cursor = upper_bound(stream.at, position) - 1;
    index = clamp(cursor, 0, length(stream.value) - 1);
    return voice(cursor=cursor, item=stream.value[index]);
})

out {
    low_trigger = voices.low.trigger,
    low_value = voices.low.value,
    high_trigger = voices.high.trigger,
    high_value = voices.high.value
}
