// Requires R7 (sentinel/inf contract, variant b: large finite value + saturating
// add). See plans/field_pathfinding_requirements.md.
//
// $INF is a placeholder for the real R7-defined sentinel constant. sat_add keeps
// blocked neighbours at INF without overflow/wrap and never introduces NaN.
model sentinel

in { neighbour, cost }

$INF = 1e18

// A reachable neighbour accumulates cost; a blocked (INF) neighbour stays INF.
relaxed = sat_add(neighbour, cost)

// min must treat INF as the identity: min(INF, x) == x for finite x.
best = min(relaxed, $INF)

out { relaxed, best }
