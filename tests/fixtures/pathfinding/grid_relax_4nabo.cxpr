// R6 argmin with R7 sentinel saturation as a plain `fn`, not a builtin.
// Reference cell-model for the agnostic `grid_relax` interop descriptor
// (4-neighbour). This IS the interop spec other consumers copy.
model grid_relax_4nabo

// Host halo-gathers per cell as scalar columns. Blocked / out-of-bounds
// neighbours arrive as INF. cost is per-cell traversal cost.
in { d_n, d_s, d_e, d_w, cost, is_wall, is_goal }

$INF = 1e18

// R7 convention: saturating add keeps a blocked neighbour (INF) at INF.
fn sadd(a, b) = min(a + b, $INF)

cand_n = sadd(d_n, cost)
cand_s = sadd(d_s, cost)
cand_e = sadd(d_e, cost)
cand_w = sadd(d_w, cost)

// Label-correcting relaxation: walls are INF, goals are 0, else the min neighbour.
next_dist = is_wall > 0 ? $INF : is_goal > 0 ? 0 : min(cand_n, cand_s, cand_e, cand_w)

// Movement intent as a direction code (B4): 0=N, 1=S, 2=E, 3=W.
// Only valid when next_dist < $INF (B3) -- host must check before trusting it.
dir = argmin(cand_n, cand_s, cand_e, cand_w)

out { next_dist, dir }
