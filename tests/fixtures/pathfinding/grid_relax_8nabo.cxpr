// R6 argmin with R7 sentinel saturation as a plain `fn`, not a builtin.
// 8-neighbour variant of the `grid_relax` interop descriptor. Diagonal cost is
// supplied separately by the host (typically ~sqrt(2) * cost).
model grid_relax_8nabo

// Rooted records express the domain shape; generated descriptors expose their
// leaves as scalar columns for allocation-free bulk execution.
in neighbours {
    north, south, east, west,
    north_east, north_west, south_east, south_west
}
in cell { cost, diagonal_cost, is_wall, is_goal }

$INF = 1e18

fn sadd(a, b) = min(a + b, $INF)

cand_n  = sadd(neighbours.north,      cell.cost)
cand_s  = sadd(neighbours.south,      cell.cost)
cand_e  = sadd(neighbours.east,       cell.cost)
cand_w  = sadd(neighbours.west,       cell.cost)
cand_ne = sadd(neighbours.north_east, cell.diagonal_cost)
cand_nw = sadd(neighbours.north_west, cell.diagonal_cost)
cand_se = sadd(neighbours.south_east, cell.diagonal_cost)
cand_sw = sadd(neighbours.south_west, cell.diagonal_cost)

next_dist = cell.is_wall > 0 ? $INF : cell.is_goal > 0 ? 0
    : min(cand_n, cand_s, cand_e, cand_w, cand_ne, cand_nw, cand_se, cand_sw)

// Direction code (B4): 0=N,1=S,2=E,3=W,4=NE,5=NW,6=SE,7=SW. arity 8 = max.
dir = argmin(cand_n, cand_s, cand_e, cand_w, cand_ne, cand_nw, cand_se, cand_sw)

out { next_dist, dir }
