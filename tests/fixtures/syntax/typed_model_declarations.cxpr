# Syntax contract for explicit model declaration types.
#
# Explicit types are validated at build time. Declarations without a type keep
# the existing inference behavior. `state` describes persistent lifetime; it
# does not imply that the value is a history buffer.
#
# `series<T>` is a runtime-produced sequence of T. `buffer<T, samples = N>` is
# persistent bounded storage with these rules:
# - N is a positive integer known at build time.
# - A newly initialized buffer is empty; it is not prefilled with zero values.
# - A buffer declaration does not accept an `=` initializer.
# - `samples` is the maximum capacity.
# - `observed := expression` evaluates the expression once per tick and stages
#   one push at the same atomic commit point used by scalar state updates.
# - Reads during that tick see the previously committed buffer. Index zero is
#   the newest committed sample; index one is the preceding sample.
# - Pushing into a full buffer removes the oldest element.
# - Capacity configures the common `buffer<T>` type rather than creating a
#   distinct nominal type for every N. The compiler may still specialize its
#   storage layout using the build-time capacity.
#
# This executable fixture is validated and compiled by the model test suite.

model typed_model_declarations

in {
    source: series<number>
    enabled: series<bool>
    $period: int = 14 {
        min = 1
        max = 512
    }
}

state {
    average: number = 0
    initialized: bool = false
    observed: buffer<number, samples = 64>

    # Backward-compatible fallback: infer `number` from the initializer.
    ticks = 0
}

next_average = initialized ? average + (source - average) / $period : source
next_ticks = ticks + 1

average := next_average
initialized := true
ticks := next_ticks
observed := source

out {
    value: series<number> = next_average
    ready: series<bool> = enabled and initialized
}
