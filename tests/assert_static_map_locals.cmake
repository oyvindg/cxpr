file(READ "${GENERATED}" source)
string(REGEX MATCHALL "const double _cx_local_[0-9]+ =" definitions "${source}")
list(LENGTH definitions definition_count)
if(NOT definition_count EQUAL 4)
    message(FATAL_ERROR
        "expected cursor/index temporaries once for each of two map elements; got ${definition_count}")
endif()
foreach(index RANGE 0 3)
    string(REGEX MATCHALL "_cx_local_${index}" uses "${source}")
    list(LENGTH uses use_count)
    if(use_count LESS 3)
        message(FATAL_ERROR "_cx_local_${index} was not reused: ${use_count} occurrences")
    endif()
endforeach()
