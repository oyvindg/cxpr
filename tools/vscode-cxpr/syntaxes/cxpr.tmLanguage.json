{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CXPR",
  "scopeName": "source.cxpr",
  "x-cxpr-generated": true,
  "x-cxpr-token-patterns": {
    "comment": {
      "pattern": "#.*$",
      "scope": "comment.line.cxpr"
    },
    "string": {
      "pattern": "(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*')",
      "scope": "string.quoted.cxpr"
    },
    "parameter": {
      "pattern": "\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*",
      "scope": "variable.parameter.cxpr"
    },
    "type": {
      "pattern": "\\b(?:bool|buffer|int|number|series)\\b",
      "scope": "entity.name.type.cxpr"
    },
    "keyword": {
      "pattern": "\\b(?:and|as|or|not|if|then|else|fn|from|in|initial|model|name|out|return|state|update|use|true|false|null|assert|optimize)\\b",
      "scope": "keyword.control.cxpr"
    },
    "function": {
      "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
      "scope": "entity.name.function.cxpr"
    },
    "property": {
      "pattern": "\\.[A-Za-z_][A-Za-z0-9_]*",
      "scope": "variable.other.property.cxpr"
    },
    "number": {
      "pattern": "(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?:i64)?",
      "scope": "constant.numeric.cxpr"
    },
    "operator": {
      "pattern": "<=|>=|==|!=|&&|\\|\\||\\|>|\\*\\*|[-+*/%^<>=!?:]",
      "scope": "keyword.operator.cxpr"
    },
    "punctuation": {
      "pattern": "[.,]",
      "scope": "punctuation.cxpr"
    }
  },
  "patterns": [
    {
      "name": "comment.line.number-sign.cxpr",
      "match": "#.*$"
    },
    {
      "name": "comment.line.double-slash.cxpr",
      "match": "//.*$"
    },
    {
      "name": "comment.block.cxpr",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.cxpr",
      "match": "\"(?:\\\\.|[^\"\\\\])*\""
    },
    {
      "name": "string.quoted.single.cxpr",
      "match": "'(?:\\\\.|[^'\\\\])*'"
    },
    {
      "match": "\\b(type|id|label|description|hover|mode|source|broker|symbol|strategy|aggregate_from|lifecycle|source_arg)\\b(\\s*=\\s*)([A-Za-z_][A-Za-z0-9_.-]*)(?=\\s*(?:[,}\\]#]|//|$))",
      "captures": {
        "1": {
          "name": "variable.other.assignment.cxpr"
        },
        "2": {
          "name": "keyword.operator.assignment.cxpr"
        },
        "3": {
          "name": "string.unquoted.document.cxpr"
        }
      }
    },
    {
      "match": "\\b(books|hedging)\\b(\\s*=\\s*\\[\\s*)([A-Za-z_][A-Za-z0-9_.-]*)(?=\\s*(?:,|\\]))",
      "captures": {
        "1": {
          "name": "variable.other.assignment.cxpr"
        },
        "2": {
          "name": "keyword.operator.assignment.cxpr"
        },
        "3": {
          "name": "string.unquoted.document.cxpr"
        }
      }
    },
    {
      "match": "\\b(use)(\\s*\\{)([^}]*)(\\})(\\s+)(from)(\\s+)([A-Za-z0-9_./-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "entity.name.function.cxpr"
        },
        "6": {
          "name": "keyword.control.cxpr"
        },
        "8": {
          "name": "string.unquoted.import-path.cxpr"
        }
      }
    },
    {
      "match": "\\b(use)(\\s+)([A-Za-z0-9_./-]*\\/[A-Za-z0-9_./-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "string.unquoted.import-path.cxpr"
        }
      }
    },
    {
      "match": "\\b(use)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)(\\s+)(from)(\\s+)([A-Za-z0-9_./-]+)",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "entity.name.function.cxpr"
        },
        "5": {
          "name": "keyword.control.cxpr"
        },
        "7": {
          "name": "string.unquoted.import-path.cxpr"
        }
      }
    },
    {
      "match": "\\b(name|model)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "variable.other.assignment.cxpr"
        }
      }
    },
    {
      "begin": "\\b(in)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "variable.other.assignment.cxpr"
        },
        "5": {
          "name": "punctuation.cxpr"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.cxpr"
        }
      },
      "patterns": [
        {
          "name": "variable.other.input.cxpr",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "punctuation.cxpr",
          "match": "[.,]"
        }
      ]
    },
    {
      "begin": "\\b(in)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*,)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "variable.other.input.cxpr"
        }
      },
      "end": "$",
      "patterns": [
        {
          "name": "variable.other.input.cxpr",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "punctuation.cxpr",
          "match": "[.,]"
        }
      ]
    },
    {
      "match": "\\b(in)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:,|\\{|$))",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "variable.other.input.cxpr"
        }
      }
    },
    {
      "match": "\\b(out)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\{|$))",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "variable.other.cxpr"
        }
      }
    },
    {
      "match": "\\b(update)(\\s+)(state)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "keyword.control.cxpr"
        }
      }
    },
    {
      "match": "\\b(out|state)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)(?=\\s*=)",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "3": {
          "name": "variable.other.assignment.cxpr"
        }
      }
    },
    {
      "name": "variable.other.named-argument.cxpr",
      "match": "\\boptimize(?=\\s*(?:=|\\{))"
    },
    {
      "match": "^(\\s*)(type|timeframe)(\\s*)(=)",
      "captures": {
        "2": {
          "name": "variable.other.named-argument.cxpr"
        },
        "4": {
          "name": "keyword.operator.cxpr"
        }
      }
    },
    {
      "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(=)",
      "captures": {
        "2": {
          "name": "variable.other.assignment.cxpr"
        },
        "4": {
          "name": "keyword.operator.assignment.cxpr"
        }
      }
    },
    {
      "match": "^(\\s*)(\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(\\s*)(=)",
      "captures": {
        "2": {
          "name": "variable.other.assignment.cxpr"
        },
        "4": {
          "name": "keyword.operator.assignment.cxpr"
        }
      }
    },
    {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "2": {
          "name": "entity.name.function.cxpr"
        }
      }
    },
    {
      "match": "^\\s*((?!name\\b|model\\b|use\\b|in\\b|fn\\b|update\\b|out\\b|state\\b|meta\\b|assert\\b|optimize\\b)[A-Za-z_][A-Za-z0-9_]*)(?:\\s+([A-Za-z_][A-Za-z0-9_.]*))?(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "keyword.control.cxpr"
        },
        "2": {
          "name": "variable.other.block-label.cxpr"
        }
      }
    },
    {
      "name": "variable.other.block-label.cxpr",
      "match": "\\bplot(?=\\s*\\{)"
    },
    {
      "name": "variable.other.block-label.cxpr",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\{)"
    },
    {
      "name": "variable.parameter.cxpr",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    {
      "name": "entity.name.type.cxpr",
      "match": "\\b(?:bool|buffer|int|number|series)\\b"
    },
    {
      "name": "keyword.control.cxpr",
      "match": "\\b(?:and|as|or|not|if|then|else|fn|from|in|initial|model|name|out|return|state|update|use|true|false|null|assert|optimize)\\b"
    },
    {
      "name": "entity.name.function.cxpr",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "variable.other.named-argument.cxpr",
      "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*=)"
    },
    {
      "name": "variable.other.property.cxpr",
      "match": "\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "constant.numeric.cxpr",
      "match": "(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?:i64)?"
    },
    {
      "name": "keyword.operator.cxpr",
      "match": "<=|>=|==|!=|&&|\\|\\||\\|>|\\*\\*|[-+*/%^<>=!?:]"
    },
    {
      "name": "punctuation.cxpr",
      "match": "[.,]"
    }
  ]
}
