{
  "defaultToken": "variable",
  "keywords": [
    "and",
    "as",
    "or",
    "not",
    "if",
    "then",
    "else",
    "fn",
    "from",
    "in",
    "initial",
    "model",
    "name",
    "out",
    "return",
    "state",
    "update",
    "use",
    "true",
    "false",
    "null",
    "assert",
    "optimize"
  ],
  "tokenPatterns": {
    "comment": "#.*$",
    "string": "(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*')",
    "parameter": "\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*",
    "type": "\\b(?:bool|buffer|int|number|series)\\b",
    "keyword": "\\b(?:and|as|or|not|if|then|else|fn|from|in|initial|model|name|out|return|state|update|use|true|false|null|assert|optimize)\\b",
    "function": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
    "property": "\\.[A-Za-z_][A-Za-z0-9_]*",
    "number": "(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?:i64)?",
    "operator": "<=|>=|==|!=|&&|\\|\\||\\|>|\\*\\*|[-+*/%^<>=!?:]",
    "punctuation": "[.,]"
  },
  "tokenizer": {
    "root": [
      [
        "#.*$",
        "comment"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "/\\*",
        "comment",
        "@blockComment"
      ],
      [
        "\"([^\"\\\\]|\\\\.)*$",
        "invalid"
      ],
      [
        "'([^'\\\\]|\\\\.)*$",
        "invalid"
      ],
      [
        "\"",
        "string",
        "@doubleString"
      ],
      [
        "'",
        "string",
        "@singleString"
      ],
      [
        "\\b(use)(\\s*\\{)([^}]*)(\\})(\\s+)(from)(\\s+)([A-Za-z0-9_./-]+)",
        [
          "keyword",
          "punctuation",
          "import",
          "punctuation",
          "white",
          "keyword",
          "white",
          "importPath"
        ]
      ],
      [
        "\\b(use)(\\s+)([A-Za-z0-9_./-]*\\/[A-Za-z0-9_./-]+)",
        [
          "keyword",
          "white",
          "importPath"
        ]
      ],
      [
        "\\b(use)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)(\\s+)(from)(\\s+)([A-Za-z0-9_./-]+)",
        [
          "keyword",
          "white",
          "import",
          "white",
          "keyword",
          "white",
          "importPath"
        ]
      ],
      [
        "\\b(name|model)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)(?=\\s*\\{)",
        [
          "keyword",
          "white",
          "assignment"
        ]
      ],
      [
        "\\b(in)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(\\{)",
        [
          "keyword",
          "white",
          "assignment",
          "white",
          {
            "token": "punctuation",
            "next": "@inputBlock"
          }
        ]
      ],
      [
        "\\b(in)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*,)",
        [
          "keyword",
          "white",
          {
            "token": "input",
            "next": "@inputList"
          }
        ]
      ],
      [
        "\\b(in)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:,|\\{|$))",
        [
          "keyword",
          "white",
          "input"
        ]
      ],
      [
        "\\b(out)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\{|$))",
        [
          "keyword",
          "white",
          "variable"
        ]
      ],
      [
        "\\b(update)(\\s+)(state)(?=\\s*\\{)",
        [
          "keyword",
          "white",
          "keyword"
        ]
      ],
      [
        "\\b(out|state)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)(?=\\s*=)",
        [
          "keyword",
          "white",
          "assignment"
        ]
      ],
      [
        "\\boptimize(?=\\s*(?:=|\\{))",
        "namedArgument"
      ],
      [
        "^(\\s*)(type|timeframe)(\\s*)(=)",
        [
          "white",
          "namedArgument",
          "white",
          "operator"
        ]
      ],
      [
        "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(=)",
        [
          "white",
          "assignment",
          "white",
          "operator"
        ]
      ],
      [
        "^(\\s*)(\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(\\s*)(=)",
        [
          "white",
          "assignment",
          "white",
          "operator"
        ]
      ],
      [
        "\\bplot(?=\\s*\\{)",
        "plotBlock"
      ],
      [
        "^\\s*((?!name\\b|model\\b|use\\b|in\\b|fn\\b|update\\b|out\\b|state\\b|meta\\b|assert\\b|optimize\\b)[A-Za-z_][A-Za-z0-9_]*)(?:\\s+([A-Za-z_][A-Za-z0-9_.]*))?(?=\\s*\\{)",
        [
          "block",
          "block"
        ]
      ],
      [
        "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\{)",
        "block"
      ],
      [
        "\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*",
        "parameter"
      ],
      [
        "\\b(?:bool|buffer|int|number|series)\\b",
        "type"
      ],
      [
        "\\b(?:and|as|or|not|if|then|else|fn|from|in|initial|model|name|out|return|state|update|use|true|false|null|assert|optimize)\\b",
        "keyword"
      ],
      [
        "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
        "function"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*(?=\\s*=)",
        "namedArgument"
      ],
      [
        "\\.[A-Za-z_][A-Za-z0-9_]*",
        "property"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        {
          "cases": {
            "@keywords": "keyword",
            "@default": "reference"
          }
        }
      ],
      [
        "(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?:i64)?",
        "number"
      ],
      [
        "<=|>=|==|!=|&&|\\|\\||\\|>|\\*\\*|[-+*/%^<>=!?:]",
        "operator"
      ],
      [
        "[{}\\[\\]()]",
        "@brackets"
      ],
      [
        "[.,]",
        "punctuation"
      ],
      [
        "\\s+",
        "white"
      ]
    ],
    "inputBlock": [
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "input"
      ],
      [
        "\\}",
        "punctuation",
        "@pop"
      ],
      [
        "[.,]",
        "punctuation"
      ],
      [
        "\\s+",
        "white"
      ]
    ],
    "inputList": [
      [
        "#.*$",
        "comment",
        "@pop"
      ],
      [
        "//.*$",
        "comment",
        "@pop"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*(?=\\s*$)",
        "input",
        "@pop"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "input"
      ],
      [
        "[.,]",
        "punctuation"
      ],
      [
        "\\s+",
        "white"
      ]
    ],
    "blockComment": [
      [
        "[^*/]+",
        "comment"
      ],
      [
        "\\*/",
        "comment",
        "@pop"
      ],
      [
        "[*/]",
        "comment"
      ]
    ],
    "doubleString": [
      [
        "[^\\\\\"]+",
        "string"
      ],
      [
        "\\\\.",
        "escape"
      ],
      [
        "\"",
        "string",
        "@pop"
      ]
    ],
    "singleString": [
      [
        "[^\\\\']+",
        "string"
      ],
      [
        "\\\\.",
        "escape"
      ],
      [
        "'",
        "string",
        "@pop"
      ]
    ]
  }
}
