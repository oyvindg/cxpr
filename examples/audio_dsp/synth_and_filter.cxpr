# Host-neutral, sample-at-a-time DSP graph.
#
# waveform: 0 = sine, 1 = saw, 2 = square, 3 = triangle

model synth_and_filter_example(type = "dsp")

in { frequency, gate }

$sample_rate = 48000
$waveform = 0
$gain = 0.2
$cutoff = 1800
$attack_seconds = 0.01
$release_seconds = 0.08

state {
    phase = 0
    envelope = 0
    lowpass_memory = 0
}

phase_step = max(0, frequency) / max(1, $sample_rate)
next_phase_unwrapped = phase + phase_step
next_phase = next_phase_unwrapped - floor(next_phase_unwrapped)

sine_wave = sin(phase * 6.283185307179586)
saw_wave = 2 * phase - 1
square_wave = phase < 0.5 ? 1 : -1
triangle_wave = 1 - 4 * abs(phase - 0.5)
oscillator = $waveform < 0.5 ? sine_wave : ($waveform < 1.5 ? saw_wave : ($waveform < 2.5 ? square_wave : triangle_wave))

attack_step = 1 / max(1, $attack_seconds * $sample_rate)
release_step = 1 / max(1, $release_seconds * $sample_rate)
next_envelope = gate > 0.5 ? min(1, envelope + attack_step) : max(0, envelope - release_step)
dry = oscillator * next_envelope * $gain

# Stable one-pole low-pass. The high-pass output is the residual, which makes
# the same graph useful as a basic subtractive synth or as a standalone filter.
cutoff_hz = min(max(0, $cutoff), $sample_rate * 0.49)
lowpass_coefficient = 1 - exp(-6.283185307179586 * cutoff_hz / max(1, $sample_rate))
lowpass = lowpass_memory + lowpass_coefficient * (dry - lowpass_memory)
highpass = dry - lowpass

phase := next_phase
envelope := next_envelope
lowpass_memory := lowpass

out { dry, lowpass, highpass, envelope }
