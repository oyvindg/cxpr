# Band-limited pulse pluck with a resonant filter envelope.
model arp(lifecycle = "scoped")

in age, frequency, trigger
$sample_rate = 44100
$gain = 0.18
fn arp_blep(p, dt) {
    leading = p / dt
    trailing = (p - 1) / dt
    return p < dt ? 2 * leading - leading * leading - 1 : p > 1 - dt ? trailing * trailing + 2 * trailing + 1 : 0
}
state { phase = 0, filter_low = 0, filter_band = 0 }
note_age = trigger > 0 ? 0 : max(0, age)
phase_now = trigger > 0 ? 0 : phase
step = frequency / $sample_rate
pulse_phase = (phase_now - 0.30 + 1) % 1
pulse = (phase_now < 0.30 ? 1 : -1) + arp_blep(phase_now, step) - arp_blep(pulse_phase, step)
cutoff = 900 + 6200 * exp(-18 * note_age)
filter_f = 2 * sin(pi() * cutoff / $sample_rate)
filter_high = pulse - filter_low - 0.36 * filter_band
next_band = filter_band + filter_f * filter_high
next_low = filter_low + filter_f * next_band
envelope = (1 - exp(-note_age / 0.002)) * exp(-14 * note_age)
phase := (phase_now + step) % 1
filter_low := next_low
filter_band := next_band
out sample = $gain * envelope * tanh(next_low)
