# Band-limited mono lead with glide, vibrato, ADSR and resonant filter.
model lead(lifecycle = "scoped")

in age, frequency, trigger
$sample_rate = 44100
$gain = 0.22
fn lead_blep(p, dt) {
    leading = p / dt
    trailing = (p - 1) / dt
    return p < dt ? 2 * leading - leading * leading - 1 : p > 1 - dt ? trailing * trailing + 2 * trailing + 1 : 0
}
state { phase = 0, vibrato_phase = 0, smoothed_frequency = 0,
        filter_low = 0, filter_band = 0 }
note_age = trigger > 0 ? 0 : max(0, age)
phase_now = trigger > 0 ? 0 : phase
vibrato_now = trigger > 0 ? 0 : vibrato_phase
vibrato = 0.0022 * sin(2 * pi() * vibrato_now) * min(1, note_age / 0.18)
glide_coefficient = 1 - exp(-1 / (0.035 * $sample_rate))
frequency_memory = smoothed_frequency <= 0 ? frequency : smoothed_frequency
next_frequency = frequency_memory + glide_coefficient * (frequency - frequency_memory)
step = next_frequency * (1 + vibrato) / $sample_rate
saw = 2 * phase_now - 1 - lead_blep(phase_now, step)
pulse_phase = (phase_now - 0.42 + 1) % 1
pulse = (phase_now < 0.42 ? 1 : -1) + lead_blep(phase_now, step) - lead_blep(pulse_phase, step)
source = 0.58 * saw + 0.42 * pulse
cutoff = 1500 + 4000 * exp(-4 * note_age)
filter_f = 2 * sin(pi() * cutoff / $sample_rate)
filter_high = tanh(0.85 * source) - filter_low - 0.48 * filter_band
next_band = filter_band + filter_f * filter_high
next_low = filter_low + filter_f * next_band
attack = clamp(note_age / 0.012, 0, 1)
decay = clamp((note_age - 0.012) / 0.11, 0, 1)
held_envelope = note_age < 0.012 ? attack : 1 - 0.24 * decay
envelope = held_envelope * clamp((0.57 - note_age) / 0.10, 0, 1)
phase := (phase_now + step) % 1
vibrato_phase := (vibrato_now + 5.2 / $sample_rate) % 1
smoothed_frequency := next_frequency
filter_low := next_low
filter_band := next_band
out sample = $gain * envelope * tanh(1.1 * next_low)
