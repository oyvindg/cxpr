# Two-saw bass with a square sub oscillator and cascaded 24 dB/oct low-pass.
model stacked_bass(lifecycle = "scoped")

use oscillator from oscillators
use adsr from envelopes
use resonance from mono.filters

in age, frequency, trigger
$sample_rate = 44100
$cutoff = 350
$gain = 0.28

# Two slightly detuned saws provide midrange motion. The square oscillator runs
# exactly one octave below the requested note and anchors the sub range.
first_saw = oscillator(frequency=frequency * 0.997, reset=0,
                       sample_rate=$sample_rate, waveform=0)
second_saw = oscillator(frequency=frequency * 1.003, reset=0,
                        sample_rate=$sample_rate, waveform=0)
square_sub = oscillator(frequency=frequency * 0.5, reset=0,
                        sample_rate=$sample_rate, waveform=1, pulse_width=0.5)
source = 0.34 * first_saw.sample + 0.34 * second_saw.sample +
    0.32 * square_sub.sample
# Cascading two 12 dB state-variable low-pass sections yields the required
# 24 dB/octave bass filter while retaining independent scoped state.
first_filter = resonance(mono=source, sample_rate=$sample_rate,
                                     cutoff=$cutoff, resonance=0.20)
second_filter = resonance(mono=first_filter.low,
                                      sample_rate=$sample_rate,
                                      cutoff=$cutoff, resonance=0.20)
gate = age < 0.21 ? 1 : 0
# The compact envelope supports both normal eighth notes and bridge sixteenths.
shape = adsr(gate=gate, trigger=trigger, sample_rate=$sample_rate,
             attack=0.004, decay=0.070, sustain=0.72, release=0.045)

out sample = $gain * shape.value * tanh(1.25 * second_filter.low)
