# Slow, filtered analog pad with wide detune and a soft octave-air layer.
model atmospheric_pad(lifecycle = "scoped")

use oscillator from oscillators
use adsr from envelopes
use state_variable_filter from filters

in age, frequency, trigger
$sample_rate = 44100
$hold = 1.95
$release = 0.65
$gain = 0.13

state triangle_phase = 0
state filter_lfo_phase = 0
# Two drifting saws form the wide analog body. A quiet triangle reinforces the
# fundamental, while the sine octave adds air without accordion-like harmonics.
left_saw = oscillator(frequency=frequency * 0.996, reset=0,
                      sample_rate=$sample_rate, waveform=0, drift=0.0007)
right_saw = oscillator(frequency=frequency * 1.004, reset=0,
                       sample_rate=$sample_rate, waveform=0, drift=0.0009)
air = oscillator(frequency=2.001 * frequency, reset=0,
                 sample_rate=$sample_rate, waveform=2, drift=0.0005)
triangle_now = triangle_phase
triangle = 4 * abs(triangle_now - 0.5) - 1
triangle_phase := (triangle_now + frequency / $sample_rate) % 1

gate = age < $hold ? 1 : 0
# Slow attack and release prevent chord boundaries from clicking and keep the
# pad behind the rhythm section.
shape = adsr(gate=gate, trigger=trigger, sample_rate=$sample_rate,
             attack=0.58, decay=0.82, sustain=0.70, release=$release)
filter_lfo_now = trigger > 0 ? 0 : filter_lfo_phase
source = 0.34 * left_saw.sample + 0.34 * right_saw.sample +
    0.10 * triangle + 0.22 * air.sample
cutoff = 720 + 1050 * shape.value +
    190 * sin(2 * pi() * filter_lfo_now)
# Envelope motion opens the filter with each chord; the slow LFO adds movement
# across sustained notes without changing their pitch.
filtered = state_variable_filter(source=source, sample_rate=$sample_rate,
                                 cutoff=cutoff, resonance=0.22,
                                 smoothing_seconds=0.014)
filter_lfo_phase := (filter_lfo_now + 0.075 / $sample_rate) % 1

out sample = $gain * shape.value * tanh(0.92 * filtered.low)
