# Band-limited mono bass with ADSR, resonant SVF and staged drive.
model bass(lifecycle = "scoped")

in age, frequency, trigger
$sample_rate = 44100
$gain = 0.34
$attack = 0.004
$decay = 0.075
$sustain = 0.68
$hold = 0.24
$release = 0.055

fn bass_blep(p, dt) {
    leading = p / dt
    trailing = (p - 1) / dt
    return p < dt ? 2 * leading - leading * leading - 1 : p > 1 - dt ? trailing * trailing + 2 * trailing + 1 : 0
}

state { phase = 0, sub_phase = 0, filter_low = 0, filter_band = 0 }
note_age = trigger > 0 ? 0 : max(0, age)
phase_now = trigger > 0 ? 0 : phase
sub_now = trigger > 0 ? 0 : sub_phase
step = frequency / $sample_rate
saw = 2 * phase_now - 1 - bass_blep(phase_now, step)
pulse_phase = (phase_now - 0.46 + 1) % 1
pulse = (phase_now < 0.46 ? 1 : -1) + bass_blep(phase_now, step) - bass_blep(pulse_phase, step)
sub = sin(2 * pi() * sub_now)
source = tanh(0.75 * (0.48 * saw + 0.27 * pulse + 0.30 * sub))
attack_level = clamp(note_age / $attack, 0, 1)
decay_position = clamp((note_age - $attack) / $decay, 0, 1)
held_envelope = note_age < $attack ? attack_level : 1 - (1 - $sustain) * decay_position
release_level = clamp(($hold + $release - note_age) / $release, 0, 1)
envelope = held_envelope * release_level
cutoff = 125 + 2450 * envelope * exp(-3.2 * note_age)
filter_f = 2 * sin(pi() * clamp(cutoff, 40, $sample_rate * 0.35) / $sample_rate)
filter_high = source - filter_low - 0.42 * filter_band
next_band = filter_band + filter_f * filter_high
next_low = filter_low + filter_f * next_band
phase := (phase_now + step) % 1
sub_phase := (sub_now + 0.5 * step) % 1
filter_low := next_low
filter_band := next_band
out sample = $gain * envelope * tanh(1.35 * next_low)
