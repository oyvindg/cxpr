# Warm three-oscillator pad with slow drift and a two-pole low-pass.
model pad(lifecycle = "scoped")

in age, frequency, trigger

$sample_rate = 44100
$hold = 2.0
$release = 0.40
$cutoff = 1200
$gain = 0.14
$attack = 0.14
$detune = 1.004

state {
    phase = 0,
    second_phase = 0,
    third_phase = 0,
    drift_phase = 0,
    low_one = 0,
    low_two = 0
}

note_age = trigger > 0 ? 0 : max(0, age)
step = frequency / $sample_rate
phase_now = trigger > 0 ? 0 : phase
second_now = trigger > 0 ? 0 : second_phase
third_now = trigger > 0 ? 0 : third_phase
drift_now = trigger > 0 ? 0 : drift_phase

leading = phase_now / step
trailing = (phase_now - 1) / step
blep = phase_now < step ? 2 * leading - leading * leading - 1 :
    phase_now > 1 - step ? trailing * trailing + 2 * trailing + 1 : 0
saw = 2 * phase_now - 1 - blep
drift = 0.0012 * sin(2 * pi() * drift_now)
source = 0.34 * sin(2 * pi() * phase_now) +
    0.28 * sin(2 * pi() * second_now) +
    0.24 * sin(2 * pi() * third_now) + 0.14 * saw

moving_cutoff = clamp($cutoff * (1 + 0.12 * sin(2 * pi() * drift_now)), 80, $sample_rate * 0.42)
coefficient = 1 - exp(-2 * pi() * moving_cutoff / $sample_rate)
memory_one = trigger > 0 ? 0 : low_one
memory_two = trigger > 0 ? 0 : low_two
filtered_one = memory_one + coefficient * (source - memory_one)
filtered_two = memory_two + coefficient * (filtered_one - memory_two)
gate = clamp(($hold + $release - note_age) / $release, 0, 1)
attack = clamp(note_age / max(0.001, $attack), 0, 1)
attack_curve = attack * attack * (3 - 2 * attack)
amplitude = attack_curve * gate * gate

phase := (phase_now + step) % 1
second_phase := (second_now + step * ($detune + drift)) % 1
third_phase := (third_now + step * (2 - $detune - 0.5 * drift)) % 1
drift_phase := (drift_now + 0.075 / $sample_rate) % 1
low_one := filtered_one
low_two := filtered_two

out sample = $gain * amplitude * tanh(1.1 * filtered_two)
