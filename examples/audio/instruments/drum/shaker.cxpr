// Hand-shaker texture with filtered grains and a short shell resonance.
model shaker(lifecycle = "scoped")

in trigger
$sample_rate = 44100
$seed = 52361
$gain = 0.18

// Two filter memories form a band-pass grain layer; phase adds shell color.
state { age = 10, seed = 0, slow = 0, fast = 0, shell_phase = 0 }
note_age = trigger ? 0 : age
current_seed = trigger or seed == 0 ? $seed : seed
next_seed = (48271 * current_seed) % 2147483647
noise = 2 * next_seed / 2147483647 - 1

// Reset filter memory on a trigger so each hand movement has a crisp onset.
slow_memory = trigger ? 0 : slow
fast_memory = trigger ? 0 : fast
slow_coefficient = 1 - exp(-2 * pi() * 2800 / $sample_rate)
fast_coefficient = 1 - exp(-2 * pi() * 9800 / $sample_rate)
next_slow = slow_memory + slow_coefficient * (noise - slow_memory)
next_fast = fast_memory + fast_coefficient * (noise - fast_memory)
// Subtracting the two low-pass responses retains only the seed/grain band.
grains = next_fast - next_slow

// A quiet, rapidly decaying resonance suggests the shaker body without a
// prominent pitched ping.
shell_now = trigger ? 0 : shell_phase
shell = sin(2 * pi() * shell_now) * exp(-48 * note_age)
envelope = (1 - exp(-note_age / 0.0005)) *
    (0.78 * exp(-31 * note_age) + 0.22 * exp(-70 * note_age))

// State remains deterministic, making renders and regression tests repeatable.
age := note_age + 1 / $sample_rate
seed := next_seed
slow := next_slow
fast := next_fast
shell_phase := (shell_now + 3400 / $sample_rate) % 1
out sample = $gain * envelope * tanh(1.12 * grains + 0.08 * shell)
