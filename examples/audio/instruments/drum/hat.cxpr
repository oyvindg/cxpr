// Metallic hat voice; decay selects closed or open articulation.
model hat(lifecycle = "scoped")

in trigger
$sample_rate = 44100
$seed = 12345
$decay = 48
$gain = 0.24

// One model serves both articulations; call sites provide different decay values.
state { age = 10, seed = 0, low = 0, metal_phase = 0 }
note_age = trigger ? 0 : age
current_seed = trigger or seed == 0 ? $seed : seed
next_seed = (48271 * current_seed) % 2147483647
noise = 2 * next_seed / 2147483647 - 1

// A high cutoff extracts the brittle noise band typical of small cymbals.
memory = trigger ? 0 : low
coefficient = 1 - exp(-2 * pi() * 6200 / $sample_rate)
next_low = memory + coefficient * (noise - memory)
bright = noise - next_low
metal_now = trigger ? 0 : metal_phase
// Three inharmonic partials add metal identity beneath the noise layer.
metal = sin(2 * pi() * metal_now) + 0.62 * sin(2 * pi() * 1.447 * metal_now) +
    0.38 * sin(2 * pi() * 1.917 * metal_now)
envelope = (1 - exp(-note_age / 0.0007)) * exp(-$decay * note_age)

// Retriggers replace the current articulation; separate scoped voices let open
// and closed hats overlap in the composition root.
age := note_age + 1 / $sample_rate
seed := next_seed
low := next_low
metal_phase := metal_now + 6100 / $sample_rate
out sample = $gain * envelope * tanh(0.76 * bright + 0.20 * metal)
