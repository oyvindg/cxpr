// Layered crash cymbal with broadband wash and independent inharmonic modes.
model crash(lifecycle = "scoped")

in trigger
$sample_rate = 44100
$seed = 41879
$gain = 0.24

// Separate filter and oscillator state lets noise wash and metal partials decay
// independently instead of behaving like one pitched, noise-modulated tone.
state {
    age = 10,
    seed = 0,
    noise_slow = 0,
    noise_fast = 0,
    phase_one = 0,
    phase_two = 0,
    phase_three = 0,
    phase_four = 0,
    shimmer_phase = 0
}
note_age = trigger ? 0 : age
current_seed = trigger or seed == 0 ? $seed : seed
next_seed = (48271 * current_seed) % 2147483647
noise = 2 * next_seed / 2147483647 - 1

// Two one-pole filters divide the excitation into metallic body and high air.
slow_memory = trigger ? 0 : noise_slow
fast_memory = trigger ? 0 : noise_fast
slow_coefficient = 1 - exp(-2 * pi() * 1800 / $sample_rate)
fast_coefficient = 1 - exp(-2 * pi() * 9200 / $sample_rate)
next_slow = slow_memory + slow_coefficient * (noise - slow_memory)
next_fast = fast_memory + fast_coefficient * (noise - fast_memory)
body_noise = next_fast - next_slow
air_noise = noise - next_fast

// Independent phases and non-integer frequency relationships prevent a stable
// fundamental from emerging as the cymbal rings out.
one = trigger ? 0 : phase_one
two = trigger ? 0 : phase_two
three = trigger ? 0 : phase_three
four = trigger ? 0 : phase_four
metal = 0.38 * sin(2 * pi() * one) + 0.27 * sin(2 * pi() * two) +
    0.21 * sin(2 * pi() * three) + 0.14 * sin(2 * pi() * four)

// A fast impact sits in front of a two-stage wash. Slow, shallow shimmer keeps
// the tail moving without turning into an audible tremolo.
attack = 1 - exp(-note_age / 0.0014)
impact = (0.70 * body_noise + 0.30 * air_noise) * exp(-52 * note_age)
wash_envelope = attack *
    (0.76 * exp(-1.25 * note_age) + 0.24 * exp(-4.2 * note_age))
shimmer_now = trigger ? 0 : shimmer_phase
shimmer = 0.95 + 0.035 * sin(2 * pi() * shimmer_now) +
    0.015 * sin(2 * pi() * 1.71 * shimmer_now)
wash = shimmer * wash_envelope *
    (0.62 * body_noise + 0.20 * air_noise + 0.18 * metal)

// State advances at audio rate; the long wash intentionally overlaps later kit
// hits while the master and bus compressor contain its occasional peaks.
age := note_age + 1 / $sample_rate
seed := next_seed
noise_slow := next_slow
noise_fast := next_fast
phase_one := (one + 3271 / $sample_rate) % 1
phase_two := (two + 4519 / $sample_rate) % 1
phase_three := (three + 6389 / $sample_rate) % 1
phase_four := (four + 8273 / $sample_rate) % 1
shimmer_phase := (shimmer_now + 3.7 / $sample_rate) % 1

// Gentle saturation blends impact and wash without a brittle hard ceiling.
out sample = $gain * tanh(0.72 * impact + 1.08 * wash)
