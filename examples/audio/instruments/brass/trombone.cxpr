# Low synthetic trombone with a slow brass bloom and resonant formants.
model trombone(lifecycle = "scoped")

use oscillator from oscillators
use state_variable_filter from filters
use saturation from effects
use rounded_ar from envelopes
use vibrato from effects

in age, frequency, trigger
$sample_rate = 44100
$hold = 3.25
$release = 1.10
$gain = 0.48

note_age = trigger ? 0 : max(0, age)
bloom = clamp(note_age / 0.32, 0, 1)
pitch = vibrato(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    rate=4.55, depth=0.0020, delay=0.20, fade=0.36, initial_phase=0.76)
growl = 1 + 0.0018 * sin(2 * pi() * 29 * note_age)

saw = oscillator(frequency=frequency * pitch.ratio, reset=0,
                 sample_rate=$sample_rate, waveform=0, drift=0.0008)
pulse = oscillator(frequency=frequency * 0.997 * growl, reset=0,
                   sample_rate=$sample_rate, waveform=1,
                   pulse_width=0.39, drift=0.0006)
excitation = saturation(source=0.72 * saw + 0.28 * pulse,
                        drive=1.45 + 0.55 * bloom)

# Two broad resonances suggest the bell and bore without making the distant
# voice unnaturally bright.
lower_formant = state_variable_filter(source=excitation,
                                      sample_rate=$sample_rate,
                                      cutoff=430 + 90 * bloom,
                                      resonance=1.15)
upper_formant = state_variable_filter(source=excitation,
                                      sample_rate=$sample_rate,
                                      cutoff=920 + 180 * bloom,
                                      resonance=0.92)
body = 0.78 * lower_formant.low + 0.42 * lower_formant.band +
    0.20 * upper_formant.band

envelope = rounded_ar(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    attack=0.20, hold=$hold, release=$release)

out sample = $gain * envelope * tanh(1.35 * body)
