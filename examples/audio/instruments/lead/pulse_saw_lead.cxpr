# Bright saw/pulse lead with independent amplifier and filter envelopes.
model pulse_saw_lead(lifecycle = "scoped")

use oscillator from oscillators
use adsr from envelopes
use resonance from filters
use saturation from effects

in frequency, gate, trigger
$sample_rate = 44100
$detune_ratio = 1.006
$cutoff_base = 320
$cutoff_envelope = 4300
$resonance = 0.58
$attack = 0.008
$release = 0.10
$amp_decay = 0.10
$amp_sustain = 0.58
$filter_attack = 0.003
$filter_decay = 0.16
$filter_sustain = 0.16
$filter_release = 0.15
$pulse_mix = 0.38
$drive = 1.65
$low_mix = 1
$band_mix = 0
$notch_mix = 0
$high_mix = 0
$pwm_lfo_hz = 0
$pwm_depth = 0
$unison_mix = 0
$sub_mix = 0
$phase_reset = 1

state pwm_phase = 0

# Separate envelopes let a note remain loud while its filter settles. Defaults
# preserve the original modular-synth behavior; songs may request longer sustain.
amplitude = adsr(gate=gate, trigger=trigger, sample_rate=$sample_rate,
                 attack=$attack, decay=$amp_decay,
                 sustain=$amp_sustain, release=$release)
tone = adsr(gate=gate, trigger=trigger, sample_rate=$sample_rate,
            attack=$filter_attack, decay=$filter_decay,
            sustain=$filter_sustain, release=$filter_release)
oscillator_reset = trigger * clamp($phase_reset, 0, 1)
saw = oscillator(frequency=frequency, reset=oscillator_reset, sample_rate=$sample_rate,
                 waveform=0, drift=0.0015)
# The detuned pulse supplies stereo-era analog width even before external pan.
# Optional PWM is inert at depth zero and therefore backwards compatible.
pulse = oscillator(frequency=frequency * $detune_ratio, reset=oscillator_reset,
                   sample_rate=$sample_rate, waveform=1,
                   pulse_width=0.44 + clamp($pwm_depth, 0, 0.30) *
                       sin(2 * pi() * pwm_phase), drift=0.0011)
# Optional voices thicken retrowave patches while zero-valued defaults preserve
# the lean two-oscillator sound used by modular_synth.
unison_saw = oscillator(frequency=frequency / max(1.0001, $detune_ratio),
                        reset=oscillator_reset, sample_rate=$sample_rate,
                        waveform=0, drift=0.0013)
sub_pulse = oscillator(frequency=0.5 * frequency, reset=oscillator_reset,
                       sample_rate=$sample_rate, waveform=1,
                       pulse_width=0.5, drift=0.0007)
pwm_phase := (pwm_phase + max(0, $pwm_lfo_hz) / $sample_rate) % 1
pulse_mix = clamp($pulse_mix, 0, 1)
unison_mix = clamp($unison_mix, 0, 0.45)
sub_mix = clamp($sub_mix, 0, 0.25)
core_mix = max(0.30, 1 - unison_mix - sub_mix)
mixed = core_mix * ((1 - pulse_mix) * saw + pulse_mix * pulse) +
    unison_mix * unison_saw.sample + sub_mix * sub_pulse.sample
# Drive occurs before the resonant filter, matching a subtractive synth voice
# where oscillator mixer saturation excites the filter rather than the output.
driven = saturation(source=mixed, drive=$drive)
cutoff = $cutoff_base + $cutoff_envelope * tone
filtered = resonance(source=driven, sample_rate=$sample_rate,
                                 cutoff=cutoff, resonance=$resonance)
# Output weights expose low, band, notch, and high-pass morphing without
# duplicating oscillator or envelope state in consuming songs.
selected = $low_mix * filtered.low +
    1.35 * $band_mix * filtered.band +
    0.72 * $notch_mix * (filtered.low + filtered.high) +
    0.86 * $high_mix * filtered.high

out sample = amplitude * selected
