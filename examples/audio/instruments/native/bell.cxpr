# Arpeggiert FM-klokkespill. Instrumentet sekvenserer sine egne noter fra en
# akkord (fire frekvenser inn) og synter dem med fire operatorer, operator-
# feedback og et resonant state-variable-filter. Klokke, arp, FM og klang
# ligger her; sangen gir bare tid og de fire akkordtonene. Scoped fordi hvert
# kall trenger egen fase-, feedback- og filtertilstand.
model bell(lifecycle = "scoped")

in t, f1, f2, f3, f4

$sample_rate = 44100
$bpm = 108
$gain = 0.20
$octave = 2
$feedback = 0.62
$index_one = 2.4
$index_two = 1.3
$decay = 5.0
$resonance = 1.6

state {
    phase_c1 = 0,
    phase_m1 = 0,
    phase_c2 = 0,
    phase_m2 = 0,
    fb = 0,
    svf_low = 0,
    svf_band = 0,
    previous_step = -1
}

# Egen sekstendelsklokke ved $bpm. Seks stegs opp/ned-arp over de fire tonene.
sixteenth = 15 / $bpm
arp_index = floor(max(0, t) / sixteenth)
pattern = arp_index % 6
note_hz = pattern == 0 ? f1 :
          pattern == 1 ? f2 :
          pattern == 2 ? f3 :
          pattern == 3 ? f4 :
          pattern == 4 ? f3 : f2
frequency = $octave * note_hz
trigger = arp_index != previous_step ? 1 : 0
note_age = max(0, t - arp_index * sixteenth)

# Fasene nullstilles ved hvert nytt anslag slik at hver tone starter rent.
step = frequency / $sample_rate
c1_now = trigger > 0 ? 0 : phase_c1
m1_now = trigger > 0 ? 0 : phase_m1
c2_now = trigger > 0 ? 0 : phase_c2
m2_now = trigger > 0 ? 0 : phase_m2
fb_now = trigger > 0 ? 0 : fb

# To carrier/modulator-par med inharmoniske ratioer gir klokkeklang.
# Modulator én får ett-sample feedback for ekstra overtoner i anslaget.
index_one = $index_one * exp(-7 * note_age)
index_two = $index_two * exp(-9 * note_age)
modulator_one = sin(2 * pi() * m1_now + $feedback * fb_now)
carrier_one = sin(2 * pi() * c1_now + index_one * modulator_one)
modulator_two = sin(2 * pi() * m2_now)
carrier_two = sin(2 * pi() * c2_now + index_two * modulator_two)
voice = 0.70 * carrier_one + 0.42 * carrier_two

# Resonant state-variable-filter (Chamberlin), sveipet av anslaget. f holdes
# under ~0.92 for stabilitet, og tilstanden nullstilles ved nytt anslag.
cutoff = clamp(1200 + 5200 * exp(-7 * note_age), 200, $sample_rate / 6.6)
f = 2 * sin(pi() * cutoff / $sample_rate)
q = clamp(1 / $resonance, 0.3, 1.4)
low_now = trigger > 0 ? 0 : svf_low
band_now = trigger > 0 ? 0 : svf_band
high = voice - low_now - q * band_now
band_next = band_now + f * high
low_next = low_now + f * band_next
filtered = 0.80 * low_next + 0.35 * band_next

attack = 1 - exp(-note_age / 0.0015)
amplitude = attack * exp(-$decay * note_age)

phase_c1 := (c1_now + step) % 1
phase_m1 := (m1_now + step * 1.41) % 1
phase_c2 := (c2_now + step * 2.0) % 1
phase_m2 := (m2_now + step * 2.76) % 1
fb := modulator_one
svf_low := low_next
svf_band := band_next
previous_step := arp_index

out sample = $gain * amplitude * tanh(1.2 * filtered)
