# Layered snare with band-shaped noise, two shell modes and a short snap.
model snare(lifecycle = "scoped")

in age, trigger

$sample_rate = 44100
$seed = 24681
$hold = 0.16
$release = 0.18
$gain = 0.42
$body_frequency = 185
$decay = 16

state { seed = 0, low = 0, upper = 0, phase = 0, second_phase = 0 }

note_age = trigger > 0 ? 0 : max(0, age)
current_seed = (trigger > 0 or seed == 0) ? $seed : seed
next_seed = (48271 * current_seed) % 2147483647
noise = 2 * next_seed / 2147483647 - 1

low_memory = trigger > 0 ? 0 : low
low_coefficient = 1 - exp(-2 * pi() * 900 / $sample_rate)
next_low = low_memory + low_coefficient * (noise - low_memory)
high = noise - next_low

upper_memory = trigger > 0 ? 0 : upper
upper_coefficient = 1 - exp(-2 * pi() * 8500 / $sample_rate)
band = upper_memory + upper_coefficient * (high - upper_memory)

phase_now = trigger > 0 ? 0 : phase
body = sin(2 * pi() * phase_now)
second_phase_now = trigger > 0 ? 0 : second_phase
second_body = sin(2 * pi() * second_phase_now)
attack = min(1, note_age / 0.001)
gate = clamp(($hold + $release - note_age) / $release, 0, 1)
noise_part = band * (0.68 * exp(-$decay * note_age) + 0.20 * exp(-65 * note_age))
body_part = (0.17 * body + 0.10 * second_body) * exp(-34 * note_age)

seed := next_seed
low := next_low
upper := band
phase := (phase_now + $body_frequency / $sample_rate) % 1
second_phase := (second_phase_now + 1.47 * $body_frequency / $sample_rate) % 1

out sample = $gain * attack * gate * tanh(1.2 * (noise_part + body_part))
