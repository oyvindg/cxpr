# Saturated mono bass with a band-limited edge, sub layer and two-pole filter.
model bass(lifecycle = "scoped")

in age, frequency, trigger

$sample_rate = 44100
$hold = 0.30
$release = 0.08
$gain = 0.30
$sub_mix = 0.28
$cutoff_floor = 145

state { phase = 0, sub_phase = 0, low_one = 0, low_two = 0 }

note_age = trigger > 0 ? 0 : max(0, age)
step = frequency / $sample_rate
phase_now = trigger > 0 ? 0 : phase
sub_now = trigger > 0 ? 0 : sub_phase

# Lokal PolyBLEP-korreksjon; frequency skal være positiv og under Nyquist.
leading = phase_now / step
trailing = (phase_now - 1) / step
blep = phase_now < step ? 2 * leading - leading * leading - 1 :
    phase_now > 1 - step ? trailing * trailing + 2 * trailing + 1 : 0
saw = 2 * phase_now - 1 - blep
fundamental = sin(2 * pi() * phase_now)
sub = sin(2 * pi() * sub_now)
source = tanh(1.4 * (0.58 * saw + 0.24 * fundamental + $sub_mix * sub))

cutoff = $cutoff_floor + 1650 * exp(-7.5 * note_age)
coefficient = 1 - exp(-2 * pi() * cutoff / $sample_rate)
memory_one = trigger > 0 ? 0 : low_one
memory_two = trigger > 0 ? 0 : low_two
filtered_one = memory_one + coefficient * (source - memory_one)
filtered_two = memory_two + coefficient * (filtered_one - memory_two)

attack = min(1, note_age / 0.006)
gate = clamp(($hold + $release - note_age) / $release, 0, 1)
amplitude = attack * exp(-1.8 * note_age) * gate

phase := (phase_now + step) % 1
sub_phase := (sub_now + 0.5 * step) % 1
low_one := filtered_one
low_two := filtered_two

out sample = $gain * amplitude * tanh(1.25 * filtered_two)
