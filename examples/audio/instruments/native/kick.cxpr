# Layered electronic kick: swept fundamental, short upper body and click.
# All phases are analytical, so repeated notes remain sample-accurate.
model kick(lifecycle = "scoped")

in age

$hold = 0.35
$release = 0.30
$gain = 0.46
$frequency = 46
$sweep = 115
$sweep_speed = 32
$decay = 8

note_age = max(0, age)
body_phase = $frequency * note_age +
    $sweep * (1 - exp(-$sweep_speed * note_age)) / $sweep_speed
upper_phase = 92 * note_age + 180 * (1 - exp(-55 * note_age)) / 55
gate = clamp(($hold + $release - note_age) / $release, 0, 1)
attack = 1 - exp(-note_age / 0.0035)
body = sin(2 * pi() * body_phase)
upper = sin(2 * pi() * upper_phase) * exp(-32 * note_age)
click = sin(2 * pi() * 1450 * note_age) * exp(-180 * note_age)
amplitude = attack * exp(-$decay * note_age) * gate

out sample = $gain * tanh(1.20 * amplitude * (body + 0.10 * upper + 0.025 * click))
