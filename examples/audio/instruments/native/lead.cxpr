# Expressive phase-modulated pluck with transient and tone smoothing.
model lead(lifecycle = "scoped")

in age, frequency, trigger

$sample_rate = 44100
$hold = 0.23
$release = 0.27
$index = 1.15
$gain = 0.26
$ratio = 2
$decay = 2.8
$octave_mix = 0.16
$transient_mix = 0.06
$cutoff_base = 1600
$cutoff_envelope = 5200

state { phase = 0, mod_phase = 0, low = 0 }

note_age = trigger > 0 ? 0 : max(0, age)
phase_now = trigger > 0 ? 0 : phase
mod_now = trigger > 0 ? 0 : mod_phase
step = frequency / $sample_rate

brightness = $index * exp(-3.6 * note_age)
modulator = sin(2 * pi() * mod_now)
carrier = sin(2 * pi() * phase_now + brightness * modulator)
octave = sin(4 * pi() * phase_now + 0.45 * brightness * modulator)
transient = sin(2 * pi() * 3 * mod_now) * exp(-35 * note_age)
detail_mix = clamp($octave_mix + $transient_mix, 0, 0.85)
wave = (1 - detail_mix) * carrier + $octave_mix * octave +
    $transient_mix * transient
cutoff = $cutoff_base + $cutoff_envelope * exp(-5.5 * note_age)
coefficient = 1 - exp(-2 * pi() * clamp(cutoff, 100, $sample_rate * 0.42) / $sample_rate)
memory = trigger > 0 ? 0 : low
filtered = memory + coefficient * (wave - memory)
gate = clamp(($hold + $release - note_age) / $release, 0, 1)
attack = 1 - exp(-note_age / 0.004)
amplitude = attack * exp(-$decay * note_age) * gate * gate

phase := (phase_now + step) % 1
mod_phase := (mod_now + step * $ratio) % 1
low := filtered

out sample = $gain * amplitude * tanh(1.15 * filtered)
