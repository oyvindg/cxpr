# Divisi violin section with three independent oscillator and resonator states.
model violin_section(lifecycle = "scoped")

use violin from instruments.classical

in age, first_frequency, second_frequency, third_frequency, trigger
$sample_rate = 44100
$hold = 0.40
$attack = 0.14
$release = 0.18
$gain = 0.105
$harmony_mix = 0.20
first = violin(age=age, frequency=first_frequency, trigger=trigger,
    sample_rate=$sample_rate, hold=$hold, attack=$attack,
    release=$release, gain=$gain)
second = violin(age=age, frequency=second_frequency, trigger=trigger,
    sample_rate=$sample_rate, hold=$hold, attack=1.08 * $attack,
    release=$release, gain=$harmony_mix * 0.86 * $gain)
third = violin(age=age, frequency=third_frequency, trigger=trigger,
    sample_rate=$sample_rate, hold=$hold, attack=1.16 * $attack,
    release=$release, gain=$harmony_mix * 0.76 * $gain)
out sample = first + second + third
