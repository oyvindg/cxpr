# Bowed viola with dark bridge excitation and two body modes.
model viola(lifecycle = "scoped")

use oscillator from oscillators
use vibrato from effects
use portamento from effects
use rounded_ar from envelopes

in age, frequency, trigger
$sample_rate = 44100
$hold = 0.82
$attack = 0.13
$release = 0.20
$gain = 0.14
state { body_one_low = 0, body_one_band = 0,
        body_two_low = 0, body_two_band = 0 }
note_age = trigger > 0 ? 0 : max(0, age)
glide = portamento(frequency=frequency, trigger=trigger,
    sample_rate=$sample_rate, seconds=0.032)
pitch = vibrato(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    rate=4.75, depth=0.0022, delay=0.13, fade=0.26, initial_phase=0.31)
carrier = oscillator(frequency=glide * pitch.ratio, reset=0, sample_rate=$sample_rate,
    waveform=2, drift=0.00032)
octave = oscillator(frequency=2.002 * glide * (1 + 0.74 * pitch.modulation), reset=0,
    sample_rate=$sample_rate, waveform=2, drift=0.00020)
envelope = rounded_ar(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    attack=$attack, hold=$hold, release=$release)
excitation = envelope * (0.93 * carrier + 0.07 * octave)
body_one_f = 2 * sin(pi() * 350 / $sample_rate)
body_one_high = excitation - body_one_low - 0.28 * body_one_band
body_one_next_band = body_one_band + body_one_f * body_one_high
body_one_next_low = body_one_low + body_one_f * body_one_next_band
body_two_f = 2 * sin(pi() * 720 / $sample_rate)
body_two_high = excitation - body_two_low - 0.34 * body_two_band
body_two_next_band = body_two_band + body_two_f * body_two_high
body_two_next_low = body_two_low + body_two_f * body_two_next_band
body_one_low := body_one_next_low
body_one_band := body_one_next_band
body_two_low := body_two_next_low
body_two_band := body_two_next_band
out sample = $gain * tanh(0.50 * excitation + 0.18 * body_one_next_low + 0.08 * body_two_next_band)
