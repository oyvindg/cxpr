# Dark bowed double bass with slow articulation and low wooden resonances.
model double_bass(lifecycle = "scoped")

use oscillator from oscillators
use vibrato from effects
use portamento from effects
use rounded_ar from envelopes
use resonance from mono.filters

in age, frequency, trigger
$sample_rate = 44100
$hold = 0.82
$attack = 0.18
$release = 0.28
$gain = 0.20
note_age = trigger > 0 ? 0 : max(0, age)
glide = portamento(frequency=frequency, trigger=trigger,
    sample_rate=$sample_rate, seconds=0.024)
pitch = vibrato(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    rate=3.85, depth=0.0015, delay=0.20, fade=0.34, initial_phase=0.43)
fundamental = oscillator(frequency=glide * pitch.ratio, reset=0,
    sample_rate=$sample_rate, waveform=2, drift=0.00020)
second = oscillator(frequency=2.001 * glide, reset=0,
    sample_rate=$sample_rate, waveform=2, drift=0.00014)
body = resonance(mono=0.88 * fundamental + 0.12 * second,
    sample_rate=$sample_rate, cutoff=820, resonance=0.14)
envelope = rounded_ar(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    attack=$attack, hold=$hold, release=$release)
out sample = $gain * envelope * tanh(0.92 * body.low)
