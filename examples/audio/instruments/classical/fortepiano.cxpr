# Modal fortepiano: felt hammer, coupled strings and soundboard memory.
model fortepiano(lifecycle = "scoped")

in age, frequency, trigger
$sample_rate = 44100
$gain = 0.22
state { phase = 0, soundboard_low = 0, soundboard_high = 0 }
note_age = trigger > 0 ? 0 : max(0, age)
phase_now = trigger > 0 ? 0 : phase
step = frequency / $sample_rate
hammer_contact = (1 - exp(-note_age / 0.00045)) * exp(-145 * note_age)
decay_scale = 0.34 + 0.00032 * frequency
single_string = sin(2 * pi() * phase_now)
coupled_strings = 0.50 * sin(2 * pi() * 0.9993 * phase_now) +
    0.31 * sin(2 * pi() * phase_now) +
    0.19 * sin(2 * pi() * 1.0009 * phase_now)
fundamental = frequency < 110 ? single_string : coupled_strings
mode_one = 0.61 * fundamental * exp(-decay_scale * note_age)
mode_two = 0.20 * sin(2 * pi() * 2.003 * phase_now) *
    exp(-2.2 * decay_scale * note_age)
mode_three = 0.10 * sin(2 * pi() * 3.009 * phase_now) *
    exp(-3.4 * decay_scale * note_age)
mode_four = 0.052 * sin(2 * pi() * 4.018 * phase_now) *
    exp(-4.8 * decay_scale * note_age)
mode_five = 0.023 * sin(2 * pi() * 5.031 * phase_now) *
    exp(-6.4 * decay_scale * note_age)
hammer = hammer_contact * (0.038 * sin(2 * pi() * 7.11 * phase_now) +
    0.022 * sin(2 * pi() * 10.37 * phase_now))
string = mode_one + mode_two + mode_three + mode_four + mode_five + hammer
low_coefficient = 1 - exp(-2 * pi() * 420 / $sample_rate)
high_coefficient = 1 - exp(-2 * pi() * 2300 / $sample_rate)
next_low = soundboard_low + low_coefficient * (string - soundboard_low)
next_high = soundboard_high + high_coefficient * (string - soundboard_high)
soundboard = 0.58 * next_high + 0.42 * next_low
phase := phase_now + step
soundboard_low := next_low
soundboard_high := next_high
out sample = $gain * tanh(1.12 * soundboard)
