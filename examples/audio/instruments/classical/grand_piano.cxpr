// Concert grand with hammer-driven, inharmonic string modes and a coupled board.
model grand_piano(lifecycle = "scoped")

use grand_piano_mode from instruments.classical

in age, frequency, trigger
$sample_rate = 44100
$gain = 0.20
// Retained for compatibility with waveguide-era callers.
in $delay_samples: int = 100 { min = 2, max = 1603 }

// Each scoped voice owns its oscillator, soundboard and retrigger state.
state {
    phase_one = 0,
    phase_two = 0,
    phase_three = 0,
    board_low = 0,
    board_mid = 0,
    board_high = 0,
    release_carry = 0,
    previous_sample = 0
}

// Normalize frequency to the acoustic A0-C8 keyboard range and register 0-1.
physical_frequency = clamp(frequency, 27.5, 4186.01)
key = clamp(69 + 12 * log(physical_frequency / 440) / log(2), 21, 108)
register = (key - 21) / 87
note_age = trigger > 0 ? 0 : max(0, age)

// A real hammer takes a short, register-dependent time to transfer its energy.
// The rounded onset avoids the instantaneous displacement that made the old
// feedback string sound plucked.
contact_seconds = 0.0032 - 0.0018 * register
hammer_onset = 1 - exp(-note_age / max(0.00025, contact_seconds))

// Railsback stretch and string-choir detuning. Bass keys are unichords, tenor
// keys are bichords, and the upper range uses three strings.
bass_stretch_cents = -1.5 * pow(1 - register, 3)
treble_stretch_cents = 2.8 * pow(register, 4)
stretch_ratio = pow(2, (bass_stretch_cents + treble_stretch_cents) / 1200)
detune_cents = 0.30 + 1.35 * register
ratio_one = stretch_ratio * pow(2, -detune_cents / 1200)
ratio_two = stretch_ratio
ratio_three = stretch_ratio * pow(2, detune_cents / 1200)

// A trigger resets all strings to the hammer contact origin.
one_now = trigger > 0 ? 0 : phase_one
two_now = trigger > 0 ? 0 : phase_two
three_now = trigger > 0 ? 0 : phase_three
phase_one := (one_now + physical_frequency * ratio_one / $sample_rate) % 1
phase_two := (two_now + physical_frequency * ratio_two / $sample_rate) % 1
phase_three := (three_now + physical_frequency * ratio_three / $sample_rate) % 1

// Piano stiffness pushes upper modes slightly sharp. Static scoped
// instantiation gives every partial independent phase state without manual
// phase declarations and update chains.
inharmonicity = 0.000035 + 0.00042 * pow(register, 2)
// Keep enough second mode to define bass pitch without making its long tail
// sound like broadband buzz when several low notes overlap.
second_mode_weight = 0.22 + 0.05 * pow(1 - register, 2)
mode_specs = {
    second = { harmonic = 2, gain = second_mode_weight,
        decay_base = 2.5, decay_slope = 1.05 },
    third = { harmonic = 3, gain = 0.088,
        decay_base = 1.65, decay_slope = 0.65 },
    fourth = { harmonic = 4, gain = 0.040,
        decay_base = 1.05, decay_slope = 0.35 },
    fifth = { harmonic = 5, gain = 0.018,
        decay_base = 0.72, decay_slope = 0.22 },
    sixth = { harmonic = 6, gain = 0.007,
        decay_base = 0.48, decay_slope = 0.12 }
}
mode_samples = map(mode_specs, mode => grand_piano_mode(
    age=note_age,
    frequency=physical_frequency,
    trigger=trigger,
    harmonic=mode.harmonic,
    gain=mode.gain,
    decay_base=mode.decay_base,
    decay_slope=mode.decay_slope,
    inharmonicity=inharmonicity,
    register=register,
    key=key,
    ratio_one=ratio_one,
    ratio_two=ratio_two,
    ratio_three=ratio_three,
    sample_rate=$sample_rate))

// The two-stage fundamental envelope provides body at impact and a bounded
// tail. Higher modes own their progressively shorter envelopes above.
fundamental_decay = 7.0 - 4.0 * register
fundamental_envelope = hammer_onset *
    (0.80 * exp(-note_age / fundamental_decay) +
     0.20 * exp(-note_age / (0.72 - 0.22 * register)))

// Select the physical string choir used by each keyboard register.
// Let the outer detuned strings settle slightly faster than the center string.
// This preserves the lively unison at the attack while keeping long exposed
// tails from developing an exaggerated vibrato-like beat.
unison_tail = 0.80 + 0.20 * exp(-note_age / 3.5)
unichord = sin(2 * pi() * two_now)
bichord = (0.54 + 0.46 * (1 - unison_tail)) * sin(2 * pi() * one_now) +
    0.46 * unison_tail * sin(2 * pi() * three_now)
trichord = 0.26 * unison_tail * sin(2 * pi() * one_now) +
    (0.48 + 0.52 * (1 - unison_tail)) * sin(2 * pi() * two_now) +
    0.26 * unison_tail * sin(2 * pi() * three_now)
fundamental = key < 33 ? unichord : key < 48 ? bichord : trichord

// The strike point suppresses selected upper modes instead of feeding a bright
// impulse into a delay loop. Bass gains second-mode definition, while treble
// gains fundamental body without exaggerating its sharper upper partials.
fundamental_mode_weight = 0.70 + 0.09 * pow(register, 2)
modes = fundamental_mode_weight * fundamental_envelope * fundamental +
    hammer_onset * sum(mode_samples)

// A short deterministic felt/wood transient supplies definition without a
// noise generator or the metallic click of a hard string reset.
impact_envelope = exp(-note_age / (0.010 - 0.004 * register))
impact_attack_seconds = 0.0015 + 0.0025 * (1 - register)
impact_onset = 1 - exp(-note_age / impact_attack_seconds)
// Felt absorbs more high-frequency hammer energy on the heavier bass strings.
impact_register_gain = 0.45 + 0.55 * register
impact = impact_register_gain * impact_onset * impact_envelope *
    (0.022 * sin(2 * pi() * 980 * note_age + key) +
    0.009 * sin(2 * pi() * 2050 * note_age + 0.37 * key))
bridge = modes + impact

// Three differently paced board paths spread the modal energy into a wooden,
// broadband body. Their state is reset on a new note to avoid clicks inherited
// from the previous key assigned to this scoped voice.
low_memory = trigger > 0 ? 0 : board_low
mid_memory = trigger > 0 ? 0 : board_mid
high_memory = trigger > 0 ? 0 : board_high
low_cutoff = 310 + 270 * register
mid_cutoff = 1250 + 900 * register
high_cutoff = 3800 + 2200 * register
low_coefficient = 1 - exp(-2 * pi() * low_cutoff / $sample_rate)
mid_coefficient = 1 - exp(-2 * pi() * mid_cutoff / $sample_rate)
high_coefficient = 1 - exp(-2 * pi() * high_cutoff / $sample_rate)
next_low = low_memory + low_coefficient * (bridge - low_memory)
next_mid = mid_memory + mid_coefficient * (bridge - mid_memory)
next_high = high_memory + high_coefficient * (bridge - high_memory)
board_low := next_low
board_mid := next_mid
board_high := next_high

// Bass keeps a strong low board path, but enough mid radiation remains to
// preserve the hammer position. A small treble return to the low board path
// adds wooden body instead of trying to thicken high notes with more brilliance.
low_weight = 0.50 - 0.10 * register + 0.04 * pow(register, 2)
high_weight = 0.08 + 0.09 * register
mid_weight = 1 - low_weight - high_weight
soundboard = low_weight * next_low + mid_weight * next_mid +
    high_weight * next_high
register_compensation = 1.30 - 0.22 * register

// Preserve continuity when a scoped voice is reassigned. Bass voices crossfade
// longer than treble voices while the new hammer attack rises from zero.
carry_seconds = 0.004 + 0.012 * (1 - register)
carry_now = trigger > 0 ? previous_sample : release_carry
carry_next = carry_now * exp(-1 / (carry_seconds * $sample_rate))
// Soft saturation bounds a single voice before the song-level master limiter.
new_sample = $gain * tanh(1.65 * register_compensation * soundboard)
sample = new_sample + carry_next
release_carry := carry_next
previous_sample := sample

out sample
