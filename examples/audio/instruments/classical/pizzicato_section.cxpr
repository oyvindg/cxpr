# Three-player pizzicato string section with rounded pluck and wooden decay.
model pizzicato_section(lifecycle = "scoped")

use oscillator from oscillators
use resonance from filters

in age, frequency, trigger
$sample_rate = 44100
$gain = 0.16

note_age = trigger > 0 ? 0 : max(0, age)
fundamental = oscillator(frequency=frequency, reset=trigger,
    sample_rate=$sample_rate, waveform=2, drift=0.00018)
left_player = oscillator(frequency=0.9978 * frequency, reset=trigger,
    sample_rate=$sample_rate, waveform=2, drift=0.00027)
right_player = oscillator(frequency=1.0024 * frequency, reset=trigger,
    sample_rate=$sample_rate, waveform=2, drift=0.00023)
second = oscillator(frequency=2.001 * frequency, reset=trigger,
    sample_rate=$sample_rate, waveform=2, drift=0.00012)
pluck = 0.58 * fundamental + 0.16 * left_player + 0.16 * right_player +
    0.10 * second
body = resonance(source=pluck, sample_rate=$sample_rate,
    cutoff=1750 + 900 * exp(-12 * note_age), resonance=0.18)
attack_position = clamp(note_age / 0.032, 0, 1)
attack = pow(sin(pi() * attack_position / 2), 2)
decay = exp(-4.8 * note_age)

out sample = $gain * attack * decay * tanh(0.78 * body.low)
