// Rounded late-analogue poly-unison voice with oscillator-mixer drive.
model classic_dual_vco(lifecycle = "scoped")

use oscillator from oscillators
use adsr from envelopes
use resonance from mono.filters
use saturation from mono.effects

in frequency, gate, trigger
$sample_rate = 44100
$detune_ratio = 1.0045
$unison_spread = 0.0062
$unison_mix = 0.42
$pulse_width = 0.46
$sub_mix = 0.18
$reset_phase = 1
$cutoff_base = 180
$cutoff_envelope = 3600
$resonance = 0.58
$drive = 1.85
$attack = 0.008
$decay = 0.18
$sustain = 0.46
$release = 0.14

amp = adsr(gate=gate, trigger=trigger, sample_rate=$sample_rate,
           attack=$attack, decay=$decay, sustain=$sustain, release=$release)
filter_env = adsr(gate=gate, trigger=trigger, sample_rate=$sample_rate,
                  attack=0.002, decay=0.19, sustain=0.10, release=0.08)
phase_reset = trigger * $reset_phase
saw = oscillator(frequency=frequency, reset=phase_reset, sample_rate=$sample_rate,
                 waveform=0, drift=0.0017)
pulse = oscillator(frequency=frequency * $detune_ratio, reset=phase_reset,
                   sample_rate=$sample_rate, waveform=1,
                   pulse_width=$pulse_width, drift=0.0011)
spread = clamp($unison_spread, 0, 0.018)
unison = clamp($unison_mix, 0, 0.68)
saw_low = oscillator(frequency=frequency * (1 - spread), reset=0,
                     sample_rate=$sample_rate, waveform=0, drift=0.0013)
saw_high = oscillator(frequency=frequency * (1 + spread), reset=0,
                      sample_rate=$sample_rate, waveform=0, drift=0.0021)
pulse_low = oscillator(frequency=frequency * $detune_ratio * (1 - 0.72 * spread),
                       reset=0, sample_rate=$sample_rate, waveform=1,
                       pulse_width=$pulse_width - 0.025, drift=0.0009)
pulse_high = oscillator(frequency=frequency * $detune_ratio * (1 + 0.72 * spread),
                        reset=0, sample_rate=$sample_rate, waveform=1,
                        pulse_width=$pulse_width + 0.025, drift=0.0015)
sub = oscillator(frequency=0.5 * frequency, reset=phase_reset,
                 sample_rate=$sample_rate, waveform=1, pulse_width=0.5)
core = 0.56 * saw.sample + 0.44 * pulse.sample
unison_layer = 0.27 * saw_low.sample + 0.27 * saw_high.sample +
    0.23 * pulse_low.sample + 0.23 * pulse_high.sample
sub_level = clamp($sub_mix, 0, 0.30)
mixed = ((1 - 0.48 * unison) * core + unison * unison_layer +
         sub_level * sub.sample) / (1 + 0.32 * unison + sub_level)
cutoff = $cutoff_base + $cutoff_envelope * filter_env.value
tone = mixed
    |> saturation(drive=$drive)
    |> resonance(sample_rate=$sample_rate, cutoff=cutoff,
                 resonance=$resonance)
// A gentle second pole rounds the bright oscillator edges without removing
// the first filter's moving resonance character.
polish = (tone.low + 0.16 * tone.band)
    |> resonance(sample_rate=$sample_rate,
                 cutoff=min(12000, 1.65 * cutoff), resonance=0.08)

out sample = 0.76 * amp.value * polish.low
