# Tuned orchestral timpani with pitch drop, membrane modes, and mallet attack.
model timpani(lifecycle = "scoped")

in trigger, frequency
$sample_rate = 44100
$gain = 0.52
$decay = 1.45

state { age = 10, phase = 0, second_phase = 0, shell_memory = 0 }

note_age = trigger ? 0 : age
phase_now = trigger ? 0 : phase
second_now = trigger ? 0 : second_phase
memory = trigger ? 0 : shell_memory

# The head settles quickly from a higher initial tension after the strike.
pitch = frequency * (1 + 0.28 * exp(-18 * note_age))
fundamental = sin(2 * pi() * phase_now)
membrane = 0.72 * fundamental + 0.23 * sin(2 * pi() * second_now) +
    0.09 * sin(2 * pi() * 2.08 * phase_now)
mallet = sin(2 * pi() * 1120 * note_age) * exp(-82 * note_age)
shell = 0.88 * memory + 0.12 * membrane
attack_position = clamp(note_age / 0.010, 0, 1)
attack = pow(sin(pi() * attack_position / 2), 2)
envelope = attack * exp(-$decay * note_age)

age := note_age + 1 / $sample_rate
phase := (phase_now + pitch / $sample_rate) % 1
second_phase := (second_now + 1.49 * pitch / $sample_rate) % 1
shell_memory := shell

out sample = $gain * envelope * tanh(1.12 * (0.84 * membrane +
    0.14 * shell + 0.045 * mallet))
