# Oboe with odd-harmonic reed excitation and a focused wooden formant.
model oboe(lifecycle = "scoped")

use resonance from filters
use oscillator from oscillators
use rounded_ar from envelopes
use vibrato from effects
use portamento from effects

in age, frequency, trigger
$sample_rate = 44100
$hold = 0.82
$release = 0.16
$gain = 0.15
note_age = trigger ? 0 : max(0, age)
glide = portamento(frequency=frequency, trigger=trigger,
    sample_rate=$sample_rate, seconds=0.036)
pitch = vibrato(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    rate=5.10, depth=0.0017, delay=0.075, fade=0.20, initial_phase=0.42)
reed = oscillator(frequency=glide * pitch.ratio, reset=0, sample_rate=$sample_rate,
    waveform=1, pulse_width=0.44, drift=0.00020)
body = resonance(source=reed, sample_rate=$sample_rate,
    cutoff=1450, resonance=0.42)
envelope = rounded_ar(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    attack=0.10, hold=$hold, release=$release)
out sample = $gain * envelope * tanh(0.84 * body.low + 0.18 * body.band)
