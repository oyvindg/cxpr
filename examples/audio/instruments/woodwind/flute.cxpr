# Concert flute with a soft breath onset, octave shimmer and gentle vibrato.
model flute(lifecycle = "scoped")

use rounded_ar from envelopes
use vibrato from effects
use portamento from effects

in age, frequency, trigger
$sample_rate = 44100
$hold = 0.82
$release = 0.18
$gain = 0.13
state phase = 0
note_age = trigger ? 0 : max(0, age)
phase_now = phase
glide = portamento(frequency=frequency, trigger=trigger,
    sample_rate=$sample_rate, seconds=0.050)
pitch = vibrato(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    rate=5.30, depth=0.0028, delay=0.055, fade=0.18, initial_phase=0.18)
tone = sin(2 * pi() * phase_now) + 0.13 * sin(4 * pi() * phase_now) +
    0.025 * sin(6 * pi() * phase_now)
breath = 0.018 * sin(2 * pi() * 11.7 * phase_now) * exp(-4.5 * note_age)
envelope = rounded_ar(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    attack=0.12, hold=$hold, release=$release)
phase := (phase_now + glide * pitch.ratio / $sample_rate) % 1
out sample = $gain * envelope * tanh(0.88 * tone + breath)
