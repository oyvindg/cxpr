# Low bassoon with a gentle reed buzz and dark conical-bore filtering.
model bassoon(lifecycle = "scoped")

use oscillator from oscillators
use resonance from mono.filters
use rounded_ar from envelopes
use vibrato from effects
use portamento from effects

in age, frequency, trigger
$sample_rate = 44100
$hold = 0.88
$release = 0.26
$gain = 0.15
note_age = trigger > 0 ? 0 : max(0, age)
glide = portamento(frequency=frequency, trigger=trigger,
    sample_rate=$sample_rate, seconds=0.030)
pitch = vibrato(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    rate=4.20, depth=0.0013, delay=0.11, fade=0.26, initial_phase=0.27)
reed = oscillator(frequency=glide * pitch.ratio, reset=0, sample_rate=$sample_rate,
    waveform=0, drift=0.00018)
body = resonance(mono=reed, sample_rate=$sample_rate,
    cutoff=920, resonance=0.24)
envelope = rounded_ar(age=note_age, trigger=trigger, sample_rate=$sample_rate,
    attack=0.15, hold=$hold, release=$release)
out sample = $gain * envelope * tanh(0.88 * body.low + 0.12 * body.band)
