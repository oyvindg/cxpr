model reverb(source_arg = "source", lifecycle = "scoped")

in source { sample }
$sample_rate = 44100
$mix = 0.20
$decay = 0.72

state short_room: buffer<number, samples = 2205>
state long_room: buffer<number, samples = 2867>

short_raw = short_room[max(0, floor(2205 * $sample_rate / 44100) - 1)]
long_raw = long_room[max(0, floor(2867 * $sample_rate / 44100) - 1)]
short_wet = isnan(short_raw) ? 0 : short_raw
long_wet = isnan(long_raw) ? 0 : long_raw
decay = clamp($decay, 0, 0.92)
mix = clamp($mix, 0, 1)
short_room := source.sample + decay * long_wet
long_room := 0.72 * source.sample + decay * short_wet

out { sample = (1 - mix) * source.sample + mix * 0.5 * (short_wet + long_wet) }
