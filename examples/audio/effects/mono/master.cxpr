model master(source_arg = "source", lifecycle = "scoped")

in source { sample }
in t
$sample_rate = 44100
$gain = 1
$duration = 4
$fade_seconds = 0.5
$ceiling = 0.90

state previous = 0
state filtered_memory = 0

coefficient = exp(-2 * pi() * 18 / $sample_rate)
filtered = source.sample - previous + coefficient * filtered_memory
previous := source.sample
filtered_memory := filtered
remaining = max(0, $duration - 1 / $sample_rate - t)
fade = pow(sin(pi() * clamp(remaining / max(0.001, $fade_seconds), 0, 1) / 2), 2)
ceiling = clamp($ceiling, 0.1, 0.99)

sample = fade * ceiling * tanh($gain * filtered / ceiling)
out { left = sample, right = sample }
