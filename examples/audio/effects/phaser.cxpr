# Fire modulerte allpassfiltre. Dry/wet-blandingen gir bevegelige hakk.
# Hvert kall trenger sin egen filtertilstand, derfor scoped.
model phaser(lifecycle = "scoped")

in source

$sample_rate = 44100
$rate = 0.17
$depth = 0.75
$mix = 0.35

state phase = 0
state input_one = 0
state output_one = 0
state input_two = 0
state output_two = 0
state input_three = 0
state output_three = 0
state input_four = 0
state output_four = 0

phase := (phase + $rate / $sample_rate) % 1
sweep = 700 * exp(1.1 * clamp($depth, 0, 1) * sin(2 * pi() * phase))

g1 = tan(pi() * clamp(sweep * 0.60, 30, $sample_rate * 0.40) / $sample_rate)
g2 = tan(pi() * clamp(sweep, 30, $sample_rate * 0.40) / $sample_rate)
g3 = tan(pi() * clamp(sweep * 1.65, 30, $sample_rate * 0.40) / $sample_rate)
g4 = tan(pi() * clamp(sweep * 2.70, 30, $sample_rate * 0.40) / $sample_rate)
a1 = (g1 - 1) / (g1 + 1)
a2 = (g2 - 1) / (g2 + 1)
a3 = (g3 - 1) / (g3 + 1)
a4 = (g4 - 1) / (g4 + 1)

stage_one = a1 * source + input_one - a1 * output_one
stage_two = a2 * stage_one + input_two - a2 * output_two
stage_three = a3 * stage_two + input_three - a3 * output_three
stage_four = a4 * stage_three + input_four - a4 * output_four

input_one := source
output_one := stage_one
input_two := stage_one
output_two := stage_two
input_three := stage_two
output_three := stage_three
input_four := stage_three
output_four := stage_four

wet = clamp($mix, 0, 1)
out sample = (1 - wet) * source + wet * stage_four
