# Small stereo chamber with four early reflections and a diffuse tail.
model chamber(lifecycle = "scoped")

in source_left, source_right
$sample_rate = 44100
$feedback = 0.30
assert $sample_rate == 44100 {
    description = "Chamber reflection buffers are tuned for 44100 Hz"
}
state left_early: buffer<number, samples = 1327>
state right_early: buffer<number, samples = 1559>
state left_tail: buffer<number, samples = 2381>
state right_tail: buffer<number, samples = 2749>
early_left_raw = left_early[1326]
early_right_raw = right_early[1558]
tail_left_raw = left_tail[2380]
tail_right_raw = right_tail[2748]
early_left = isnan(early_left_raw) ? 0 : early_left_raw
early_right = isnan(early_right_raw) ? 0 : early_right_raw
tail_left = isnan(tail_left_raw) ? 0 : tail_left_raw
tail_right = isnan(tail_right_raw) ? 0 : tail_right_raw
feedback = clamp($feedback, 0, 0.42)
left_early := 0.42 * source_left + 0.16 * source_right + feedback * tail_right
right_early := 0.42 * source_right + 0.16 * source_left + feedback * tail_left
left_tail := early_left + 0.18 * tail_right
right_tail := early_right + 0.18 * tail_left
left = 0.58 * early_left + 0.42 * tail_left
right = 0.58 * early_right + 0.42 * tail_right

out {
    left, right
}
