# Generic scalar delay stage for `source |> delay(...).sample` composition.
model delay {
    lifecycle = "scoped"
    source_arg = "source"
}

in source

$sample_rate = 44100
$time = 0.25
$feedback = 0.30
$mix = 0.35

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Pipeline delay supports sample rates from 8000 through 44100 Hz"
}
assert $time >= 1 / $sample_rate and $time <= 1 {
    description = "Pipeline delay time must fit its one-second bounded buffer"
}

state line: buffer<number, samples = 44100>

index_125 = max(0, floor(0.125 * $sample_rate) - 1)
index_250 = max(0, floor(0.250 * $sample_rate) - 1)
index_500 = max(0, floor(0.500 * $sample_rate) - 1)
index_1000 = max(0, floor(1.000 * $sample_rate) - 1)
tap = $time < 0.1875 ? line[index_125] :
      $time < 0.3750 ? line[index_250] :
      $time < 0.7500 ? line[index_500] : line[index_1000]
wet = isnan(tap) ? 0 : tap
feedback = clamp($feedback, 0, 0.95)
mix = clamp($mix, 0, 1)

line := source + feedback * wet

sample = (1 - mix) * source + mix * wet

out sample
