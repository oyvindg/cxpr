# Compact scalar room stage. The physical delay lengths are generic
# bounded state; `mix` is ordinary model policy rather than native audio logic.
model reverb {
    lifecycle = "scoped"
    pipe = "source"
}

in source

$sample_rate = 44100
$mix = 0.20
$decay = 0.72

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Pipeline reverb supports sample rates from 8000 through 44100 Hz"
}

state short_room: buffer<number, samples = 2205>
state long_room: buffer<number, samples = 2867>

left_index = max(0, floor(2205 * $sample_rate / 44100) - 1)
right_index = max(0, floor(2867 * $sample_rate / 44100) - 1)
short_raw = short_room[left_index]
long_raw = long_room[right_index]
short_wet = isnan(short_raw) ? 0 : short_raw
long_wet = isnan(long_raw) ? 0 : long_raw
decay = clamp($decay, 0, 0.92)
mix = clamp($mix, 0, 1)

short_room := source + decay * long_wet
long_room := 0.72 * source + decay * short_wet

sample = (1 - mix) * source + mix * 0.5 * (short_wet + long_wet)

out sample
