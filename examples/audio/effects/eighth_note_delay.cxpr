# Shared cross-feedback eighth-note delay at 120 BPM and 44.1 kHz.
model eighth_note_delay(lifecycle = "scoped")

in source_left, source_right
$sample_rate = 44100
$feedback = 0.32
$tone = 3200

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Delay buffers support sample rates from 8000 through 44100 Hz"
}

state left_memory: buffer<number, samples = 11025>
state right_memory: buffer<number, samples = 11025>
state left_tone = 0
state right_tone = 0

delay_index = max(0, floor(11025 * $sample_rate / 44100) - 1)
left_tap = left_memory[delay_index]
right_tap = right_memory[delay_index]
left_delayed = isnan(left_tap) ? 0 : left_tap
right_delayed = isnan(right_tap) ? 0 : right_tap
coefficient = 1 - exp(-2 * pi() * clamp($tone, 100, $sample_rate * 0.45) / $sample_rate)
left_filtered = left_tone + coefficient * (left_delayed - left_tone)
right_filtered = right_tone + coefficient * (right_delayed - right_tone)
feedback = clamp($feedback, 0, 0.85)

left_tone := left_filtered
right_tone := right_filtered
left_memory := source_left + feedback * right_filtered
right_memory := source_right + feedback * left_filtered

out {
    left = left_filtered,
    right = right_filtered
}

