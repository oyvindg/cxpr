# Sample-continuous exponential pitch glide between note targets.
model portamento(lifecycle = "scoped")

in frequency, trigger
$sample_rate = 44100
$seconds = 0.035

state current_frequency = 0
target = max(0.01, frequency)
coefficient = 1 - exp(-4.6 / (max(0.001, $seconds) * $sample_rate))
next_frequency = current_frequency <= 0 ? target :
    current_frequency + coefficient * (target - current_frequency)
current_frequency := next_frequency

out value = next_frequency
