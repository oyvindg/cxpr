model song(type = "dsp")

use delay, reverb, gain from effects/pipeline
use master from effects

in t
$sample_rate = 44100

step = floor(t * 4) % 8
frequency = step < 2 ? 220 : step < 4 ? 277.1826 :
            step < 6 ? 329.6276 : 440
gate_phase = (t * 4) % 1
envelope = pow(max(0, 1 - gate_phase), 3)
voice = envelope * (0.28 * sin(2 * pi() * frequency * t) +
                    0.08 * sin(2 * pi() * frequency * 2 * t))
movement = 0.35 * sin(2 * pi() * 0.17 * t)
stereo = {
    left = voice * (1 - movement),
    right = voice * (1 + movement)
}

# Pipe injection works through producer-field access: every `.sample` selects
# the child-model output that becomes argument zero for the following stage.
processed_left = stereo.left
    |> delay(sample_rate=$sample_rate, time=0.25, feedback=0.30, mix=0.38).sample
    |> reverb(sample_rate=$sample_rate, mix=0.20, decay=0.70).sample
    |> gain(level=0.80).sample
processed_right = stereo.right
    |> delay(sample_rate=$sample_rate, time=0.25, feedback=0.30, mix=0.38).sample
    |> reverb(sample_rate=$sample_rate, mix=0.20, decay=0.70).sample
    |> gain(level=0.80).sample

finished = master(source_left=processed_left, source_right=processed_right,
                  t=t, sample_rate=$sample_rate, gain=1.4,
                  duration=4, fade_seconds=0.5, ceiling=0.90)
left = finished.left
right = finished.right
duration = 4

out { left, right, duration }
