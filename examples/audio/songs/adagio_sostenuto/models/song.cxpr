// Complete first movement rendered by twelve overlapping grand-piano voices.
model song(type = "dsp")

use sequencer from arrangement
use grand_piano from instruments/classical
use pan, chamber, reverb, master from effects
use resonance from filters

in t
$sample_rate = 44100
$bpm = 54

seq = sequencer(t=t, bpm=$bpm)
// One static map owns the independent piano and pan state for every named voice.
stereo_voices = map(seq.voices, voice => {
    piano = grand_piano(
        age=voice.age,
        frequency=voice.frequency,
        trigger=voice.trigger,
        sample_rate=$sample_rate,
        gain=0.10 * voice.gain,
        delay_samples=floor($sample_rate / voice.frequency));
    return pan(source=piano, position=voice.pan);
})
raw_left = sum(stereo_voices, voice => voice.left)
raw_right = sum(stereo_voices, voice => voice.right)
// A gentle post-sum low-pass removes brittle modal energy without narrowing stereo.
left_tone = resonance(source=raw_left, sample_rate=$sample_rate,
    cutoff=4600, resonance=0.025)
right_tone = resonance(source=raw_right, sample_rate=$sample_rate,
    cutoff=4600, resonance=0.025)
dry_left = left_tone.low
dry_right = right_tone.low

// Close asymmetric reflections preserve the keyboard width and place the
// listener at the bench; the softer hall return sits behind that near field.
near_room = chamber(source_left=0.52 * dry_left, source_right=0.52 * dry_right,
    sample_rate=$sample_rate, feedback=0.20)
// The hall is a quiet send fed by both direct piano and early reflections.
hall = reverb(source_left=0.18 * dry_left + 0.10 * near_room.left,
    source_right=0.18 * dry_right + 0.10 * near_room.right,
    sample_rate=$sample_rate, decay_seconds=2.2, damping=2000)
// Keep the pianist-position direct signal dominant over both wet returns.
finished = master(source_left=dry_left + 0.22 * near_room.left + 0.16 * hall.left,
    source_right=dry_right + 0.22 * near_room.right + 0.16 * hall.right,
    t=t, sample_rate=$sample_rate, gain=1.45, duration=seq.duration,
    // The seven-second fade begins at the final bass event and reaches zero.
    fade_seconds=7.0, fade_in_seconds=0.35, ceiling=0.90)

left = finished.left
right = finished.right
duration = seq.duration

out {
    left, right, duration
}
