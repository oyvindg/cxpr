// Eight-bar big-beat arrangement at 118 BPM with deterministic break variations.
model sequencer(type = "sequencer", lifecycle = "scoped")

use lane from sequencing

in t
$bpm = 118

fn hz(note) = 440 * pow(2, (note - 69) / 12)

beat_seconds = 60 / $bpm
step_seconds = beat_seconds / 4
raw_step = floor(max(0, t) / step_seconds)
step = min(raw_step, 127)
slot = step % 16
bar = floor(step / 16)
clock = lane(t=t, step=step, step_seconds=step_seconds, offset=0,
             enabled=raw_step <= 127)

kick_hit = contains(slot, [0, 3, 7, 10, 14]) or
    (bar % 4 == 3 and contains(slot, [12, 13, 15]))
snare_hit = contains(slot, [4, 12]) or
    (bar >= 2 and contains(slot, [11, 15]))
hat_hit = slot % 2 == 0 or contains(slot, [3, 7, 11, 15])
open_hat_hit = bar >= 1 and contains(slot, [6, 14])
kick_trigger = clock.trigger and kick_hit
snare_trigger = clock.trigger and snare_hit
hat_trigger = clock.trigger and hat_hit
open_hat_trigger = clock.trigger and open_hat_hit
kick_level = kick_hit ? (slot == 0 ? 1 : 0.78) : 0
snare_level = snare_hit ? (contains(slot, [4, 12]) ? 1 : 0.38) : 0
hat_level = hat_hit ? (slot % 4 == 2 ? 0.72 : 0.46) : 0
open_hat_level = open_hat_hit ? 0.62 : 0

riff_slot = step % 16
riff_phrase = bar % 4
riff_note_a = riff_slot < 3 ? 38 : riff_slot < 6 ? 41 :
    riff_slot < 8 ? 43 : riff_slot < 11 ? 38 :
    riff_slot < 14 ? 36 : 45
riff_note_b = riff_slot < 3 ? 38 : riff_slot < 6 ? 36 :
    riff_slot < 8 ? 41 : riff_slot < 11 ? 43 :
    riff_slot < 14 ? 38 : 34
riff_note = riff_phrase == 1 ? riff_note_b :
    riff_phrase == 3 and riff_slot >= 14 ? 34 : riff_note_a
riff_hit = contains(riff_slot, [0, 3, 6, 8, 11, 14]) or
    (riff_phrase == 3 and contains(riff_slot, [12, 13, 15]))
riff_trigger = clock.trigger and riff_hit
riff_gate_seconds = riff_phrase == 2 ? 0.24 :
    riff_phrase == 3 and riff_slot >= 12 ? 0.095 : 0.19
riff_gate = clock.age < riff_gate_seconds and riff_hit ? 1 : 0
riff_age = clock.age
riff_frequency = riff_note |> hz()
riff_level = riff_hit ? (riff_slot == 0 ? 1 :
    riff_phrase == 3 and riff_slot >= 12 ? 0.68 : 0.84) : 0

stab_hit = bar >= 2 and contains(slot, [2, 9, 15])
stab_trigger = clock.trigger and stab_hit
stab_gate = clock.age < 0.11 and stab_hit ? 1 : 0
stab_note = bar % 4 < 2 ? 62 : 60
stab_frequency = stab_note |> hz()

duration = 8 * 4 * beat_seconds + 3.0

out {
    kick_trigger, snare_trigger, hat_trigger, open_hat_trigger,
    kick_level, snare_level, hat_level, open_hat_level,
    riff_trigger, riff_gate, riff_age, riff_frequency, riff_level,
    stab_trigger, stab_gate, stab_frequency,
    bar, duration
}
