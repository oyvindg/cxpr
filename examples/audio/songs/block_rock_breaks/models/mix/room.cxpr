# Song-specific ambience bus for the break, percussion, and stabs.
model room(lifecycle = "scoped")

use chamber, gain, gated_reverb from stereo.effects
use mono from channels

in snare, clap, hats, stabs
$sample_rate = 44100

chamber_send = sum([
    snare |> gain(level=0.26),
    clap |> gain(level=0.18),
    hats |> gain(level=0.08),
    stabs |> gain(level=0.24)
])
chamber_return = chamber_send |>
    chamber(sample_rate=$sample_rate, feedback=0.26)

gate_source = sum([
    snare |> mono(gain=0.54),
    clap |> mono(gain=0.81)
])

gate_return = gated_reverb(mono=gate_source, sample_rate=$sample_rate,
    feedback=0.56, gate_seconds=0.23)

room_return = sum([
    chamber_return |> gain(level=0.28),
    gate_return |> gain(level=0.34)
])

left = room_return.left
right = room_return.right

out left, right
