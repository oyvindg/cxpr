model song(type = "dsp")

use sequencer from arrangement
use room, percussion from mix
use kick, snare, hat, clap, shaker, tom, crash from instruments.drum
use classic_dual_vco, hybrid_voice_stack from instruments.synth
use arp from instruments.retrowave
use oscillator from oscillators
use adsr from envelopes
use pitch_wet_to_dry from effects
use chorus, pan, dry_mix, ping_pong_delay, reverb, width_drive, master from stereo.effects

in t
$sample_rate = 44100
$bpm = 118

seq = sequencer(t=t, bpm=$bpm)
kick_voice = kick(trigger=seq.kick_trigger, sample_rate=$sample_rate,
                  gain=0.74)
snare_voice = snare(trigger=seq.snare_trigger, sample_rate=$sample_rate,
                    seed=29417, gain=0.54)
closed_hat = hat(trigger=seq.hat_trigger, sample_rate=$sample_rate,
                 seed=17681, decay=62, gain=0.21)
open_hat = hat(trigger=seq.open_hat_trigger, sample_rate=$sample_rate,
               seed=35671, decay=17, gain=0.18)
clap_voice = clap(trigger=seq.snare_trigger, sample_rate=$sample_rate,
                  seed=37357, gain=0.24)
shaker_voice = shaker(trigger=seq.hat_trigger, sample_rate=$sample_rate,
                      seed=55109, gain=0.12)
tom_voice = tom(trigger=seq.tom_trigger, sample_rate=$sample_rate,
                frequency=seq.tom_frequency, gain=0.46)
crash_voice = crash(trigger=seq.crash_trigger, sample_rate=$sample_rate,
                    seed=61409, gain=0.18)

pitch_motion = pitch_wet_to_dry(age=seq.riff_age, trigger=seq.riff_trigger,
    sample_rate=$sample_rate, rate=7.2, depth=0.022, bend=0.032,
    hold=0.008, fade=0.085)
acid_motion = 0.5 + 0.5 * sin(2 * pi() * ($bpm / 60 / 8) * t)
riff = classic_dual_vco(frequency=seq.riff_frequency * pitch_motion.ratio,
    gate=seq.riff_gate,
    trigger=seq.riff_trigger, sample_rate=$sample_rate,
    cutoff_base=110 + 80 * acid_motion,
    cutoff_envelope=2450 + 750 * acid_motion,
    resonance=0.57 + 0.07 * acid_motion,
    drive=2.18, sub_mix=0.20, unison_spread=0.0038, unison_mix=0.28,
    reset_phase=0,
    attack=0.003, decay=0.095,
    sustain=0.28, release=0.022)
sub_oscillator = oscillator(frequency=seq.riff_frequency,
    reset=0, sample_rate=$sample_rate, waveform=2)
sub_envelope = adsr(gate=seq.riff_gate, trigger=seq.riff_trigger,
    sample_rate=$sample_rate, attack=0.002, decay=0.075,
    sustain=0.54, release=0.018)
sub_bass = 0.25 * seq.riff_level * sub_envelope.value * sub_oscillator.sample
stab = hybrid_voice_stack(frequency=seq.stab_frequency, gate=seq.stab_gate,
    trigger=seq.stab_trigger, sample_rate=$sample_rate,
    spread=0.0068, pulse_width=0.41, pwm_rate=0.27, pwm_depth=0.038,
    sub_mix=0.04, octave_mix=0.20,
    cutoff_base=460, cutoff_envelope=4300, resonance=0.46,
    drive=1.72, attack=0.006, decay=0.14, sustain=0.18, release=0.17)
arp_voice = arp(age=seq.arp_age, frequency=seq.arp_frequency,
    trigger=seq.arp_trigger, sample_rate=$sample_rate, gain=0.12)

pump = 1 - 0.42 * seq.kick_level * exp(-24 * (t % (60 / $bpm / 4)))
kick_bus = pan(mono=0.92 * seq.kick_level * kick_voice.sample, position=0)
snare_bus = pan(mono=0.76 * seq.snare_level * snare_voice.sample,
                position=-0.12)
clap_bus = pan(mono=0.34 * seq.snare_level * clap_voice.sample,
               position=0.32)
hat_bus = pan(mono=seq.hat_level * closed_hat.sample +
              seq.open_hat_level * open_hat.sample,
              position=0.34 + 0.10 * sin(2 * pi() * 0.23 * t))
shaker_bus = pan(mono=0.30 * seq.hat_level * shaker_voice.sample,
                 position=0.66)
tom_bus = pan(mono=seq.tom_level * tom_voice.sample,
              position=-0.56 + 1.12 * (seq.tom_frequency - 104) / 52)
crash_bus = pan(mono=crash_voice.sample, position=-0.24)
riff_bus = pan(mono=pump * seq.riff_level *
    (0.78 * riff.sample + sub_bass), position=-0.12)
arp_position = 0.76 * sin(2 * pi() * ($bpm / 60 / 16) * t)
arp_bus = pan(mono=pump * seq.arp_level * arp_voice.sample,
              position=arp_position)
stab_width = chorus(source=0.34 * pump * stab.sample,
                    sample_rate=$sample_rate, rate=0.14, depth=0.24, mix=0.14)
stab_bus = {
    left = 0.72 * stab_width.left,
    right = stab_width.right
}
percussion_bus = percussion(hats=hat_bus, shaker=shaker_bus,
    snare=snare_bus, clap=clap_bus, toms=tom_bus, crash=crash_bus)
stabs_mix = {
    left = stab_bus.left + 0.72 * arp_bus.left,
    right = stab_bus.right + 0.72 * arp_bus.right
}
room_bus = room(snare=snare_bus, clap=clap_bus, hats=hat_bus,
                stabs=stab_bus, sample_rate=$sample_rate)
stereo = kick_bus
    |> dry_mix(percussion=percussion_bus, riff=riff_bus, stabs=stabs_mix,
               room=room_bus)
    |> ping_pong_delay(sample_rate=$sample_rate, time=0.25, feedback=0.42, mix=0.24)
    |> reverb(sample_rate=$sample_rate, mix=0.075, decay=0.61)
    |> width_drive(width=1.20, drive=1.26, level=0.86)
    |> master(t=t, sample_rate=$sample_rate, gain=1.48,
              duration=seq.duration, fade_seconds=1.8,
              fade_in_seconds=0.025, ceiling=0.90)
duration = seq.duration

out stereo, duration
