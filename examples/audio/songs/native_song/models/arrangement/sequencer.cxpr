# Kretsløp: hele arrangementet ligger her. Ingen noteplan leveres av hosten.
# 16 takter, D-moll, 108 BPM. Alle aldre og hold/release er sekunder.
model sequencer(type = "sequencer", lifecycle = "scoped")

use lane from sequencing

in t
$bpm = 108

fn hz(note) = 440 * pow(2, (note - 69) / 12)

# 0 Dm7, 1 Bbmaj7, 2 Fmaj7, 3 Cadd9, 4 Gm7, 5 A7, 6 Dm.
fn chord_at(bar) = bar < 12 ? bar % 4 : bar == 12 ? 4 : bar == 13 ? 5 : bar == 14 ? 0 : 6
fn root_note(chord) = chord == 1 ? 34 : chord == 2 ? 41 : chord == 3 ? 36 : chord == 4 ? 43 : chord == 5 ? 45 : 38

fn chord_note(chord, voice) {
    first = chord == 1 ? 46 : chord == 2 ? 48 : chord == 3 ? 48 : chord == 4 ? 55 : chord == 5 ? 57 : 50
    second = chord == 1 ? 53 : chord == 2 ? 53 : chord == 3 ? 55 : chord == 4 ? 58 : chord == 5 ? 61 : 57
    third = chord == 1 ? 57 : chord == 2 ? 57 : chord == 3 ? 62 : chord == 4 ? 62 : chord == 5 ? 64 : chord == 6 ? 62 : 60
    fourth = chord == 1 ? 62 : chord == 2 ? 64 : chord == 3 ? 64 : chord == 4 ? 65 : chord == 5 ? 67 : 65
    return voice == 0 ? first : voice == 1 ? second : voice == 2 ? third : fourth
}

fn melody_note(bar, slot) {
    chord = chord_at(bar)
    first = chord == 1 ? 74 : chord == 2 ? 72 : chord == 3 ? 79 : chord == 4 ? 74 : chord == 5 ? 73 : bar == 14 ? 81 : bar == 15 ? 77 : 74
    second = chord == 1 ? 77 : chord == 2 ? 76 : chord == 3 ? 76 : chord == 4 ? 77 : chord == 5 ? 76 : bar == 15 ? 76 : 77
    third = chord == 1 ? 72 : chord == 2 ? 77 : chord == 3 ? 74 : chord == 4 ? 79 : chord == 5 ? 79 : bar == 14 ? 76 : bar == 15 ? 74 : 81
    fourth = chord == 1 ? 69 : chord == 2 ? 81 : chord == 3 ? 72 : chord == 4 ? 77 : chord == 5 ? 81 : bar >= 14 ? 74 : 79
    return slot == 0 ? first : slot == 1 ? second : slot == 2 ? third : fourth
}

beat_seconds = 60 / $bpm
bar_seconds = 4 * beat_seconds
beat = max(0, t) / beat_seconds
bar = floor(beat / 4)
music_bar = min(bar, 15)

# To banker lar forrige akkord ringe ferdig under den neste.
bank_a = min(2 * floor(bar / 2), 14)
bank_b = min(2 * floor((bar - 1) / 2) + 1, 15)
chord_a = chord_at(bank_a)
chord_b = chord_at(max(0, bank_b))
a_lane = lane(t=t, step=bank_a, step_seconds=bar_seconds, offset=0, enabled=true)
b_lane = lane(t=t, step=bank_b, step_seconds=bar_seconds, offset=0, enabled=bank_b >= 0)

a_age = a_lane.age
a_trigger = a_lane.trigger
a_one = chord_note(chord_a, 0) |> hz()
a_two = chord_note(chord_a, 1) |> hz()
a_three = chord_note(chord_a, 2) |> hz()
a_four = chord_note(chord_a, 3) |> hz()
a_hold = bar_seconds - 0.2
a_release = 0.55
a_level = 1

b_age = b_lane.age
b_trigger = b_lane.trigger
b_one = chord_note(chord_b, 0) |> hz()
b_two = chord_note(chord_b, 1) |> hz()
b_three = chord_note(chord_b, 2) |> hz()
b_four = chord_note(chord_b, 3) |> hz()
b_hold = bank_b == 15 ? bar_seconds + 0.2 : bar_seconds - 0.2
b_release = bank_b == 15 ? 1.4 : 0.55
b_level = bank_b >= 0 ? 1 : 0

# Synkopert bass, med en holdt grunntone i siste takt.
bass_step = min(floor(beat * 2), 120)
bass_slot = bass_step % 8
bass_bar = floor(bass_step / 8)
bass_root = root_note(chord_at(bass_bar))
bass_offset = bass_bar == 15 ? 0 : bass_slot == 3 or bass_slot == 7 ? 7 : bass_slot == 4 ? 12 : 0
bass_lane = lane(t=t, step=bass_step, step_seconds=beat_seconds / 2, offset=0, enabled=true)
bass_age = bass_lane.age
bass_trigger = bass_lane.trigger
bass_frequency = bass_root + bass_offset |> hz()
bass_hold = bass_bar == 15 ? 1.75 : 0.19
bass_release = bass_bar == 15 ? 0.45 : 0.085
bass_level = bass_bar == 15 ? 0.92 : bass_slot == 1 or bass_slot == 5 ? 0 : bass_slot == 0 ? 1 : bass_slot == 4 ? 0.82 : 0.68

# Melodien spiller firedeler og ender med F-E-D, der D får lengre hale.
lead_step = min(floor(beat), 62)
lead_slot = lead_step % 4
lead_bar = floor(lead_step / 4)
lead_lane = lane(t=t, step=lead_step, step_seconds=beat_seconds, offset=0, enabled=true)
lead_age = lead_lane.age
lead_trigger = lead_lane.trigger
lead_frequency = melody_note(lead_bar, lead_slot) |> hz()
lead_hold = lead_step == 62 ? 0.9 : 0.20
lead_release = lead_step == 62 ? 0.75 : 0.28
lead_level =
    lead_bar == 0 ? (lead_slot >= 2 ? 0.72 : 0) :
    lead_bar == 1 ? (lead_slot % 2 == 1 ? 0.72 : 0) :
    lead_bar < 4 ? 0.78 : lead_slot % 2 == 0 ? 1 : 0.86

# Kick på slag 1 og 3; siste takt har bare én kick.
kick_step = min(floor(beat / 2), 30)
kick_lane = lane(t=t, step=kick_step, step_seconds=2 * beat_seconds, offset=0, enabled=true)
kick_age = kick_lane.age
kick_trigger = kick_lane.trigger
kick_level = kick_step % 2 == 0 ? 1 : 0.88

# Skarptrommen kommer inn etter to takter, på slag 2 og 4.
snare_step = min(floor((beat - 1) / 2), 30)
snare_lane = lane(t=t, step=snare_step, step_seconds=2 * beat_seconds, offset=0.5, enabled=snare_step >= 0)
snare_age = snare_lane.age
snare_trigger = snare_lane.trigger
snare_level = snare_step < 4 ? 0 : snare_step % 2 == 0 ? 0.90 : 1
snare_seed = snare_step % 2 == 0 ? 24681 : 27183

# Hi-hat: firedeler i intro, deretter aksent på åttendelsmellomslag.
hat_step = min(floor(beat * 2), 123)
hat_slot = hat_step % 8
hat_bar = floor(hat_step / 8)
hat_lane = lane(t=t, step=hat_step, step_seconds=beat_seconds / 2, offset=0, enabled=true)
hat_age = hat_lane.age
hat_trigger = hat_lane.trigger
hat_level = hat_bar < 2 ? (hat_slot % 2 == 0 ? 0.48 : 0) : hat_slot % 2 == 0 ? 0.56 : 0.92
hat_seed = hat_slot % 4 == 0 ? 12345 : hat_slot % 4 == 1 ? 13579 : hat_slot % 4 == 2 ? 15401 : 19001

intensity = music_bar < 4 ? 0.55 : music_bar < 12 ? 0.85 : 1
duration = 16 * bar_seconds + 4.5

out {
    a_age, a_trigger, a_one, a_two,
    a_three, a_four, a_hold, a_release,
    a_level, b_age, b_trigger, b_one,
    b_two, b_three, b_four, b_hold,
    b_release, b_level, bass_age, bass_trigger,
    bass_frequency, bass_hold, bass_release, bass_level,
    lead_age, lead_trigger, lead_frequency, lead_hold,
    lead_release, lead_level, kick_age, kick_trigger,
    kick_level, snare_age, snare_trigger, snare_level,
    snare_seed, hat_age, hat_trigger, hat_level,
    hat_seed, intensity, duration
}
