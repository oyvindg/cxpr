# Sixteen-bar A-Aeolian retrowave arrangement at 110 BPM.
model sequencer(type = "sequencer", lifecycle = "scoped")

use lane from sequencing

in t
$bpm = 110
$sample_rate = 44100

state held_transition_frequency = 165
state held_transition_pan = -0.58
state held_transition_low_frequency = 135
state held_transition_low_pan = 0.62
state held_transition_main_age = 10
state held_transition_low_age = 10
state held_lead_frequency = 440
state held_lead_level = 0
state held_lead_brightness = 0
state held_lead_duration = 0
state held_lead_age = 10
state held_bass_frequency = 55
state held_bass_level = 0
state held_bass_age = 10

# Convert MIDI note numbers to equal-tempered Hertz at the final arrangement
# boundary; instrument modules receive frequencies and remain scale-agnostic.
fn hz(note) = 440 * pow(2, (note - 69) / 12)
# The selected i-VII-VI-VII cadence repeats every four bars.
fn progression(bar) = bar % 4
fn root_note(chord) = chord == 0 ? 33 : chord == 1 ? 31 : chord == 2 ? 29 : 31
fn chord_note(chord, voice) {
    first = chord == 0 ? 57 : chord == 1 ? 55 : chord == 2 ? 53 : 55
    second = chord == 0 ? 60 : chord == 1 ? 59 : chord == 2 ? 57 : 59
    third = chord == 0 ? 64 : chord == 1 ? 62 : chord == 2 ? 60 : 62
    fourth = chord == 0 ? 69 : chord == 1 ? 67 : chord == 2 ? 65 : 67
    return voice == 0 ? first : voice == 1 ? second : voice == 2 ? third : fourth
}

beat_seconds = 60 / $bpm
eighth_seconds = beat_seconds / 2
sixteenth_seconds = beat_seconds / 4
bar_seconds = 4 * beat_seconds
beat = max(0, t) / beat_seconds
bar = min(floor(beat / 4), 15)
chord = progression(bar)

chord_lane = lane(t=t, step=bar, step_seconds=bar_seconds, offset=0, enabled=true)
chord_trigger = chord_lane.trigger
chord_age = chord_lane.age
chord_one = chord_note(chord, 0) |> hz()
chord_two = chord_note(chord, 1) |> hz()
chord_three = chord_note(chord, 2) |> hz()
chord_four = chord_note(chord, 3) |> hz()
chord_hold = bar_seconds - 0.20
chord_release = 0.38

# Kick, snare, hats, fills, and lead phrase boundaries share this exact
# unswung 1/8 grid. Bass adds a derived 1/16 grid only during the bridge.
eighth_step = min(floor(beat * 2), 127)
eighth_slot = eighth_step % 8
eighth_bar = floor(eighth_step / 8)
rhythm_lane = lane(t=t, step=eighth_step, step_seconds=eighth_seconds, offset=0, enabled=true)
rhythm_trigger = rhythm_lane.trigger
rhythm_age = rhythm_lane.age
kick_level = eighth_slot % 2 == 0 ? 0.8661417323 : 0
kick_trigger = rhythm_trigger * (eighth_slot % 2 == 0 ? 1 : 0)
# During the bridge, the rhythm section keeps its clock but the snare leaves an
# eight-beat gap between hits. Normal beat-two/four backbeats resume afterward.
snare_bridge = bar >= 8 and bar < 12
snare_hit = snare_bridge ? (bar % 2 == 1 and eighth_slot == 6) :
    (eighth_slot == 2 or eighth_slot == 6)
snare_level = snare_hit ? 0.8661417323 : 0
snare_trigger = rhythm_trigger * (snare_hit ? 1 : 0)
hat_level = 0.8661417323
# Three sequential double-strokes occupy the final six sixteenths: dd dd dd.
# Each shell owns a lane, and held pitch/pan values keep its decaying tail
# stable while the opposite shell plays the second stroke of each pair.
transition_step = min(floor(beat * 4), 255)
transition_slot = transition_step % 16
transition_section = bar % 4 == 3 and bar < 15 and transition_slot >= 10
transition_pair = floor((transition_slot - 10) / 2)
transition_main_active = transition_section and transition_slot % 2 == 0
transition_low_active = transition_section and transition_slot % 2 == 1
transition_main_lane = lane(t=t, step=transition_step,
                            step_seconds=sixteenth_seconds, offset=0,
                            enabled=transition_main_active)
transition_low_lane = lane(t=t, step=transition_step,
                           step_seconds=sixteenth_seconds, offset=0,
                           enabled=transition_low_active)
transition_target_frequency = transition_pair == 0 ? 165 :
    transition_pair == 1 ? 135 : 108
transition_target_pan = transition_pair == 0 ? -0.58 :
    transition_pair == 1 ? 0 : 0.58
transition_low_target_frequency = 0.82 * transition_target_frequency
transition_low_target_pan = transition_pair == 0 ? 0.62 :
    transition_pair == 1 ? 0.20 : -0.48
next_transition_frequency = transition_main_lane.trigger > 0 ?
    transition_target_frequency : held_transition_frequency
next_transition_pan = transition_main_lane.trigger > 0 ?
    transition_target_pan : held_transition_pan
next_transition_low_frequency = transition_low_lane.trigger > 0 ?
    transition_low_target_frequency : held_transition_low_frequency
next_transition_low_pan = transition_low_lane.trigger > 0 ?
    transition_low_target_pan : held_transition_low_pan
next_transition_main_age = transition_main_lane.trigger > 0 ? 0 :
    held_transition_main_age + 1 / $sample_rate
next_transition_low_age = transition_low_lane.trigger > 0 ? 0 :
    held_transition_low_age + 1 / $sample_rate
held_transition_frequency := next_transition_frequency
held_transition_pan := next_transition_pan
held_transition_low_frequency := next_transition_low_frequency
held_transition_low_pan := next_transition_low_pan
held_transition_main_age := next_transition_main_age
held_transition_low_age := next_transition_low_age

# The bridge (bars 9-12) opens each bar with four sixteenth-note root pulses,
# then drops back into the regular eighth-note ostinato.
bass_sixteenth_step = min(floor(beat * 4), 255)
bass_sixteenth_slot = bass_sixteenth_step % 16
bass_bar = floor(bass_sixteenth_step / 16)
bass_bridge = bass_bar >= 8 and bass_bar < 12
bass_enabled = bass_bridge and bass_sixteenth_slot < 4 ? true :
    bass_sixteenth_slot % 2 == 0
bass_lane = lane(t=t, step=bass_sixteenth_step,
                 step_seconds=sixteenth_seconds, offset=0,
                 enabled=bass_enabled)
bass_trigger = bass_lane.trigger
bass_eighth_slot = floor(bass_sixteenth_slot / 2)
bass_note = root_note(progression(bass_bar)) +
    (bass_bridge and bass_sixteenth_slot < 4 ? 0 :
        bass_eighth_slot == 3 ? 7 : bass_eighth_slot == 6 ? 12 : 0)
bass_target_frequency = bass_note |> hz()
bass_target_level = bass_bridge and bass_sixteenth_slot < 4 ?
    0.72 : 0.8661417323
# Hold controls between triggers so an internal envelope can finish naturally;
# grid-disabled sixteenths must not zero a still-audible bass tail.
next_bass_frequency = bass_trigger > 0 ?
    bass_target_frequency : held_bass_frequency
next_bass_level = bass_trigger > 0 ? bass_target_level : held_bass_level
next_bass_age = bass_trigger > 0 ? 0 : held_bass_age + 1 / $sample_rate
held_bass_frequency := next_bass_frequency
held_bass_level := next_bass_level
held_bass_age := next_bass_age
bass_frequency = next_bass_frequency
bass_level = next_bass_level
bass_age = next_bass_age
drum_seed = 1986 + eighth_step * 17

# Four bars of rhythm establish the groove before this melody lane is enabled.
# Enabled boundaries alone retrigger the voice, so rests remain true silence.
lead_step = eighth_step
lead_slot = eighth_slot
lead_phrase_note = chord == 0 ?
    (lead_slot == 0 or lead_slot == 3 or lead_slot == 4 or lead_slot == 6) :
    chord == 1 ? (lead_slot == 0 or lead_slot == 2 or lead_slot == 4 or
        lead_slot == 7) :
    (lead_slot == 0 or lead_slot == 2 or lead_slot == 4 or lead_slot == 6)
# Reserve the full synth-release window after each gate. New notes that land
# inside it are skipped instead of retriggering a still-audible tail.
lead_release_guard = 0.90
lead_is_holding = held_lead_age < held_lead_duration + lead_release_guard
lead_active = bar >= 4 and lead_phrase_note and not lead_is_holding
lead_lane = lane(t=t, step=lead_step, step_seconds=eighth_seconds,
                 offset=0, enabled=lead_active)
lead_trigger = lead_lane.trigger
# Four-bar hook: the first half climbs through chord tones, while the second
# answers with a descending cadence and repeated syncopated placements.
lead_target_note = chord == 0 ?
    (lead_slot == 0 ? 69 : lead_slot == 3 ? 72 :
        lead_slot == 4 ? 76 : 74) :
    chord == 1 ? (lead_slot == 0 ? 67 : lead_slot == 2 ? 71 :
        lead_slot == 4 ? 74 : 76) :
    chord == 2 ? (lead_slot == 0 ? 69 : lead_slot == 2 ? 72 :
        lead_slot == 4 ? 76 : 72) :
    (lead_slot == 0 ? 67 : lead_slot == 2 ? 69 :
        lead_slot == 4 ? 71 : 74)
lead_target_frequency = lead_target_note |> hz()
lead_long_hold = bar % 8 == 4 and chord == 0 and lead_slot == 6
lead_target_duration_beats = lead_long_hold ? 2.25 : chord == 0 ?
    (lead_slot == 0 ? 1.25 : lead_slot == 3 ? 0.45 : 0.75) :
    chord == 1 ? (lead_slot == 4 ? 1.25 : lead_slot == 7 ? 0.45 : 0.75) :
    chord == 3 and lead_slot == 6 ? 1.25 : 0.75
lead_section_level = 0.82
# Strong downbeats, lighter passing notes, and a secondary beat-three accent
# create a shaped phrase rather than a flat sequence of equal notes.
lead_target_level = lead_section_level *
    (lead_slot == 0 ? 1 : lead_slot == 4 ? 0.92 : 0.80)
lead_target_brightness = lead_slot == 0 ? 1 : lead_slot == 4 ? 0.90 : 0.74
next_lead_frequency = lead_trigger > 0 ? lead_target_frequency : held_lead_frequency
next_lead_level = lead_trigger > 0 ? lead_target_level : held_lead_level
next_lead_brightness = lead_trigger > 0 ?
    lead_target_brightness : held_lead_brightness
next_lead_duration = lead_trigger > 0 ?
    lead_target_duration_beats * beat_seconds : held_lead_duration
next_lead_age = lead_trigger > 0 ? 0 : held_lead_age + 1 / $sample_rate
held_lead_frequency := next_lead_frequency
held_lead_level := next_lead_level
held_lead_brightness := next_lead_brightness
held_lead_duration := next_lead_duration
held_lead_age := next_lead_age
lead_gate = next_lead_age < next_lead_duration
lead_audible = next_lead_age < next_lead_duration + lead_release_guard
lead_frequency = next_lead_frequency
lead_age = next_lead_age
# Keep velocity stable after note-off; the synth ADSR owns the fade to silence.
# Zeroing this multiplier at a grid boundary would truncate an exponential tail.
lead_level = next_lead_level
lead_brightness = next_lead_brightness

# Sparse upper counter-line for the third, background lead voice.
background_step = min(floor(beat / 2), 31)
background_slot = background_step % 4
# The counter-lead only answers in gaps left by the main monophonic phrase.
background_active = bar >= 6 and not lead_audible
background_lane = lane(t=t, step=background_step,
                       step_seconds=2 * beat_seconds, offset=0,
                       enabled=background_active)
background_note_am = background_slot == 0 ? 69 :
    background_slot == 1 ? 72 : background_slot == 2 ? 76 : 72
background_note_g = background_slot == 0 ? 67 :
    background_slot == 1 ? 71 : background_slot == 2 ? 74 : 71
background_note_f = background_slot == 0 ? 65 :
    background_slot == 1 ? 69 : background_slot == 2 ? 72 : 69
background_note = chord == 0 ? background_note_am :
    chord == 2 ? background_note_f : background_note_g
background_frequency = background_note |> hz()
background_gate = background_active and background_lane.age < 0.60 * beat_seconds
background_level = bar >= 6 ? 0.65 : 0

# A restrained eighth-note arp lifts bars 7-8 and returns for bars 15-16. It
# stays out of both the rhythm intro and the busier sixteenth-note bass bridge.
arp_active = (bar >= 6 and bar < 8) or bar >= 14
arp_lane = lane(t=t, step=eighth_step, step_seconds=eighth_seconds,
                offset=0, enabled=arp_active)
arp_voice = eighth_slot < 4 ? eighth_slot : 6 - eighth_slot
arp_note = chord_note(chord, arp_voice) + 12
arp_frequency = arp_note |> hz()
arp_level = arp_active ? 1 : 0

# Arrangement bus automation uses half- to one-beat fades so section changes do
# not cut active tails. Bars 1-2 are percussion-only, bar 3 adds bass beneath
# the drums, pads and lead enter together in bar 5, and bars 13-14 expose the
# melodic buses without rhythm.
music_section_level = clamp((beat - 16) / 1, 0, 1)
late_drum_level = beat < 48 ? 1 : beat < 56 ?
    1 - clamp((beat - 48) / 0.5, 0, 1) :
    clamp((beat - 56) / 0.5, 0, 1)
drum_section_level = late_drum_level
bass_section_level = clamp((beat - 8) / 0.5, 0, 1) * late_drum_level

# Six seconds beyond the sixteenth bar preserve the longer diffuse reverb tail.
duration = 16 * bar_seconds + 6

out {
    beat_seconds, eighth_seconds, chord_trigger, chord_age,
    chord_one, chord_two, chord_three, chord_four, chord_hold, chord_release,
    rhythm_trigger, rhythm_age, kick_level, kick_trigger,
    snare_level, snare_trigger, hat_level, drum_seed,
    transition_main_trigger = transition_main_lane.trigger,
    transition_main_age = next_transition_main_age,
    transition_frequency = next_transition_frequency,
    transition_pan = next_transition_pan,
    transition_low_trigger = transition_low_lane.trigger,
    transition_low_age = next_transition_low_age,
    transition_low_frequency = next_transition_low_frequency,
    transition_low_pan = next_transition_low_pan,
    bass_trigger, bass_age, bass_frequency, bass_level,
    lead_trigger, lead_age, lead_duration = next_lead_duration,
    lead_frequency, lead_level, lead_brightness,
    lead_gate,
    background_trigger = background_lane.trigger,
    background_frequency, background_gate, background_level,
    arp_trigger = arp_lane.trigger, arp_age = arp_lane.age,
    arp_frequency, arp_level,
    music_section_level, drum_section_level, bass_section_level, duration
}
