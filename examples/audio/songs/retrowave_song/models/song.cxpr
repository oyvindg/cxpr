# Neon Drive: a complete eight-bar retrowave arrangement and DSP graph.
model song(type = "dsp")

use sequencer from arrangement
use bass, pad, arp, lead, drums, tom from instruments/retrowave
use chorus, gated_reverb, stereo_compressor, tape from effects
use pan, stereo_delay, reverb, master from effects

in t
$sample_rate = 44100
$bpm = 100
$master_gain = 1.45

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Audio buffers support sample rates from 8000 through 44100 Hz"
}

seq = sequencer(t=t, bpm=$bpm)

p1 = pad(age=seq.chord_age, frequency=seq.chord_one, trigger=seq.chord_trigger,
         sample_rate=$sample_rate, hold=seq.chord_hold, release=seq.chord_release)
p2 = pad(age=seq.chord_age, frequency=seq.chord_two, trigger=seq.chord_trigger,
         sample_rate=$sample_rate, hold=seq.chord_hold, release=seq.chord_release)
p3 = pad(age=seq.chord_age, frequency=seq.chord_three, trigger=seq.chord_trigger,
         sample_rate=$sample_rate, hold=seq.chord_hold, release=seq.chord_release)
p4 = pad(age=seq.chord_age, frequency=seq.chord_four, trigger=seq.chord_trigger,
         sample_rate=$sample_rate, hold=seq.chord_hold, release=seq.chord_release)
pad_mono = p1.sample + p2.sample + p3.sample + p4.sample
pad_stereo = chorus(source=pad_mono, sample_rate=$sample_rate, rate=0.21, depth=0.78, mix=0.48)

b = bass(age=seq.bass_age, frequency=seq.bass_frequency, trigger=seq.bass_trigger,
         sample_rate=$sample_rate)
a = arp(age=seq.arp_age, frequency=seq.arp_frequency, trigger=seq.arp_trigger,
        sample_rate=$sample_rate)
l = lead(age=seq.lead_age, frequency=seq.lead_frequency, trigger=seq.lead_trigger,
         sample_rate=$sample_rate)
d = drums(age=seq.drum_age, trigger=seq.drum_trigger, sample_rate=$sample_rate,
           seed=seq.drum_seed)
tom_voice = tom(age=seq.drum_age, frequency=seq.tom_frequency,
                trigger=seq.drum_trigger, sample_rate=$sample_rate)

arp_stereo = pan(source=seq.arp_level * a.sample, position=-0.24)
lead_stereo = pan(source=seq.lead_level * l.sample, position=0.18)
snare_bus = seq.snare_level * d.snare + seq.clap_level * d.clap
drum_center = seq.kick_level * d.kick + snare_bus + seq.tom_level * tom_voice.sample
hat_stereo = pan(source=seq.hat_level * d.hat + seq.open_hat_level * d.open_hat,
    position=0.28)
snare_gate = gated_reverb(source=snare_bus, sample_rate=$sample_rate,
    feedback=0.54, gate_seconds=0.22)
pump = 1 - 0.24 * seq.kick_level * exp(-11 * seq.drum_age)
center = 0.7071067811865476 * (pump * seq.bass_level * b.sample + drum_center)

dry_left = center + pump * pad_stereo.left + arp_stereo.left + lead_stereo.left + hat_stereo.left
dry_right = center + pump * pad_stereo.right + arp_stereo.right + lead_stereo.right + hat_stereo.right
echo = stereo_delay(
    source_left=0.42 * arp_stereo.left + 0.28 * lead_stereo.left,
    source_right=0.42 * arp_stereo.right + 0.28 * lead_stereo.right,
    sample_rate=$sample_rate, feedback=0.38, cutoff=3200)
room = reverb(
    source_left=0.16 * pad_stereo.left + 0.22 * lead_stereo.left + 0.16 * seq.snare_level * d.snare + 0.20 * echo.left,
    source_right=0.16 * pad_stereo.right + 0.22 * lead_stereo.right + 0.16 * seq.snare_level * d.snare + 0.20 * echo.right,
    sample_rate=$sample_rate, feedback=0.76, damping=3900)

compressed = stereo_compressor(
    source_left=dry_left + 0.82 * echo.left + 0.68 * room.left + 0.42 * snare_gate.left,
    source_right=dry_right + 0.82 * echo.right + 0.68 * room.right + 0.42 * snare_gate.right,
    sample_rate=$sample_rate, threshold=0.30, ratio=3.0,
    attack=0.012, release=0.16, makeup=1.08)
colored = tape(
    source_left=compressed.left,
    source_right=compressed.right,
    sample_rate=$sample_rate, drive=1.18, mix=0.72)
finished = master(
    source_left=colored.left,
    source_right=colored.right,
    t=t, sample_rate=$sample_rate, gain=$master_gain,
    duration=seq.duration, fade_seconds=1.2, ceiling=0.90)
left = finished.left
right = finished.right
duration = seq.duration

out {
    left, right, duration
}
