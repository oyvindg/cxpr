model song(type = "dsp")

use delay, reverb, gain, master from stereo.effects

in t
$sample_rate = 44100

step = floor(t * 4) % 8
frequency = step < 2 ? 220 : step < 4 ? 277.1826 :
            step < 6 ? 329.6276 : 440
gate_phase = (t * 4) % 1
envelope = pow(max(0, 1 - gate_phase), 3)
voice = envelope * (0.45 * sin(2 * pi() * frequency * t) +
                    0.12 * sin(2 * pi() * frequency * 2 * t))
movement = 0.35 * sin(2 * pi() * 0.17 * t)
spatial = {
    left = voice * (1 - movement),
    right = voice * (1 + movement)
}

# Rooted record piping binds both channels to each authored stage once.
stereo = spatial
    |> delay(sample_rate=$sample_rate, time=0.25, feedback=0.30, mix=0.38)
    |> reverb(sample_rate=$sample_rate, mix=0.20, decay=0.70)
    |> gain(level=0.80)
    |> master(t=t, sample_rate=$sample_rate, gain=2.2, duration=4, fade_seconds=0.5, ceiling=0.90)
duration = 4

out stereo, duration
