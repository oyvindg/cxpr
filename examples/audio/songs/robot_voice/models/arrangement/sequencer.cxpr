# Sentence timeline: "HELLO HUMAN, I AM ALIVE" after two seconds.
model sequencer(type = "sequencer")

in t

# One segment owns both membership and normalized local time, so word timing is
# declared once and cannot drift out of sync with phoneme motion.
fn phoneme_segment(x, a, b, id) {
    enabled = x >= a and x < b
    phase = clamp((x - a) / (b - a), 0, 1)
    return { enabled, phoneme = enabled ? id : 0, motion = enabled ? phase : 0 }
}

speech_time = t - 2.0
# HELLO's written double L is one sustained lateral, not two retriggers. Later
# segments use a shifted clock so their relative timing stays intact after the
# shorter EH and longer L articulation.

# HELLO / HH EH L OW /
hello_h = phoneme_segment(speech_time, 0.00, 0.05, 1)
hello_eh = phoneme_segment(speech_time, 0.05, 0.23, 2)
hello_l = phoneme_segment(speech_time, 0.23, 0.39, 3)
hello_ow = phoneme_segment((speech_time + 0.08), 0.47, 0.67, 4)

# HUMAN / HH Y UW M AH N /
human_h = phoneme_segment((speech_time + 0.13), 0.79, 0.89, 1)
human_y = phoneme_segment((speech_time + 0.13), 0.89, 1.01, 5)
human_uw = phoneme_segment((speech_time + 0.13), 1.01, 1.19, 6)
human_m = phoneme_segment((speech_time + 0.13), 1.19, 1.34, 7)
human_ah = phoneme_segment((speech_time + 0.13), 1.34, 1.48, 8)
human_n = phoneme_segment((speech_time + 0.13), 1.48, 1.62, 9)

# I AM / AY AE M /
i_ay = phoneme_segment((speech_time + 0.13), 1.80, 2.00, 10)
am_ae = phoneme_segment((speech_time + 0.13), 2.10, 2.29, 11)
am_m = phoneme_segment((speech_time + 0.13), 2.29, 2.43, 7)

# ALIVE / AH L AY V /
alive_ah = phoneme_segment((speech_time + 0.13), 2.57, 2.67, 8)
alive_l = phoneme_segment((speech_time + 0.13), 2.67, 2.79, 3)
alive_ay = phoneme_segment((speech_time + 0.13), 2.79, 3.05, 10)
alive_v = phoneme_segment((speech_time + 0.13), 3.05, 3.23, 21)

# Bounded max reductions select the active member of the four-segment ALIVE
# group. Other words keep the selector sum that scales well for the full list.
alive_phoneme = max([alive_ah, alive_l, alive_ay, alive_v], x => x.phoneme)
alive_motion = max([alive_ah, alive_l, alive_ay, alive_v], x => x.motion)
phoneme = sum([hello_h, hello_eh, hello_l, hello_ow,
    human_h, human_y, human_uw, human_m, human_ah, human_n,
    i_ay, am_ae, am_m], x => x.phoneme) + alive_phoneme
motion = sum([hello_h, hello_eh, hello_l, hello_ow,
    human_h, human_y, human_uw, human_m, human_ah, human_n,
    i_ay, am_ae, am_m], x => x.motion) + alive_motion

speaking = phoneme != 0
# Twelve percent of every segment crossfades its edges. A low floor preserves
# consonant identity while removing hard discontinuities between phonemes.
segment_edge = min(clamp(motion / 0.12, 0, 1),
    clamp((1 - motion) / 0.12, 0, 1))
alive_word = alive_ah.enabled or alive_l.enabled or
    alive_ay.enabled or alive_v.enabled
# H and EH share one onset envelope, so their boundary has no artificial dip.
hello_he = hello_h.enabled or hello_eh.enabled
hello_he_gate = clamp(speech_time / 0.035, 0, 1)
# Voiced ALIVE segments stay connected; other phonemes retain stronger edge
# articulation. The initial unstressed vowel is deliberately quieter.
alive_level = alive_ah.enabled ? 0.68 : alive_v.enabled ? 1.08 : 1
v_release = clamp((1 - motion) / 0.35, 0, 1)
base_gate = speaking ? hello_he ? hello_he_gate :
    alive_word ? alive_v.enabled ? alive_level * v_release :
    alive_level * (0.82 + 0.18 * segment_edge) :
    0.14 + 0.86 * segment_edge : 0
am_emphasis = am_ae.enabled or am_m.enabled
gate = am_emphasis ? 1.14 * base_gate : base_gate

# Subtle word-level prosody adds phrasing without losing the robotic delivery.
hello_word = sum([hello_h, hello_eh, hello_l, hello_ow],
    x => x.phoneme) > 0
human_word = sum([human_h, human_y, human_uw, human_m, human_ah, human_n],
    x => x.phoneme) > 0
i_word = i_ay.enabled
am_word = am_emphasis
hello_pitch_phase = clamp(speech_time / 0.62, 0, 1)
human_pitch_phase = clamp(((speech_time + 0.13) - 0.79) / 0.83, 0, 1)
ive_stress = alive_ay.enabled ? sin(pi() * alive_ay.motion) : 0
pitch = hello_word ? 94 - 2 * hello_pitch_phase :
    human_word ? 92 + 2 * sin(pi() * human_pitch_phase) :
    i_word ? 92 : am_word ? 94 :
    alive_ay.enabled ? 95 + 2 * ive_stress :
    alive_v.enabled ? 91 : alive_word ? 92 : 92
duration = 7.27

out {
    pitch, gate, phoneme, motion, duration
}
