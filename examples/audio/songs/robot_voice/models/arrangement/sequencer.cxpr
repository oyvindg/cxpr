# Recovered sentence timeline: "HELLO HUMAN, I AM ALIVE" after two seconds.
model sequencer(type = "sequencer")

in t

fn phoneme_segment(x, a, b, id) {
    enabled = x >= a and x < b
    phase = clamp((x - a) / (b - a), 0, 1)
    return { enabled, phoneme = enabled ? id : 0, motion = enabled ? phase : 0 }
}

speech_time = t - 2.0

# HELLO / HH EH L OW /
hello_h = phoneme_segment(speech_time, 0.00, 0.05, 1)
hello_eh = phoneme_segment(speech_time, 0.05, 0.23, 2)
hello_l = phoneme_segment(speech_time, 0.23, 0.39, 3)
hello_ow = phoneme_segment((speech_time + 0.08), 0.47, 0.67, 4)

# UMAN / UW M AH N / -- 70 ms after HELLO.
human_uw = phoneme_segment((speech_time + 0.13), 0.79, 1.02, 6)
human_m = phoneme_segment((speech_time + 0.13), 1.02, 1.14, 7)
human_ah = phoneme_segment((speech_time + 0.13), 1.14, 1.31, 8)
human_n = phoneme_segment((speech_time + 0.13), 1.31, 1.49, 9)

# I AM / AY AE M /
i_ay = phoneme_segment((speech_time + 0.13), 1.67, 1.87, 10)
am_ae = phoneme_segment((speech_time + 0.13), 1.94, 2.13, 11)
am_m = phoneme_segment((speech_time + 0.13), 2.13, 2.27, 7)

# ALIVE / AH L AY V /
alive_ah = phoneme_segment((speech_time + 0.13), 2.31, 2.41, 8)
alive_l = phoneme_segment((speech_time + 0.13), 2.41, 2.53, 3)
alive_ay = phoneme_segment((speech_time + 0.13), 2.53, 2.79, 10)
alive_v = phoneme_segment((speech_time + 0.13), 2.79, 2.97, 21)

phoneme = sum([hello_h, hello_eh, hello_l, hello_ow,
    human_uw, human_m, human_ah, human_n,
    i_ay, am_ae, am_m, alive_ah, alive_l, alive_ay, alive_v],
    x => x.phoneme)
motion = sum([hello_h, hello_eh, hello_l, hello_ow,
    human_uw, human_m, human_ah, human_n,
    i_ay, am_ae, am_m, alive_ah, alive_l, alive_ay, alive_v],
    (x) => x.motion)

speaking = phoneme != 0
segment_edge = min(clamp(motion / 0.12, 0, 1),
    clamp((1 - motion) / 0.12, 0, 1))
alive_word = alive_ah.enabled or alive_l.enabled or
    alive_ay.enabled or alive_v.enabled
hello_he = hello_h.enabled or hello_eh.enabled
hello_he_gate = clamp(speech_time / 0.035, 0, 1)
alive_level = alive_ah.enabled ? 0.68 : alive_v.enabled ? 1.08 : 1
v_release = clamp((1 - motion) / 0.35, 0, 1)
base_gate = speaking ? hello_he ? hello_he_gate :
    alive_word ? alive_v.enabled ? alive_level * v_release :
    alive_level * (0.82 + 0.18 * segment_edge) :
    0.14 + 0.86 * segment_edge : 0
am_emphasis = am_ae.enabled or am_m.enabled
gate = am_emphasis ? 1.14 * base_gate : base_gate

hello_word = sum([hello_h, hello_eh, hello_l, hello_ow],
    x => x.phoneme) > 0
human_word = sum([human_uw, human_m, human_ah, human_n],
    x => x.phoneme) > 0
i_word = i_ay.enabled
am_word = am_emphasis
hello_pitch_phase = clamp(speech_time / 0.62, 0, 1)
human_pitch_phase = clamp(((speech_time + 0.13) - 0.79) / 0.70, 0, 1)
ive_stress = alive_ay.enabled ? sin(pi() * alive_ay.motion) : 0
pitch = hello_word ? 94 - 2 * hello_pitch_phase :
    human_word ? 92 + 2 * sin(pi() * human_pitch_phase) :
    i_word ? 92 : am_word ? 94 :
    alive_ay.enabled ? 95 + 2 * ive_stress :
    alive_v.enabled ? 91 : alive_word ? 92 : 92
duration = 7.27

out { pitch, gate, phoneme, motion, duration }
