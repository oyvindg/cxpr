# Pure-CXPR robot voice: phoneme timeline -> formant voice -> room -> master.
model song(type = "dsp")

use sequencer from arrangement
use robot_voice from instruments/voice
use state_variable_filter from filters
use pan, phaser, reverb, master from effects

in t
$sample_rate = 44100

seq = sequencer(t=t)
voice = robot_voice(t=t, pitch=seq.pitch, gate=seq.gate,
    phoneme=seq.phoneme, motion=seq.motion, sample_rate=$sample_rate)

# Remove the synthetic top end before spatial processing. The low-pass remains
# high enough for H articulation, but rejects the brittle oscillator harmonics.
voice_tone = state_variable_filter(source=voice, sample_rate=$sample_rate,
    cutoff=2800, resonance=0.12, smoothing_seconds=0.020)

# Keep the dry voice centered so the words remain intelligible.
dry = pan(source=0.88 * voice_tone.low, position=0)
# The room return is deliberately more obvious than a production speech mix.
# Different phaser rates create width; a slow wet-only pan demonstrates motion
# without moving the centered dry voice.
room_send = seq.phoneme == 21 ? 0.14 : 0.36
room = reverb(source_left=room_send * dry.left,
    source_right=room_send * dry.right,
    sample_rate=$sample_rate, decay_seconds=2.20, damping=3600)
room_left = phaser(source=room.left, sample_rate=$sample_rate,
    rate=0.10, depth=0.62, mix=0.36)
room_right = phaser(source=room.right, sample_rate=$sample_rate,
    rate=0.19, depth=0.66, mix=0.36)
wide_left = pan(source=room_left, position=-0.78)
wide_right = pan(source=room_right, position=0.78)
room_motion = 0.82 * sin(2 * pi() * 0.12 * t)
moving_room = pan(source=0.5 * (room_left + room_right),
    position=room_motion)
space_left = wide_left.left + 0.28 * wide_right.left
space_right = wide_right.right + 0.28 * wide_left.right
finished = master(source_left=dry.left + 0.36 * room.left +
        0.42 * space_left + 0.28 * moving_room.left,
    source_right=dry.right + 0.36 * room.right +
        0.42 * space_right + 0.28 * moving_room.right,
    t=t, sample_rate=$sample_rate, gain=1.55, duration=seq.duration,
    fade_seconds=1.20, fade_in_seconds=0.08, ceiling=0.90)

left = finished.left
right = finished.right
duration = seq.duration

out left, right, duration

