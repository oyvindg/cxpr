# Vienna Morning: original Classical-era miniature symphony.
model song(type = "dsp")

use score from arrangement
use fortepiano_chord, pizzicato_section, violin_section, viola, cello, double_bass from instruments/classical
use flute, oboe, clarinet, bassoon from instruments/woodwind
use trumpet, trombone, horn_section from instruments/brass
use timpani from instruments/percussion
use chamber from effects
use pan, reverb, stereo_compressor, master from effects
use resonance from filters

in t
$sample_rate = 44100
$bpm = 126
$master_gain = 1.38
assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Audio buffers support sample rates from 8000 through 44100 Hz"
}

seq = score(t=t, bpm=$bpm)
rhythmic_strings = pizzicato_section(age=seq.piano_age,
    frequency=seq.piano_frequency, trigger=seq.piano_trigger,
    sample_rate=$sample_rate, gain=0.15)
piano_upper = fortepiano_chord(age=seq.upper_age,
    root_frequency=seq.upper_root_frequency,
    third_frequency=seq.upper_third_frequency,
    fifth_frequency=seq.upper_fifth_frequency,
    trigger=seq.upper_trigger, sample_rate=$sample_rate, gain=0.13)
first = violin_section(age=seq.violin_age,
    first_frequency=seq.violin_frequency,
    second_frequency=seq.violin_harmony_frequency,
    third_frequency=seq.violin_inner_frequency,
    trigger=seq.violin_trigger, sample_rate=$sample_rate,
    hold=seq.violin_hold, attack=seq.violin_attack, release=0.18,
    harmony_mix=seq.violin_harmony_mix, gain=0.11)
middle = viola(age=seq.viola_age, frequency=seq.viola_frequency,
    trigger=seq.viola_trigger, sample_rate=$sample_rate,
    hold=seq.viola_hold, attack=0.13, release=0.20)
low = cello(age=seq.cello_age, frequency=seq.cello_frequency,
    trigger=seq.cello_trigger, sample_rate=$sample_rate,
    hold=seq.cello_hold, attack=0.15, release=0.24)
brass = trombone(age=seq.brass_age, frequency=seq.brass_frequency,
    trigger=seq.brass_trigger, sample_rate=$sample_rate,
    hold=4 * 60 / $bpm - 0.12, release=0.34, gain=0.34)
drum = timpani(trigger=seq.timpani_trigger, frequency=seq.timpani_frequency,
    sample_rate=$sample_rate, gain=0.42, decay=1.65)
flute_voice = flute(age=seq.flute_age, frequency=seq.flute_frequency,
    trigger=seq.flute_trigger, sample_rate=$sample_rate,
    hold=seq.flute_hold, release=0.18)
oboe_voice = oboe(age=seq.oboe_age, frequency=seq.oboe_frequency,
    trigger=seq.oboe_trigger, sample_rate=$sample_rate,
    hold=seq.oboe_hold, release=0.16)
horn_voice = horn_section(age=seq.horn_age, root_frequency=seq.horn_frequency,
    harmony_frequency=seq.horn_harmony_frequency,
    trigger=seq.horn_trigger, sample_rate=$sample_rate,
    hold=seq.horn_hold, release=0.30, gain=0.13)
double_bass_voice = double_bass(age=seq.cello_age,
    frequency=0.5 * seq.cello_frequency, trigger=seq.cello_trigger,
    sample_rate=$sample_rate, hold=seq.cello_hold, gain=0.18)
clarinet_voice = clarinet(age=seq.oboe_age,
    frequency=0.5 * seq.oboe_frequency, trigger=seq.oboe_trigger,
    sample_rate=$sample_rate, hold=seq.oboe_hold, gain=0.12)
bassoon_voice = bassoon(age=seq.horn_age,
    frequency=0.5 * seq.horn_frequency, trigger=seq.horn_trigger,
    sample_rate=$sample_rate, hold=seq.horn_hold, gain=0.14)
trumpet_voice = trumpet(age=seq.brass_age,
    frequency=2 * seq.brass_frequency, trigger=seq.brass_trigger,
    sample_rate=$sample_rate, hold=4 * 60 / $bpm - 0.12, gain=0.11)

rhythm_tone = resonance(source=seq.piano_level * rhythmic_strings.sample,
    sample_rate=$sample_rate, cutoff=2400, resonance=0.10)
piano_tone = resonance(source=seq.upper_level * piano_upper.sample,
    sample_rate=$sample_rate, cutoff=2600, resonance=0.12)
violin_tone = resonance(source=seq.expression * seq.violin_level * first.sample,
    sample_rate=$sample_rate, cutoff=2800, resonance=0.10)
viola_tone = resonance(source=0.82 * middle.sample,
    sample_rate=$sample_rate, cutoff=2200, resonance=0.10)
cello_tone = resonance(source=0.92 * low.sample,
    sample_rate=$sample_rate, cutoff=1700, resonance=0.08)
double_bass_tone = resonance(source=0.72 * double_bass_voice.sample,
    sample_rate=$sample_rate, cutoff=900, resonance=0.06)
flute_tone = resonance(source=seq.flute_level * flute_voice.sample,
    sample_rate=$sample_rate, cutoff=3100, resonance=0.10)
oboe_tone = resonance(source=seq.oboe_level * oboe_voice.sample,
    sample_rate=$sample_rate, cutoff=2400, resonance=0.10)
clarinet_tone = resonance(source=0.72 * seq.oboe_level * clarinet_voice.sample,
    sample_rate=$sample_rate, cutoff=1900, resonance=0.08)
bassoon_tone = resonance(source=0.68 * seq.horn_level * bassoon_voice.sample,
    sample_rate=$sample_rate, cutoff=1250, resonance=0.08)
trombone_tone = resonance(source=seq.brass_level * brass.sample,
    sample_rate=$sample_rate, cutoff=1550, resonance=0.12)
horn_tone = resonance(source=seq.horn_level * horn_voice.sample,
    sample_rate=$sample_rate, cutoff=1450, resonance=0.10)
trumpet_tone = resonance(source=0.54 * seq.brass_level * trumpet_voice.sample,
    sample_rate=$sample_rate, cutoff=2100, resonance=0.10)

rhythm = pan(source=rhythm_tone.low, position=-0.28)
piano = pan(source=piano_tone.low, position=-0.10)
violins = pan(source=violin_tone.low, position=-0.62)
violas = pan(source=viola_tone.low, position=0.16)
cellos = pan(source=cello_tone.low, position=0.56)
double_basses = pan(source=double_bass_tone.low, position=0.72)
flutes = pan(source=flute_tone.low, position=-0.22)
oboes = pan(source=oboe_tone.low, position=0.10)
clarinets = pan(source=clarinet_tone.low, position=-0.02)
bassoons = pan(source=bassoon_tone.low, position=0.24)
horns = pan(source=horn_tone.low, position=0.38)
trombones = pan(source=trombone_tone.low, position=0.58)
trumpets = pan(source=trumpet_tone.low, position=0.30)
timpani_section = pan(source=seq.timpani_level * drum.sample, position=0.06)
dry_left = rhythm.left + piano.left + violins.left + violas.left + cellos.left +
    double_basses.left + flutes.left + oboes.left + clarinets.left + bassoons.left +
    horns.left + trumpets.left + trombones.left + timpani_section.left
dry_right = rhythm.right + piano.right + violins.right + violas.right + cellos.right +
    double_basses.right + flutes.right + oboes.right + clarinets.right + bassoons.right +
    horns.right + trumpets.right + trombones.right + timpani_section.right

# Early reflections establish the stage; deeper sections feed more of the hall.
early = chamber(source_left=0.28 * dry_left, source_right=0.28 * dry_right,
    sample_rate=$sample_rate, feedback=0.36)
hall_send_left = 0.18 * rhythm.left + 0.16 * piano.left +
    0.28 * (violins.left + violas.left + cellos.left + double_basses.left) +
    0.42 * (flutes.left + oboes.left + clarinets.left + bassoons.left) +
    0.52 * (horns.left + trumpets.left + trombones.left + timpani_section.left)
hall_send_right = 0.18 * rhythm.right + 0.16 * piano.right +
    0.28 * (violins.right + violas.right + cellos.right + double_basses.right) +
    0.42 * (flutes.right + oboes.right + clarinets.right + bassoons.right) +
    0.52 * (horns.right + trumpets.right + trombones.right + timpani_section.right)
hall = reverb(source_left=hall_send_left, source_right=hall_send_right,
    sample_rate=$sample_rate, feedback=0.85, damping=2850)
glued = stereo_compressor(
    source_left=dry_left + 0.48 * early.left + 0.78 * hall.left,
    source_right=dry_right + 0.48 * early.right + 0.78 * hall.right,
    sample_rate=$sample_rate, threshold=0.34, ratio=1.8,
    attack=0.028, release=0.24, makeup=1.03)
finished = master(
    source_left=glued.left,
    source_right=glued.right,
    t=t, sample_rate=$sample_rate, gain=$master_gain,
    duration=seq.duration, fade_seconds=1.1, ceiling=0.90)
left = finished.left
right = finished.right
duration = seq.duration

out {
    left, right, duration
}
