// Complete Bach-Busoni transcription rendered by sixteen grand-piano voices.
model song(type = "dsp")

use sequencer from arrangement
use grand_piano from instruments.classical
use pan from stereo.effects
use chamber, hall, master from stereo.effects
use resonance from stereo.filters

in t
$sample_rate = 44100

seq = sequencer(t=t)
stereo_voices = map(seq.voices, voice => {
    piano = grand_piano(
        age=voice.age,
        frequency=voice.frequency,
        trigger=voice.trigger,
        sample_rate=$sample_rate,
        gain=0.0625 * voice.gain,
        delay_samples=floor($sample_rate / voice.frequency));
    return pan(mono=piano, position=voice.pan);
})
stereo_mix = sum(stereo_voices)
tone = resonance(stereo=stereo_mix, sample_rate=$sample_rate,
    cutoff=4600, resonance=0.022)
dry_left = tone.low.left
dry_right = tone.low.right

near_room = { left = 0.50 * dry_left, right = 0.50 * dry_right }
    |> chamber(sample_rate=$sample_rate, feedback=0.18)
hall_room = {
    left = 0.16 * dry_left + 0.08 * near_room.left,
    right = 0.16 * dry_right + 0.08 * near_room.right
} |> hall(sample_rate=$sample_rate, decay_seconds=2.4, damping=2000)
master_source = {
    left = dry_left + 0.22 * near_room.left + 0.15 * hall_room.left,
    right = dry_right + 0.22 * near_room.right + 0.15 * hall_room.right
}
stereo = master_source |> master(
    t=t, sample_rate=$sample_rate, gain=1.30, duration=seq.duration,
    fade_seconds=8.0, fade_in_seconds=0.25, ceiling=0.90)

duration = seq.duration
out stereo, duration
