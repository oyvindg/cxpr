// Neon Circuit: twenty-four-bar electronic drum solo and production chain.
model song(type = "dsp")

// Arrangement is local; reusable voices and production effects come from the
// shared audio root.
use sequencer from arrangement
use kick, snare, hat, clap, shaker, tom, crash from instruments.drum
use gated_reverb, pan from stereo.effects
use compressor, hall, master, tape from stereo.effects

in t
$sample_rate = 44100
$bpm = 118
$master_gain = 1.35
assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Audio buffers support sample rates from 8000 through 44100 Hz"
}

// The sequencer owns the twenty-four-bar pattern and emits one-sample triggers,
// velocity-like levels, deterministic noise seeds and section-dependent sends.
seq = sequencer(t=t, bpm=$bpm)

// Each call site is a separately scoped voice. In particular, open and closed
// hats and the three toms can overlap without resetting each other's tails.
k = kick(trigger=seq.kick.trigger, sample_rate=$sample_rate, gain=0.68)
s = snare(trigger=seq.snare.trigger, sample_rate=$sample_rate,
          seed=seq.texture.seed, gain=0.48)
c = clap(trigger=seq.clap.trigger, sample_rate=$sample_rate,
         seed=seq.texture.seed + 7919, gain=0.32)
shaker_voice = shaker(trigger=seq.shaker.trigger, sample_rate=$sample_rate,
                      seed=seq.texture.seed + 104729, gain=0.16)
closed_hat = hat(trigger=seq.hats.closed.trigger, sample_rate=$sample_rate,
                 seed=seq.texture.seed + 3571, decay=52, gain=0.23)
open_hat = hat(trigger=seq.hats.open.trigger, sample_rate=$sample_rate,
               seed=seq.texture.seed + 8191, decay=11, gain=0.20)
high_tom = tom(trigger=seq.toms.high.trigger, sample_rate=$sample_rate,
               frequency=176, gain=0.43)
mid_tom = tom(trigger=seq.toms.mid.trigger, sample_rate=$sample_rate,
              frequency=132, gain=0.46)
low_tom = tom(trigger=seq.toms.low.trigger, sample_rate=$sample_rate,
              frequency=98, gain=0.50)
crash_voice = crash(trigger=seq.crash.trigger, sample_rate=$sample_rate,
                    seed=seq.texture.seed + 12289, gain=0.22)

// Build a drummer-perspective stereo kit. Kick anchors the center while snare,
// clap and cymbals occupy distinct positions. Toms sweep clearly left-to-right.
snare_signal = seq.snare.level * s.sample
clap_signal = seq.clap.level * c.sample
snare_bus = snare_signal + clap_signal
snare_stereo = pan(source=snare_signal, position=-0.08)
clap_stereo = pan(source=clap_signal, position=0.38)
shaker_stereo = pan(source=seq.shaker.level * shaker_voice.sample, position=0.70)
closed_hat_stereo = pan(source=seq.hats.closed.level * closed_hat.sample, position=0.56)
open_hat_stereo = pan(source=seq.hats.open.level * open_hat.sample, position=-0.34)
crash_stereo = pan(source=crash_voice.sample, position=-0.68)
toms_left = 0.88 * seq.toms.high.level * high_tom.sample +
    0.30 * seq.toms.mid.level * mid_tom.sample
toms_right = 0.30 * seq.toms.mid.level * mid_tom.sample +
    0.88 * seq.toms.low.level * low_tom.sample

// Snare/clap receives a short gated send, while the full kit feeds a quieter
// room whose amount is automated by the arrangement.
gate = gated_reverb(source=snare_bus, sample_rate=$sample_rate,
    feedback=0.57, gate_seconds=0.24)
kick_center = 0.7071067811865476 * seq.kick.level * k.sample
dry_left = kick_center + snare_stereo.left + clap_stereo.left +
    shaker_stereo.left + closed_hat_stereo.left +
    open_hat_stereo.left + crash_stereo.left + toms_left
dry_right = kick_center + snare_stereo.right + clap_stereo.right +
    shaker_stereo.right + closed_hat_stereo.right +
    open_hat_stereo.right + crash_stereo.right + toms_right
room = {
    left = seq.texture.room_send * (0.20 * dry_left + 0.34 * toms_left),
    right = seq.texture.room_send * (0.20 * dry_right + 0.34 * toms_right)
} |> hall(sample_rate=$sample_rate, feedback=0.70, damping=4300)

// The stereo-linked compressor glues dry and wet buses before tape color. The
// master then removes DC, applies final saturation and performs the end fade.
compressed = {
    left = dry_left + 0.48 * gate.left + 0.44 * room.left,
    right = dry_right + 0.48 * gate.right + 0.44 * room.right
} |> compressor(sample_rate=$sample_rate, threshold=0.34, ratio=3.5,
                       attack=0.009, release=0.13, makeup=1.10)
stereo = compressed
    |> tape(sample_rate=$sample_rate, drive=1.16, mix=0.68)
    |> master(t=t, sample_rate=$sample_rate, gain=$master_gain,
              duration=seq.duration, fade_seconds=1.1, ceiling=0.90)
duration = seq.duration
out stereo, duration
