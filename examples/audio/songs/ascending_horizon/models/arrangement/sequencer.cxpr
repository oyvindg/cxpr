# Original progressive piano score growing from ambient space into an epic arc.
model sequencer(type = "sequencer", lifecycle = "scoped")

use lane from sequencing

in t
$bpm = 82

fn hz(note) = 440 * pow(2, (note - 69) / 12)
fn root(bar) = bar < 16 ?
    (bar % 8 == 0 ? 45 : bar % 8 == 1 ? 41 : bar % 8 == 2 ? 48 :
     bar % 8 == 3 ? 43 : bar % 8 == 4 ? 45 : bar % 8 == 5 ? 41 :
     bar % 8 == 6 ? 48 : 43) :
    (bar % 8 == 0 ? 45 : bar % 8 == 1 ? 48 : bar % 8 == 2 ? 53 :
     bar % 8 == 3 ? 55 : bar % 8 == 4 ? 45 : bar % 8 == 5 ? 48 :
     bar % 8 == 6 ? 53 : 45)
fn third(bar) = root(bar) + (root(bar) == 45 ? 3 : 4)
fn seventh(bar) = root(bar) + (root(bar) == 45 or root(bar) == 43 ? 10 : 11)

beat_seconds = 60 / $bpm
bar_seconds = 4 * beat_seconds
beat = max(0, t) / beat_seconds
bar = min(floor(beat / 4), 27)
section = bar < 4 ? 0 : bar < 8 ? 1 : bar < 16 ? 2 : bar < 24 ? 3 : 4

# The main piano accelerates from eighth-note space to flowing sixteenths.
arp_rate = section < 2 ? 2 : 4
arp_step = min(floor(beat * arp_rate), 447)
arp_slot = arp_step % (4 * arp_rate)
arp_bar = floor(arp_step / (4 * arp_rate))
arp_eighth_slot = floor(arp_slot / max(1, arp_rate / 2))
arp_interval = arp_eighth_slot % 8 == 0 ? 0 : arp_eighth_slot % 8 == 1 ? 7 :
    arp_eighth_slot % 8 == 2 ? 12 : arp_eighth_slot % 8 == 3 ?
    12 + third(arp_bar) - root(arp_bar) :
    arp_eighth_slot % 8 == 4 ? 19 : arp_eighth_slot % 8 == 5 ? 24 :
    arp_eighth_slot % 8 == 6 ? 19 : 12
arp_lane = lane(t=t, step=arp_step, step_seconds=beat_seconds / arp_rate,
    offset=0, enabled=true)
arp_trigger = arp_lane.trigger
arp_age = arp_lane.age
arp_frequency = hz(root(arp_bar) + arp_interval)
arp_level = section == 0 ? 0.56 : section == 1 ? 0.66 :
    section == 2 ? 0.72 : section == 3 ? 0.84 : 0.60

# A broad, memorable melody arrives after the four-bar piano introduction.
melody_step = min(floor(beat), 111)
melody_slot = melody_step % 8
melody_bar = floor(melody_step / 4)
melody_enabled = melody_bar >= 4 and not (melody_bar == 7 or melody_bar == 15)
melody_lane = lane(t=t, step=melody_step, step_seconds=beat_seconds,
    offset=0, enabled=melody_enabled)
melody_trigger = melody_lane.trigger
melody_age = melody_lane.age
melody_phrase = melody_slot == 0 ? 12 : melody_slot == 1 ?
    12 + third(melody_bar) - root(melody_bar) :
    melody_slot == 2 ? 19 : melody_slot == 3 ? 17 : melody_slot == 4 ?
    12 + third(melody_bar) - root(melody_bar) :
    melody_slot == 5 ? 12 : melody_slot == 6 ?
    seventh(melody_bar) - root(melody_bar) : 7
melody_lift = section == 3 ? 12 : section == 4 ? 5 : 0
melody_frequency = hz(root(melody_bar) + melody_phrase + melody_lift)
melody_level = melody_enabled ? (melody_slot == 0 or melody_slot == 4 ? 0.94 : 0.72) : 0

# Low piano octaves define each harmonic turn.
bass_step = min(floor(beat / 2), 55)
bass_bar = floor(bass_step / 2)
bass_lane = lane(t=t, step=bass_step, step_seconds=2 * beat_seconds,
    offset=0, enabled=true)
bass_trigger = bass_lane.trigger
bass_age = bass_lane.age
bass_frequency = hz(root(bass_bar) - 12 + (bass_step % 2 == 0 ? 0 : 7))
bass_level = section < 2 ? 0.58 : section == 3 ? 0.84 : 0.68

# Long pad chords provide the ambient horizon behind the acoustic piano.
pad_step = min(floor(beat / 4), 27)
pad_lane = lane(t=t, step=pad_step, step_seconds=bar_seconds,
    offset=0, enabled=true)
pad_trigger = pad_lane.trigger
pad_age = pad_lane.age
pad_root_frequency = hz(root(pad_step))
pad_level = section == 0 ? 0.22 : section == 1 ? 0.32 :
    section == 2 ? 0.42 : section == 3 ? 0.54 : 0.34

# Strings enter halfway through and climb into the final five-bar peak.
string_step = min(floor(beat / 2), 55)
string_bar = floor(string_step / 2)
string_lane = lane(t=t, step=string_step, step_seconds=2 * beat_seconds,
    offset=0, enabled=string_bar >= 8)
string_trigger = string_lane.trigger
string_age = string_lane.age
string_frequency = hz(third(string_bar) + 12 +
    (string_step % 2 == 0 ? 0 : 4) + (section == 3 ? 12 : 0))
string_level = string_bar < 8 ? 0 : section == 2 ? 0.34 :
    section == 3 ? 0.68 : 0.40

# Horns and timpani appear only where the arrangement becomes cinematic.
epic_step = min(floor(beat / 4), 27)
epic_lane = lane(t=t, step=epic_step, step_seconds=bar_seconds,
    offset=0, enabled=epic_step >= 16 and epic_step <= 23)
epic_trigger = epic_lane.trigger
epic_age = epic_lane.age
epic_root_frequency = hz(root(epic_step))
epic_third_frequency = hz(third(epic_step) + 12)
epic_level = epic_step < 16 or epic_step > 23 ? 0 :
    epic_step < 19 ? 0.42 : 0.66
timpani_step = min(floor(beat * 2), 223)
timpani_bar = floor(timpani_step / 8)
timpani_slot = timpani_step % 8
timpani_enabled = timpani_bar >= 16 and timpani_bar <= 23 and
    (timpani_slot == 0 or timpani_slot == 6)
timpani_lane = lane(t=t, step=timpani_step,
    step_seconds=beat_seconds / 2, offset=0, enabled=timpani_enabled)
timpani_trigger = timpani_lane.trigger
timpani_frequency = hz(root(timpani_bar) - 24)
timpani_level = timpani_enabled ? (timpani_slot == 0 ? 0.80 : 0.52) : 0

# A four-bar acoustic/electronic kit enters late without disturbing the broad
# orchestral pulse. The last bar turns the backbeat into a rising snare/tom fill.
drum_step = min(floor(beat * 4), 447)
drum_bar = floor(drum_step / 16)
drum_slot = drum_step % 16
drum_active = drum_bar >= 20 and drum_bar <= 23
drum_lane = lane(t=t, step=drum_step, step_seconds=beat_seconds / 4,
    offset=0, enabled=drum_active)
drum_changed = drum_lane.trigger
drum_fill = drum_bar == 23 and drum_slot >= 12
kit_kick_trigger = drum_changed and drum_active and not drum_fill and
    contains(drum_slot, [0, 6, 8, 11])
kit_kick_level = drum_slot == 0 ? 1 : drum_slot == 8 ? 0.88 : 0.72
kit_snare_trigger = drum_changed and drum_active and
    (contains(drum_slot, [4, 12]) or drum_fill)
kit_snare_level = drum_fill ? 0.52 + 0.12 * (drum_slot - 12) :
    drum_slot == 12 ? 1 : 0.90
kit_closed_hat_trigger = drum_changed and drum_active and
    drum_slot % 2 == 0 and drum_slot != 14 and not drum_fill
kit_closed_hat_level = drum_slot % 4 == 2 ? 0.64 : 0.42
kit_open_hat_trigger = drum_changed and drum_active and drum_bar < 23 and
    drum_slot == 14
kit_open_hat_level = 0.62
kit_tom_trigger = drum_changed and drum_active and
    ((drum_bar == 21 and contains(drum_slot, [10, 13])) or
     (drum_bar == 23 and contains(drum_slot, [11, 13, 15])))
kit_tom_frequency = drum_slot < 12 ? 176 : drum_slot < 15 ? 132 : 98
kit_tom_level = drum_bar == 23 ? 0.82 : 0.64
kit_crash_trigger = drum_changed and drum_active and drum_slot == 0 and
    contains(drum_bar, [20, 23])
kit_seed = (28411 + drum_step * 7919) % 2147483647
drum_kick = { trigger = kit_kick_trigger, level = kit_kick_level }
drum_snare = { trigger = kit_snare_trigger, level = kit_snare_level }
drum_closed_hat = {
    trigger = kit_closed_hat_trigger,
    level = kit_closed_hat_level
}
drum_open_hat = {
    trigger = kit_open_hat_trigger,
    level = kit_open_hat_level
}
drum_tom = {
    trigger = kit_tom_trigger,
    frequency = kit_tom_frequency,
    level = kit_tom_level
}
drum_crash = { trigger = kit_crash_trigger }
drum_texture = { seed = kit_seed }

duration = 28 * bar_seconds + 7.0

out {
    arp_trigger, arp_age, arp_frequency, arp_level,
    melody_trigger, melody_age, melody_frequency, melody_level,
    bass_trigger, bass_age, bass_frequency, bass_level,
    pad_trigger, pad_age, pad_root_frequency, pad_level,
    string_trigger, string_age, string_frequency, string_level,
    epic_trigger, epic_age, epic_root_frequency, epic_third_frequency, epic_level,
    timpani_trigger, timpani_frequency, timpani_level,
    drum_kick, drum_snare, drum_closed_hat, drum_open_hat,
    drum_tom, drum_crash, drum_texture, duration
}
