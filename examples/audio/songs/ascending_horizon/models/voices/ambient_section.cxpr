# Song-specific pad, violin, and cello section.
model ambient_section

use violin_section, cello from instruments.classical
use chord_pad from instruments.pad
use resonance from mono.filters
use pan, chorus from stereo.effects

in pad_age, pad_root_frequency, pad_trigger, pad_level
in string_age, string_frequency, string_trigger, string_level
$sample_rate = 44100
$bpm = 82

pad_voice = chord_pad(age=pad_age, root_frequency=pad_root_frequency,
    trigger=pad_trigger, sample_rate=$sample_rate, clarity=0.20)
strings_voice = violin_section(age=string_age,
    first_frequency=string_frequency,
    second_frequency=string_frequency * pow(2, 7 / 12),
    third_frequency=0.5 * string_frequency,
    trigger=string_trigger, sample_rate=$sample_rate,
    hold=2 * 60 / $bpm - 0.08, attack=0.70, release=1.4,
    harmony_mix=0.34, gain=0.11)
cello_voice = cello(age=string_age, frequency=0.25 * string_frequency,
    trigger=string_trigger, sample_rate=$sample_rate,
    hold=2 * 60 / $bpm - 0.08, attack=0.55, release=1.2, gain=0.13)
pad_tone = resonance(mono=pad_level * pad_voice,
    sample_rate=$sample_rate, cutoff=1700, resonance=0.08)
strings_tone = resonance(mono=string_level *
    (strings_voice.sample + 0.68 * cello_voice.sample),
    sample_rate=$sample_rate, cutoff=2700, resonance=0.05)
pad = chorus(source=pad_tone.low, sample_rate=$sample_rate,
    rate=0.09, depth=0.72, mix=0.48)
strings = pan(mono=strings_tone.low, position=-0.42)

out pad, strings
