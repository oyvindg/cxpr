# Four-bar late-song kit adapted from the shared drum-solo production chain.
model drum_section(lifecycle = "scoped")

use kick, snare, hat, tom, crash from instruments.drum
use gated_reverb, pan, gain, compressor, tape from stereo.effects

in kick, snare, closed_hat, open_hat, tom, crash, texture
$sample_rate = 44100

kick_voice = kick(trigger=kick.trigger, sample_rate=$sample_rate, gain=0.58)
snare_voice = snare(trigger=snare.trigger, sample_rate=$sample_rate,
    seed=texture.seed, gain=0.40)
closed_hat_voice = hat(trigger=closed_hat.trigger, sample_rate=$sample_rate,
    seed=texture.seed + 3571, decay=52, gain=0.17)
open_hat_voice = hat(trigger=open_hat.trigger, sample_rate=$sample_rate,
    seed=texture.seed + 8191, decay=11, gain=0.16)
tom_voice = tom(trigger=tom.trigger, sample_rate=$sample_rate,
    frequency=tom.frequency, gain=0.40)
crash_voice = crash(trigger=crash.trigger, sample_rate=$sample_rate,
    seed=texture.seed + 12289, gain=0.17)

kick_bus = kick.level * kick_voice.sample |> pan(position=0)
snare_signal = snare.level * snare_voice.sample
snare_bus = snare_signal |> pan(position=-0.10)
closed_hat_bus = closed_hat.level * closed_hat_voice.sample |> pan(position=0.52)
open_hat_bus = open_hat.level * open_hat_voice.sample |> pan(position=-0.30)
tom_position = clamp((tom.frequency - 98) / 78 * -1.1 + 0.55, -0.55, 0.55)
tom_bus = tom.level * tom_voice.sample |> pan(position=tom_position)
crash_bus = crash_voice.sample |> pan(position=-0.62)

dry = sum([
    kick_bus, snare_bus, closed_hat_bus, open_hat_bus, tom_bus, crash_bus
])
gate = snare_signal |> gated_reverb(
    sample_rate=$sample_rate, feedback=0.54, gate_seconds=0.25)
gate_bus = gate |> gain(level=0.34)
compressed = sum([
    dry,
    gate_bus
]) |>
    compressor(sample_rate=$sample_rate, threshold=0.36, ratio=2.8,
        attack=0.012, release=0.16, makeup=1.04)
stereo = compressed |> tape(sample_rate=$sample_rate, drive=1.10, mix=0.46)

out left = stereo.left
out right = stereo.right
