# Ascending Horizon: progressive grand piano with an ambient, epic soundscape.
model song(type = "dsp")

use sequencer from arrangement
use piano_section, ambient_section, epic_section, drum_section from voices
use ambience from mix
use master from stereo.effects

in t
$sample_rate = 44100
$bpm = 82

seq = sequencer(t=t, bpm=$bpm)
duration = seq.duration
piano = piano_section(
    arp_age=seq.arp_age, arp_frequency=seq.arp_frequency,
    arp_trigger=seq.arp_trigger, arp_level=seq.arp_level,
    melody_age=seq.melody_age, melody_frequency=seq.melody_frequency,
    melody_trigger=seq.melody_trigger, melody_level=seq.melody_level,
    bass_age=seq.bass_age, bass_frequency=seq.bass_frequency,
    bass_trigger=seq.bass_trigger, bass_level=seq.bass_level,
    sample_rate=$sample_rate)
ambient = ambient_section(
    pad_age=seq.pad_age, pad_root_frequency=seq.pad_root_frequency,
    pad_trigger=seq.pad_trigger, pad_level=seq.pad_level,
    string_age=seq.string_age, string_frequency=seq.string_frequency,
    string_trigger=seq.string_trigger, string_level=seq.string_level,
    sample_rate=$sample_rate, bpm=$bpm)
epic = epic_section(
    epic_age=seq.epic_age, epic_root_frequency=seq.epic_root_frequency,
    epic_third_frequency=seq.epic_third_frequency,
    epic_trigger=seq.epic_trigger, epic_level=seq.epic_level,
    timpani_trigger=seq.timpani_trigger,
    timpani_frequency=seq.timpani_frequency,
    timpani_level=seq.timpani_level,
    sample_rate=$sample_rate, bpm=$bpm)
kit = drum_section(
    kick=seq.drum_kick,
    snare=seq.drum_snare,
    closed_hat=seq.drum_closed_hat,
    open_hat=seq.drum_open_hat,
    tom=seq.drum_tom,
    crash=seq.drum_crash,
    texture=seq.drum_texture,
    sample_rate=$sample_rate)
mix = ambience(
    arpeggio=piano.arpeggio, melody=piano.melody, bass=piano.bass,
    pad=ambient.pad, strings=ambient.strings,
    horns=epic.horns, drums=epic.drums, kit=kit,
    sample_rate=$sample_rate)
stereo = mix |> master(t=t, sample_rate=$sample_rate, gain=1.06,
    duration=duration, fade_seconds=5.5, fade_in_seconds=0.5, ceiling=0.90)
out stereo, duration
