# Storm Overture: original aggressive minor-key orchestral movement.
model song(type = "dsp")

use score from arrangement
use pizzicato_section, violin_section, viola, cello, double_bass from instruments.classical
use flute, oboe, clarinet, bassoon from instruments.woodwind
use trumpet, trombone, horn_section from instruments.brass
use timpani from instruments.percussion
use resonance from mono.filters
use pan from stereo.effects
use chamber, compressor, hall, master from stereo.effects

in t
$sample_rate = 44100
$bpm = 144
$master_gain = 1.04
assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Orchestral buffers support sample rates from 8000 through 44100 Hz"
}

seq = score(t=t, bpm=$bpm)
ostinato_voice = pizzicato_section(age=seq.ostinato_age,
    frequency=seq.ostinato_frequency, trigger=seq.ostinato_trigger,
    sample_rate=$sample_rate, gain=0.12)
arp_voice = pizzicato_section(age=seq.arp_age,
    frequency=seq.arp_frequency, trigger=seq.arp_trigger,
    sample_rate=$sample_rate, gain=0.085)
violins_voice = violin_section(age=seq.violin_age,
    first_frequency=seq.violin_frequency,
    second_frequency=seq.violin_harmony_frequency,
    third_frequency=seq.violin_inner_frequency,
    trigger=seq.violin_trigger, sample_rate=$sample_rate,
    hold=seq.violin_hold, attack=seq.violin_attack, release=0.16,
    harmony_mix=seq.violin_harmony_mix, gain=0.115)
viola_voice = viola(age=seq.inner_age, frequency=seq.viola_frequency,
    trigger=seq.inner_trigger, sample_rate=$sample_rate,
    hold=seq.viola_hold, attack=0.15, release=0.22, gain=0.16)
cello_voice = cello(age=seq.inner_age, frequency=seq.cello_frequency,
    trigger=seq.inner_trigger, sample_rate=$sample_rate,
    hold=seq.cello_hold, attack=0.18, release=0.26, gain=0.18)
bass_voice = double_bass(age=seq.inner_age, frequency=0.5 * seq.cello_frequency,
    trigger=seq.inner_trigger, sample_rate=$sample_rate,
    hold=seq.cello_hold, attack=0.24, release=0.32, gain=0.15)
flute_voice = flute(age=seq.wind_age, frequency=seq.wind_frequency,
    trigger=seq.wind_trigger, sample_rate=$sample_rate,
    hold=seq.wind_hold, release=0.16, gain=0.12)
oboe_voice = oboe(age=seq.wind_age, frequency=0.5 * seq.wind_frequency,
    trigger=seq.wind_trigger, sample_rate=$sample_rate,
    hold=seq.wind_hold, release=0.18, gain=0.13)
clarinet_voice = clarinet(age=seq.wind_age, frequency=0.5 * seq.wind_frequency,
    trigger=seq.wind_trigger, sample_rate=$sample_rate,
    hold=seq.wind_hold, release=0.20, gain=0.12)
bassoon_voice = bassoon(age=seq.inner_age, frequency=0.5 * seq.viola_frequency,
    trigger=seq.inner_trigger, sample_rate=$sample_rate,
    hold=seq.viola_hold, release=0.22, gain=0.14)
horn_voice = horn_section(age=seq.brass_age,
    root_frequency=seq.brass_root_frequency,
    harmony_frequency=seq.brass_third_frequency,
    trigger=seq.brass_trigger, sample_rate=$sample_rate,
    hold=4 * 60 / $bpm - 0.10, release=0.28, gain=0.16)
trumpet_voice = trumpet(age=seq.brass_age,
    frequency=2 * seq.brass_root_frequency, trigger=seq.brass_trigger,
    sample_rate=$sample_rate, hold=4 * 60 / $bpm - 0.10,
    release=0.26, gain=0.15)
trombone_voice = trombone(age=seq.brass_age,
    frequency=0.5 * seq.brass_root_frequency, trigger=seq.brass_trigger,
    sample_rate=$sample_rate, hold=4 * 60 / $bpm - 0.10,
    release=0.32, gain=0.30)
timpani_voice = timpani(trigger=seq.timpani_trigger,
    frequency=seq.timpani_frequency, sample_rate=$sample_rate,
    gain=0.48, decay=1.85)
opening_timpani_voice = timpani(trigger=seq.opening_timpani_trigger,
    frequency=seq.opening_timpani_frequency, sample_rate=$sample_rate,
    gain=0.78, decay=0.82)

ostinato_tone = resonance(
    source=seq.ostinato_level * ostinato_voice.sample,
    sample_rate=$sample_rate, cutoff=2600, resonance=0.10)
arp_tone = resonance(mono=seq.arp_level * arp_voice.sample,
    sample_rate=$sample_rate, cutoff=3200, resonance=0.06)
strings_tone = resonance(
    source=seq.expression * seq.violin_level * violins_voice.sample,
    sample_rate=$sample_rate, cutoff=3300, resonance=0.06)
inner_tone = resonance(
    source=0.86 * viola_voice.sample + 0.82 * cello_voice.sample +
        0.58 * bass_voice.sample,
    sample_rate=$sample_rate, cutoff=1850, resonance=0.04)
flute_tone = resonance(mono=seq.wind_level * flute_voice.sample,
    sample_rate=$sample_rate, cutoff=3900, resonance=0.04)
oboe_tone = resonance(mono=seq.wind_level * oboe_voice.sample,
    sample_rate=$sample_rate, cutoff=2800, resonance=0.05)
clarinet_tone = resonance(mono=seq.wind_level * clarinet_voice.sample,
    sample_rate=$sample_rate, cutoff=2700, resonance=0.05)
bassoon_tone = resonance(mono=0.72 * seq.wind_level * bassoon_voice.sample,
    sample_rate=$sample_rate, cutoff=1800, resonance=0.05)
horn_tone = resonance(mono=seq.brass_level * horn_voice.sample,
    sample_rate=$sample_rate, cutoff=2200, resonance=0.07)
trumpet_tone = resonance(mono=seq.brass_level * trumpet_voice.sample,
    sample_rate=$sample_rate, cutoff=3000, resonance=0.05)
trombone_tone = resonance(mono=seq.brass_level * trombone_voice.sample,
    sample_rate=$sample_rate, cutoff=1900, resonance=0.07)

ostinato = pan(mono=ostinato_tone.low, position=-0.34)
arpeggio = pan(mono=arp_tone.low, position=0.26)
violins = pan(mono=strings_tone.low, position=-0.64)
inner_strings = pan(mono=inner_tone.low, position=0.38)
flutes = pan(mono=flute_tone.low, position=-0.28)
oboes = pan(mono=oboe_tone.low, position=-0.06)
clarinets = pan(mono=clarinet_tone.low, position=0.12)
bassoons = pan(mono=bassoon_tone.low, position=0.28)
horns = pan(mono=horn_tone.low, position=0.36)
trumpets = pan(mono=trumpet_tone.low, position=0.14)
trombones = pan(mono=trombone_tone.low, position=0.58)
drums = pan(mono=seq.timpani_level * timpani_voice.sample, position=0.08)
opening_drum = pan(mono=seq.opening_timpani_level * opening_timpani_voice.sample,
    position=0)
dry_left = ostinato.left + arpeggio.left + violins.left + inner_strings.left +
    flutes.left + oboes.left + clarinets.left + bassoons.left +
    horns.left + trumpets.left + trombones.left + drums.left + opening_drum.left
dry_right = ostinato.right + arpeggio.right + violins.right + inner_strings.right +
    flutes.right + oboes.right + clarinets.right + bassoons.right +
    horns.right + trumpets.right + trombones.right + drums.right + opening_drum.right

early = {
    left = 0.30 * dry_left,
    right = 0.30 * dry_right
} |> chamber(sample_rate=$sample_rate, feedback=0.40)
hall_room = {
    left = 0.24 * ostinato.left + 0.30 * arpeggio.left + 0.32 * violins.left +
        0.36 * inner_strings.left +
        0.42 * (flutes.left + oboes.left + clarinets.left + bassoons.left) +
        0.52 * (horns.left + trumpets.left + trombones.left) +
        0.48 * drums.left + 1.10 * opening_drum.left,
    right = 0.24 * ostinato.right + 0.30 * arpeggio.right + 0.32 * violins.right +
        0.36 * inner_strings.right +
        0.42 * (flutes.right + oboes.right + clarinets.right + bassoons.right) +
        0.52 * (horns.right + trumpets.right + trombones.right) +
        0.48 * drums.right + 1.10 * opening_drum.right
} |> hall(sample_rate=$sample_rate, feedback=0.84, damping=3600)
glued = {
    left = 0.70 * (dry_left + 0.38 * early.left + 0.66 * hall_room.left),
    right = 0.70 * (dry_right + 0.38 * early.right + 0.66 * hall_room.right)
} |> compressor(sample_rate=$sample_rate, threshold=0.40, ratio=1.35,
                       attack=0.040, release=0.30, makeup=1.0)
stereo = glued
    |> master(t=t, sample_rate=$sample_rate, gain=$master_gain,
              duration=seq.duration, fade_seconds=1.6, ceiling=0.90)
duration = seq.duration
out stereo, duration
