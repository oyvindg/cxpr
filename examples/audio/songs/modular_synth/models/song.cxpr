# Composition root: arrangement -> reusable voice -> stereo effects -> master.
model song(type = "dsp")

use sequencer from arrangement
use pulse_saw_lead from instruments/lead
use chord_pad from instruments/pad
use trombone from instruments/brass
use timpani from instruments/percussion
use bass from instruments/native
use lead from instruments/native
use arp, drums from instruments/retrowave
use chamber, chorus, eighth_note_delay, pan, phaser, reverb, stereo_delay from effects
use resonance from filters

in t
$sample_rate = 44100
$master_gain = 0.64

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Audio buffers support sample rates from 8000 through 44100 Hz"
}

sequence = sequencer(t=t)
clarity_progress = clamp(t / max(0.001, sequence.duration - 0.8), 0, 1)
# Smoothstep keeps the opening hazy, then makes the final phrases distinctly
# brighter and drier without a discontinuity.
clarity = clarity_progress * clarity_progress * (3 - 2 * clarity_progress)
filter_position = clamp(3 * t / sequence.duration, 0, 3)
# Crossfade continuously through low-pass, band-pass, notch, and high-pass.
low_mix = max(0, 1 - abs(filter_position))
band_mix = max(0, 1 - abs(filter_position - 1))
notch_mix = max(0, 1 - abs(filter_position - 2))
high_mix = max(0, 1 - abs(filter_position - 3))
voice = pulse_saw_lead(frequency=sequence.frequency, gate=sequence.gate,
                       trigger=sequence.trigger, sample_rate=$sample_rate,
                       cutoff_base=160 + 520 * clarity,
                       cutoff_envelope=2200 + 1900 * clarity,
                       resonance=0.66 - 0.18 * clarity,
                       attack=0.022, release=0.15,
                       pulse_mix=0.24, drive=1.20,
                       low_mix=low_mix + 0.40 * high_mix,
                       band_mix=band_mix, notch_mix=0.88 * notch_mix,
                       high_mix=0.50 * high_mix)

# The atmospheric pad is a separate instrument and bus, leaving the featured
# subtractive voice available without shared oscillator or envelope state.
pad_a = chord_pad(age=sequence.pad_a_age,
                  root_frequency=sequence.pad_a_frequency,
                  trigger=sequence.pad_a_trigger, sample_rate=$sample_rate,
                  clarity=clarity)
pad_b = chord_pad(age=sequence.pad_b_age,
                  root_frequency=sequence.pad_b_frequency,
                  trigger=sequence.pad_b_trigger, sample_rate=$sample_rate,
                  clarity=clarity)
pad_mono = pad_a + pad_b
pad_chorus = chorus(source=pad_mono, sample_rate=$sample_rate,
                    rate=0.13, depth=0.82 - 0.30 * clarity,
                    mix=0.68 - 0.32 * clarity)
pad_room = reverb(source_left=0.42 * pad_chorus.left,
                  source_right=0.42 * pad_chorus.right,
                  sample_rate=$sample_rate,
                  feedback=0.84 - 0.16 * clarity,
                  damping=1900 + 3100 * clarity)

bass_voice = bass(age=sequence.bass_age, frequency=sequence.bass_frequency,
                  trigger=sequence.bass_trigger, sample_rate=$sample_rate,
                  hold=0.42, release=0.12, gain=0.34,
                  sub_mix=0.48, cutoff_floor=105)
melodic_bass_voice = bass(age=sequence.bass_age,
                          frequency=sequence.bass_melody_frequency,
                          trigger=sequence.bass_trigger,
                          sample_rate=$sample_rate,
                          hold=0.36, release=0.11, gain=0.20,
                          sub_mix=0.12, cutoff_floor=190)
pluck_voice = arp(age=sequence.pluck_age, frequency=sequence.pluck_frequency,
                  trigger=sequence.pluck_trigger, sample_rate=$sample_rate,
                  gain=0.10)
pluck_stereo = pan(source=pluck_voice, position=-0.42)
background_arp = arp(age=sequence.background_arp_age,
                     frequency=sequence.background_arp_frequency,
                     trigger=sequence.background_arp_trigger,
                     sample_rate=$sample_rate, gain=0.075)
background_arp_position = 0.62 * sin(2 * pi() * 0.047 * t)
background_arp_stereo = pan(source=background_arp,
                            position=background_arp_position)
background_arp_room = reverb(
    source_left=0.46 * background_arp_stereo.left,
    source_right=0.46 * background_arp_stereo.right,
    sample_rate=$sample_rate, feedback=0.84, damping=2500)
background_arp_presence = clamp((t - 28.0) / 5.0, 0, 1)
bass_presence = clamp((t - 2.0) / 1.0, 0, 1)
pluck_presence = clamp((t - 6.0) / 1.0, 0, 1)

# The faster FM-style lead has its own phaser, fixed right-side placement and
# cross-feedback delay, keeping it distinct from the saw/pulse lead.
fast_lead = lead(age=sequence.fast_lead_age,
                 frequency=sequence.fast_lead_frequency,
                 trigger=sequence.fast_lead_trigger,
                 sample_rate=$sample_rate, hold=0.075, release=0.11,
                 index=2.05, gain=0.23, ratio=1.414, decay=4.7,
                 octave_mix=0.27, transient_mix=0.11,
                 cutoff_base=2300, cutoff_envelope=6900)
fast_phase = phaser(source=fast_lead, sample_rate=$sample_rate,
                    rate=0.31, depth=0.58, mix=0.27)
fast_stereo = pan(source=fast_phase, position=0.34)
fast_echo = stereo_delay(source_left=0.30 * fast_stereo.left,
                         source_right=0.30 * fast_stereo.right,
                         sample_rate=$sample_rate, feedback=0.28, cutoff=5600)
fast_entry = clamp((t - 8.0) / 1.2, 0, 1)
fast_growth_progress = clamp((t - 8.0) / max(0.001, sequence.duration - 9.0), 0, 1)
fast_growth = fast_growth_progress * fast_growth_progress *
    (3 - 2 * fast_growth_progress)
fast_presence = fast_entry * (0.55 + 0.70 * fast_growth)

response_lead = pulse_saw_lead(frequency=sequence.response_frequency,
                               gate=sequence.response_gate,
                               trigger=sequence.response_trigger,
                               sample_rate=$sample_rate,
                               attack=0.030, release=0.20,
                               pulse_mix=0.18, drive=1.12,
                               cutoff_base=260, cutoff_envelope=2800,
                               resonance=0.44)
response_chorus = chorus(source=0.34 * response_lead,
                         sample_rate=$sample_rate,
                         rate=0.19, depth=0.72, mix=0.62)
response_presence = clamp((t - 20.0) / 3.0, 0, 1)

counter_lead = lead(age=sequence.counter_age,
                    frequency=sequence.counter_frequency,
                    trigger=sequence.counter_trigger,
                    sample_rate=$sample_rate, hold=1.35, release=0.55,
                    index=0.82, gain=0.15, ratio=1.5, decay=1.25,
                    octave_mix=0.11, transient_mix=0.025,
                    cutoff_base=1100, cutoff_envelope=3100)
counter_position = pan(source=counter_lead, position=-0.28)
counter_room = reverb(source_left=0.42 * counter_position.left,
                      source_right=0.42 * counter_position.right,
                      sample_rate=$sample_rate, feedback=0.82, damping=2200)
counter_presence = clamp((t - 40.0) / 4.0, 0, 1)

# Two independently stateful, slightly detuned brass voices create width before
# entering a dark room. The very low dry return keeps the section behind the
# foreground synths instead of merely panning one mono source.
trombone_left_voice = trombone(age=sequence.trombone_age,
                               frequency=0.997 * sequence.trombone_frequency,
                               trigger=sequence.trombone_trigger,
                               sample_rate=$sample_rate, hold=0.62,
                               release=0.38, gain=0.50)
trombone_right_voice = trombone(age=sequence.trombone_age,
                                frequency=1.003 * sequence.trombone_frequency,
                                trigger=sequence.trombone_trigger,
                                sample_rate=$sample_rate, hold=0.62,
                                release=0.38, gain=0.50)
trombone_left = pan(source=trombone_left_voice, position=-0.68)
trombone_right = pan(source=trombone_right_voice, position=0.68)
trombone_dry_left = trombone_left.left + 0.24 * trombone_right.left
trombone_dry_right = 0.24 * trombone_left.right + trombone_right.right
trombone_room = reverb(source_left=0.78 * trombone_dry_left,
                       source_right=0.78 * trombone_dry_right,
                       sample_rate=$sample_rate, feedback=0.91, damping=1050)
trombone_presence = clamp((t - 32.0) / 3.0, 0, 1)

timpani_voice = timpani(trigger=sequence.timpani_trigger,
                        frequency=sequence.trombone_frequency,
                        sample_rate=$sample_rate, gain=0.46, decay=1.55)
timpani_room = reverb(source_left=0.32 * timpani_voice,
                      source_right=0.32 * timpani_voice,
                      sample_rate=$sample_rate, feedback=0.78, damping=2400)
timpani_presence = clamp((t - 24.0) / 2.0, 0, 1) * sequence.timpani_level

drum_voice = drums(age=sequence.drum_age, trigger=sequence.drum_trigger,
                   sample_rate=$sample_rate, seed=sequence.drum_seed)
drum_center = sequence.drum_kick * drum_voice.kick +
    sequence.drum_snare * drum_voice.snare +
    sequence.drum_clap * drum_voice.clap
drum_hat_mono = sequence.drum_hat * drum_voice.hat +
    sequence.drum_open_hat * drum_voice.open_hat
drum_filter_motion = 0.5 + 0.5 * sin(2 * pi() * 0.037 * max(0, t - 16))
drum_filter = resonance(source=drum_center,
                                    sample_rate=$sample_rate,
                                    cutoff=1100 + 5600 * drum_filter_motion,
                                    resonance=0.72 + 0.18 * drum_filter_motion)
drum_center_tone = 0.18 * drum_center + 0.82 *
    (0.82 * drum_filter.low + 0.38 * drum_filter.band)
hat_filter_motion = 0.5 + 0.5 * sin(2 * pi() * 0.061 * max(0, t - 16) + pi() / 2)
hat_filter = resonance(source=drum_hat_mono,
                                   sample_rate=$sample_rate,
                                   cutoff=2600 + 3900 * hat_filter_motion,
                                   resonance=0.54)
drum_hats = pan(source=0.14 * drum_hat_mono + 0.86 * hat_filter.high,
                position=0.38)
drum_presence = clamp((t - 16.0) / 2.0, 0, 1)

# A mostly-wet secondary room turns sparse pad and delay energy into a slow
# background wash without moving the foreground voices backward.
atmosphere_room = reverb(
    source_left=0.14 * pad_chorus.left + 0.08 * fast_echo.left,
    source_right=0.14 * pad_chorus.right + 0.08 * fast_echo.right,
    sample_rate=$sample_rate, feedback=0.91, damping=1550)
atmosphere_level = 0.42 + 0.18 * (1 - clarity)

# Early reflections establish a mid-field room around rhythmic and response
# material, distinct from the long dark background reverbs.
ensemble_chamber = chamber(
    source_left=0.16 * response_chorus.left + 0.10 * drum_hats.left +
        0.07 * drum_center_tone,
    source_right=0.16 * response_chorus.right + 0.10 * drum_hats.right +
        0.07 * drum_center_tone,
    sample_rate=$sample_rate, feedback=0.34)

# Cross-feedback echoes connect the sparse rear voices across the stereo field.
rear_delay = stereo_delay(
    source_left=0.10 * counter_room.left + 0.07 * atmosphere_room.left +
        0.06 * background_arp_room.left,
    source_right=0.10 * counter_room.right + 0.07 * atmosphere_room.right +
        0.06 * background_arp_room.right,
    sample_rate=$sample_rate, feedback=0.48, cutoff=2100)

# Stagger the outro from the deepest/heaviest layers toward foreground detail.
bass_exit = 1 - clamp((t - 44.0) / 6.0, 0, 1)
timpani_exit = 1 - clamp((t - 48.0) / 6.0, 0, 1)
trombone_exit = 1 - clamp((t - 50.0) / 6.0, 0, 1)
drum_exit = 1 - clamp((t - 52.0) / 6.0, 0, 1)
pad_exit = 1 - clamp((t - 54.0) / 7.0, 0, 1)
arp_exit = 1 - clamp((t - 56.0) / 5.0, 0, 1)
response_exit = 1 - clamp((t - 58.0) / 4.0, 0, 1)
counter_exit = 1 - clamp((t - 59.0) / 4.0, 0, 1)
main_lead_exit = 1 - clamp((t - 59.0) / 4.0, 0, 1)
fast_lead_exit = 1 - clamp((t - 60.0) / 3.0, 0, 1)
space_exit = 1 - clamp((t - 61.0) / 2.5, 0, 1)

# Slow equal-power pan makes the mono voice and stereo effect easy to inspect.
pan_position = 0.58 * sin(2 * pi() * 0.09 * t)
left_gain = sqrt(0.5 * (1 - pan_position))
right_gain = sqrt(0.5 * (1 + pan_position))
main_lead_level = 0.64
synth_left = main_lead_level * left_gain * voice
synth_right = main_lead_level * right_gain * voice
echo = eighth_note_delay(source_left=0.34 * synth_left, source_right=0.34 * synth_right,
                         sample_rate=$sample_rate,
                         feedback=0.40 - 0.12 * clarity,
                         tone=1700 + 3600 * clarity)
lead_room = reverb(source_left=0.24 * synth_left,
                   source_right=0.24 * synth_right,
                   sample_rate=$sample_rate,
                   feedback=0.74, damping=3000)

fade_in = clamp(t / 0.04, 0, 1)
remaining = max(0, sequence.duration - 1 / $sample_rate - t)
fade_out = clamp(remaining / 0.45, 0, 1)
master = $master_gain * fade_in * fade_out
left = 0.92 * tanh(master * (main_lead_exit *
    (0.56 * synth_left + 0.78 * echo.left + 0.54 * lead_room.left) +
    pad_exit * (1.55 * pad_chorus.left + 1.10 * pad_room.left) +
    bass_exit * bass_presence * (0.90 * bass_voice + 0.54 * melodic_bass_voice) +
    arp_exit * pluck_presence * pluck_stereo.left +
    arp_exit * background_arp_presence *
    (0.16 * background_arp_stereo.left + 0.62 * background_arp_room.left) + fast_presence *
    fast_lead_exit * (0.96 * fast_stereo.left + 0.36 * fast_echo.left) +
    response_exit * response_presence * response_chorus.left +
    counter_exit * counter_presence *
    (0.30 * counter_position.left + 0.72 * counter_room.left) +
    trombone_exit * trombone_presence * (0.055 * trombone_dry_left +
    1.32 * trombone_room.left) + timpani_exit * timpani_presence *
    (0.52 * timpani_voice + 0.68 * timpani_room.left) +
    drum_exit * drum_presence *
    (0.72 * drum_center_tone + drum_hats.left) +
    space_exit * (atmosphere_level * atmosphere_room.left +
    0.46 * ensemble_chamber.left + 0.34 * rear_delay.left)) / 0.92)
right = 0.92 * tanh(master * (main_lead_exit *
    (0.56 * synth_right + 0.78 * echo.right + 0.54 * lead_room.right) +
    pad_exit * (1.55 * pad_chorus.right + 1.10 * pad_room.right) +
    bass_exit * bass_presence * (0.90 * bass_voice + 0.54 * melodic_bass_voice) +
    arp_exit * pluck_presence * pluck_stereo.right +
    arp_exit * background_arp_presence *
    (0.16 * background_arp_stereo.right + 0.62 * background_arp_room.right) + fast_presence *
    fast_lead_exit * (0.96 * fast_stereo.right + 0.36 * fast_echo.right) +
    response_exit * response_presence * response_chorus.right +
    counter_exit * counter_presence *
    (0.30 * counter_position.right + 0.72 * counter_room.right) +
    trombone_exit * trombone_presence * (0.055 * trombone_dry_right +
    1.32 * trombone_room.right) + timpani_exit * timpani_presence *
    (0.52 * timpani_voice + 0.68 * timpani_room.right) +
    drum_exit * drum_presence *
    (0.72 * drum_center_tone + drum_hats.right) +
    space_exit * (atmosphere_level * atmosphere_room.right +
    0.46 * ensemble_chamber.right + 0.34 * rear_delay.right)) / 0.92)
duration = sequence.duration

out {
    left, right, duration
}

