// Shape-preserving stereo resonant filter with one authored model instance.
model resonance(source_arg = "source", lifecycle = "scoped")

in source { left, right }

$sample_rate = 44100
$cutoff = 1800
$resonance = 0.25
$smoothing_seconds = 0.004

state left_integrator_one = 0
state left_integrator_two = 0
state right_integrator_one = 0
state right_integrator_two = 0
state smoothed_cutoff = 1800
state smoothed_resonance = 0.25

smooth = 1 - exp(-1 / (max(0.0001, $smoothing_seconds) * $sample_rate))
cutoff = smoothed_cutoff +
    smooth * (clamp($cutoff, 20, $sample_rate * 0.45) - smoothed_cutoff)
resonance_amount = smoothed_resonance +
    smooth * (clamp($resonance, 0, 0.96) - smoothed_resonance)
g = tan(pi() * cutoff / $sample_rate)
damping = 2 - 1.9 * resonance_amount
normalizer = 1 / (1 + g * (g + damping))

left_band = normalizer *
    (left_integrator_one + g * (source.left - left_integrator_two))
left_low = left_integrator_two + g * left_band
left_high = source.left - damping * left_band - left_low

right_band = normalizer *
    (right_integrator_one + g * (source.right - right_integrator_two))
right_low = right_integrator_two + g * right_band
right_high = source.right - damping * right_band - right_low

left_integrator_one := 2 * left_band - left_integrator_one
left_integrator_two := 2 * left_low - left_integrator_two
right_integrator_one := 2 * right_band - right_integrator_one
right_integrator_two := 2 * right_low - right_integrator_two
smoothed_cutoff := cutoff
smoothed_resonance := resonance_amount

out {
    low = { left = left_low, right = right_low },
    band = { left = left_band, right = right_band },
    high = { left = left_high, right = right_high }
}
