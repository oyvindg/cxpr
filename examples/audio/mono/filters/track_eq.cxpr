# Up to four cascaded 6 dB/oct high-pass poles followed by an RBJ bell filter.
model track_eq(lifecycle = "scoped")

in source
$sample_rate = 44100
$high_pass_hz = 30
$high_pass_stages = 2
$bell_hz = 1000
$bell_gain_db = 0
$bell_q = 1

state previous_input_one = 0
state previous_input_two = 0
state previous_input_three = 0
state previous_input_four = 0
state previous_high_one = 0
state previous_high_two = 0
state previous_high_three = 0
state previous_high_four = 0
state bell_input_one = 0
state bell_input_two = 0
state bell_output_one = 0
state bell_output_two = 0

# Each enabled first-order stage contributes 6 dB/octave. Selecting two, three,
# or four stages therefore implements the requested 12/18/24 dB slopes.
cutoff = clamp($high_pass_hz, 10, $sample_rate * 0.40)
high_coefficient = exp(-2 * pi() * cutoff / $sample_rate)
high_one = high_coefficient * (previous_high_one + source - previous_input_one)
stage_one = $high_pass_stages >= 1 ? high_one : source
high_two = high_coefficient * (previous_high_two + stage_one - previous_input_two)
stage_two = $high_pass_stages >= 2 ? high_two : stage_one
high_three = high_coefficient * (previous_high_three + stage_two - previous_input_three)
stage_three = $high_pass_stages >= 3 ? high_three : stage_two
high_four = high_coefficient * (previous_high_four + stage_three - previous_input_four)
filtered = $high_pass_stages >= 4 ? high_four : stage_three

previous_input_one := source
previous_input_two := stage_one
previous_input_three := stage_two
previous_input_four := stage_three
previous_high_one := high_one
previous_high_two := high_two
previous_high_three := high_three
previous_high_four := high_four

# RBJ peaking-EQ coefficients preserve independent frequency, gain, and Q
# controls after the high-pass cascade.
frequency = clamp($bell_hz, 20, $sample_rate * 0.45)
amplitude = pow(10, $bell_gain_db / 40)
omega = 2 * pi() * frequency / $sample_rate
alpha = sin(omega) / (2 * max(0.05, $bell_q))
a_zero = 1 + alpha / amplitude
b_zero = (1 + alpha * amplitude) / a_zero
b_one = (-2 * cos(omega)) / a_zero
b_two = (1 - alpha * amplitude) / a_zero
a_one = (-2 * cos(omega)) / a_zero
a_two = (1 - alpha / amplitude) / a_zero
bell = b_zero * filtered + b_one * bell_input_one + b_two * bell_input_two -
    a_one * bell_output_one - a_two * bell_output_two
bell_input_two := bell_input_one
bell_input_one := filtered
bell_output_two := bell_output_one
bell_output_one := bell

out sample = bell
