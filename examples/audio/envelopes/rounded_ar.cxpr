# Sample-continuous rounded attack/release envelope for acoustic voices.
model rounded_ar(lifecycle = "scoped")

in age, trigger
$sample_rate = 44100
$attack = 0.10
$hold = 0.40
$release = 0.18

note_age = max(0, age)
state level = 0
target = note_age < $hold ? 1 : 0
seconds = target > level ? $attack : $release
# Reach about 99% of the target within the configured curve time while
# preserving the current level across retriggers.
coefficient = 1 - exp(-4.6 / (max(0.001, seconds) * $sample_rate))
next_level = level + coefficient * (target - level)
level := next_level

out value = clamp(next_level, 0, 1)
