# Shared exponential ADSR with sample-continuous retrigger and release.
model adsr(lifecycle = "scoped")

in gate, trigger

$sample_rate = 44100
$attack = 0.01
$decay = 0.12
$sustain = 0.65
$release = 0.30

state level = 0
state attacking = 0

is_attacking = trigger > 0 ? 1 : (attacking > 0 and level < 0.999 ? 1 : 0)
target = gate <= 0 ? 0 : (is_attacking > 0 ? 1 : clamp($sustain, 0, 1))
seconds = gate <= 0 ? $release : (is_attacking > 0 ? $attack : $decay)
coefficient = 1 - exp(-1 / (max(0.0001, seconds) * $sample_rate))
next_level = level + coefficient * (target - level)

level := abs(target - next_level) < 0.000001 ? target : next_level
attacking := is_attacking

out value = clamp(next_level, 0, 1)

