// Rooted-record stereo delay with independent channel state in one stage.
model delay(pipe = "stereo", lifecycle = "scoped")

in stereo { left, right }

$sample_rate = 44100
$time = 0.25
$feedback = 0.30
$mix = 0.35

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Pipeline delay supports sample rates from 8000 through 44100 Hz"
}
assert $time >= 1 / $sample_rate and $time <= 1 {
    description = "Pipeline delay time must fit its one-second bounded buffer"
}

state left_line: buffer<number, samples = 44100>
state right_line: buffer<number, samples = 44100>

index_125 = max(0, floor(0.125 * $sample_rate) - 1)
index_250 = max(0, floor(0.250 * $sample_rate) - 1)
index_500 = max(0, floor(0.500 * $sample_rate) - 1)
index_1000 = max(0, floor(1.000 * $sample_rate) - 1)
left_tap = $time < 0.1875 ? left_line[index_125] :
           $time < 0.3750 ? left_line[index_250] :
           $time < 0.7500 ? left_line[index_500] : left_line[index_1000]
right_tap = $time < 0.1875 ? right_line[index_125] :
            $time < 0.3750 ? right_line[index_250] :
            $time < 0.7500 ? right_line[index_500] : right_line[index_1000]
left_wet = isnan(left_tap) ? 0 : left_tap
right_wet = isnan(right_tap) ? 0 : right_tap
feedback = clamp($feedback, 0, 0.95)
mix = clamp($mix, 0, 1)

left_line := stereo.left + feedback * left_wet
right_line := stereo.right + feedback * right_wet

out {
    left = (1 - mix) * stereo.left + mix * left_wet,
    right = (1 - mix) * stereo.right + mix * right_wet
}
