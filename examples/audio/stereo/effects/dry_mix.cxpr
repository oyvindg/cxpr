// Add four named stereo buses to a piped stereo foundation.
model dry_mix(pipe = "stereo")

in stereo
in percussion
in riff
in stabs
in room

out {
    left = stereo.left + percussion.left + riff.left + stabs.left + room.left,
    right = stereo.right + percussion.right + riff.right + stabs.right + room.right
}
