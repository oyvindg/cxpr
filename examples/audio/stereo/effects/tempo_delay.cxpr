# Stereo cross-feedback delay with a caller-supplied tempo-derived delay time.
model tempo_delay(pipe = "stereo", lifecycle = "scoped")

in stereo { left as source_left, right as source_right }
$sample_rate = 44100
$delay_seconds = 0.409090909
$feedback = 0.34
$cutoff = 4200

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Tempo delay buffers support sample rates from 8000 through 44100 Hz"
}
assert $delay_seconds > 0 and $delay_seconds <= 0.75 {
    description = "Tempo delay supports delay times through 750 ms"
}

state left_memory: buffer<number, samples = 33075>
state right_memory: buffer<number, samples = 33075>
state left_tone = 0
state right_tone = 0

# The caller derives delay_seconds from BPM, so this module remains reusable
# for dotted, straight, or triplet subdivisions without owning a tempo clock.
delay_index = max(0, floor($delay_seconds * $sample_rate) - 1)
left_raw = left_memory[delay_index]
right_raw = right_memory[delay_index]
left_delayed = isnan(left_raw) ? 0 : left_raw
right_delayed = isnan(right_raw) ? 0 : right_raw
coefficient = 1 - exp(-2 * pi() * clamp($cutoff, 100, $sample_rate * 0.45) / $sample_rate)
left_filtered = left_tone + coefficient * (left_delayed - left_tone)
right_filtered = right_tone + coefficient * (right_delayed - right_tone)
left_tone := left_filtered
right_tone := right_filtered
# Cross-feedback sends each repeat to the opposite channel. The one-pole tone
# filters progressively darken repeats before they re-enter the delay lines.
left_memory := source_left + clamp($feedback, 0, 0.85) * right_filtered
right_memory := source_right + clamp($feedback, 0, 0.85) * left_filtered

out {
    left = left_filtered,
    right = right_filtered
}
