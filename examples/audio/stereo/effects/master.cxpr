# Rooted-record final processing: DC filter, saturation, and fades.
model master(pipe = "stereo", lifecycle = "scoped")

in stereo { left, right }
in t

$sample_rate = 44100
$gain = 1
$duration = 40
$fade_seconds = 1.4
$ceiling = 0.90
$fade_in_seconds = 0.18

state previous_left = 0
state previous_right = 0
state filtered_left_memory = 0
state filtered_right_memory = 0

coefficient = exp(-2 * pi() * 18 / $sample_rate)
filtered_left = stereo.left - previous_left + coefficient * filtered_left_memory
filtered_right = stereo.right - previous_right + coefficient * filtered_right_memory
previous_left := stereo.left
previous_right := stereo.right
filtered_left_memory := filtered_left
filtered_right_memory := filtered_right

ceiling = clamp($ceiling, 0.1, 0.99)
remaining = max(0, $duration - 1 / $sample_rate - t)
fade_position = clamp(remaining / max(0.001, $fade_seconds), 0, 1)
fade_in_position = clamp(t / max(0.001, $fade_in_seconds), 0, 1)
fade_in = pow(sin(pi() * fade_in_position / 2), 2)
fade = pow(sin(pi() * fade_position / 2), 2) * fade_in

out {
    left = fade * ceiling * tanh($gain * filtered_left / ceiling),
    right = fade * ceiling * tanh($gain * filtered_right / ceiling)
}
