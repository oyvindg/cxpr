// Cross-feedback stereo delay for rhythmic left/right echoes.
model ping_pong_delay(pipe = "stereo", lifecycle = "scoped")

in stereo { left, right }
$sample_rate = 44100
$time = 0.25
$feedback = 0.38
$mix = 0.25

assert $sample_rate >= 8000 and $sample_rate <= 44100 {
    description = "Ping-pong delay supports sample rates from 8000 through 44100 Hz"
}
assert $time >= 1 / $sample_rate and $time <= 0.5 {
    description = "Ping-pong delay time must fit its bounded buffer"
}

state left_line: buffer<number, samples = 22050>
state right_line: buffer<number, samples = 22050>

index_125 = max(0, floor(0.125 * $sample_rate) - 1)
index_250 = max(0, floor(0.250 * $sample_rate) - 1)
index_500 = max(0, floor(0.500 * $sample_rate) - 1)
left_tap = $time < 0.1875 ? left_line[index_125] :
           $time < 0.375 ? left_line[index_250] : left_line[index_500]
right_tap = $time < 0.1875 ? right_line[index_125] :
            $time < 0.375 ? right_line[index_250] : right_line[index_500]
left_wet = isnan(left_tap) ? 0 : left_tap
right_wet = isnan(right_tap) ? 0 : right_tap
feedback = clamp($feedback, 0, 0.88)
mix = clamp($mix, 0, 1)
left_line := stereo.left + feedback * right_wet
right_line := stereo.right + feedback * left_wet

out {
    left = (1 - mix) * stereo.left + mix * left_wet,
    right = (1 - mix) * stereo.right + mix * right_wet
}
