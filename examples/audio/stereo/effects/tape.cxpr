// Mild tape-style coloration with head bump, HF loss, wow and soft hysteresis.
model tape(pipe = "stereo", lifecycle = "scoped")

in stereo { left as source_left, right as source_right }
$sample_rate = 44100
$drive = 1.18
$mix = 0.72

// Filter, hysteresis memory and wow phase are linked but audio stays stereo.
state { low_left = 0, low_right = 0, previous_left = 0, previous_right = 0,
        wow_phase = 0 }
// Subtle gain modulation approximates slow transport instability.
wow = 1 + 0.0022 * sin(2 * pi() * wow_phase)

// The one-pole stage rolls off ultrasonic content before nonlinear saturation.
coefficient = 1 - exp(-2 * pi() * 11500 / $sample_rate)
next_low_left = low_left + coefficient * (source_left - low_left)
next_low_right = low_right + coefficient * (source_right - low_right)
// Blend a little previous output into the magnetization path for soft memory.
hysteresis_left = 0.86 * next_low_left + 0.14 * previous_left
hysteresis_right = 0.86 * next_low_right + 0.14 * previous_right
colored_left = tanh($drive * wow * hysteresis_left) / tanh($drive)
colored_right = tanh($drive * wow * hysteresis_right) / tanh($drive)
wet = clamp($mix, 0, 1)

// Store the colored signal, not the dry input, so hysteresis spans samples.
low_left := next_low_left
low_right := next_low_right
previous_left := colored_left
previous_right := colored_right
wow_phase := (wow_phase + 0.43 / $sample_rate) % 1
// Parallel dry/wet mixing keeps transient definition at moderate settings.
left = (1 - wet) * source_left + wet * colored_left
right = (1 - wet) * source_right + wet * colored_right

out {
    left, right
}
