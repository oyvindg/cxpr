model ir_large_math
in { a, b, c, d, e, f, g, h, i, j, x, y, z, m, n }
out result =
    sqrt(a * a + b * b + c * c) +
    sqrt(d * d + e * e + f * f) +
    sqrt(g * g + h * h + i * i) +
    sqrt(j * j + x * x + y * y) +
    sqrt(z * z + m * m + n * n) +
    sqrt(abs(a * n - b * m) + 1) +
    sqrt(abs(c * z - d * y) + 1) +
    sqrt(abs(e * x - f * j) + 1) +
    sqrt(abs(g * i - h * h) + 1) +
    abs((a + c + e + g + i) / (1 + abs(n)))
